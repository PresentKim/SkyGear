Autosave/disk: netstore.flush conduit.shares | dirty=false cell=150 stored=1 disk=7
Autosave/empty: netstore.flush conduit.shares | dirty=false stored=1
Autosave/onePlayer: netstore.flush conduit.shares | dirty=false cell=150 stored=1 disk=7
Autosave/twoPlayers: netstore.flush conduit.shares | dirty=false cell=150 stored=1 disk=7
Close/disk: storage.displays island.lost conduit.close island.lost netstore.flush | stored=1 registered=false game=false visuals=0 displays=0 cell=150 disk=7
Close/empty: storage.displays conduit.close netstore.flush | stored=1 registered=false game=false visuals=0 displays=0
Close/onePlayer: storage.displays island.lost conduit.close island.lost netstore.flush | stored=1 registered=false game=false visuals=0 displays=0 cell=150 disk=7
Close/twoPlayers: storage.displays island.lost conduit.close island.lost netstore.flush | stored=1 registered=false game=false visuals=0 displays=0 cell=150 disk=7
ColumnLoad/bundle: conduit.load | inGrid=true
ColumnLoad/empty: conduit.load | inGrid=true
ColumnUnload/bundle: conduit.unload island.lost | inGrid=false
ColumnUnload/empty: conduit.unload | inGrid=true
EntityDespawn/pickedUp: island.lost | lostItems=0
EntityDespawn/player: island.lost | lostItems=0
EntityDespawn/void: island.lost | lostItems=5
Fast/01: network.step dimension.watchdog look.updateAll | fastCount=1
Fast/02: network.step network.fluids dimension.watchdog look.updateAll | fastCount=2
Fast/03: network.step dimension.watchdog look.updateAll | fastCount=3
Fast/04: network.step network.fluids dimension.watchdog look.updateAll | fastCount=4
Fast/05: network.step network.items dimension.watchdog look.updateAll | fastCount=5
Fast/06: network.step network.fluids dimension.watchdog look.updateAll | fastCount=6
Fast/07: network.step dimension.watchdog look.updateAll | fastCount=7
Fast/08: network.step network.fluids dimension.watchdog look.updateAll | fastCount=8
Fast/09: network.step dimension.watchdog look.updateAll | fastCount=9
Fast/10: network.step network.items network.fluids dimension.watchdog look.updateAll | fastCount=10
Fast/11: network.step dimension.watchdog look.updateAll | fastCount=11
Fast/noPlayers: network.step dimension.watchdog look.updateAll | fastCount=1
Fast/twoPlayers: network.step dimension.watchdog look.updateAll | fastCount=1 players=2
Fast/watchdog: network.step dimension.watchdog look.updateAll | inArena=false
Join/again: screens.menuItem fairy.backfillDust climate.showWeather core.shapes island.purgeLost progress.sendRecipes screens.board dimension.joined | slot8=none players=1
Join/first: screens.menuItem fairy.backfillDust climate.showWeather core.shapes island.purgeLost progress.sendRecipes screens.board dimension.joined | slot8=minecraft:nether_star players=1
Join/purge: screens.menuItem fairy.backfillDust climate.showWeather core.shapes island.purgeLost progress.sendRecipes screens.board dimension.joined | lost=1
Join/spectator: screens.menuItem fairy.backfillDust climate.showWeather core.shapes island.purgeLost progress.sendRecipes screens.board dimension.joined | mode=world.survival
Join/withOther: screens.menuItem fairy.backfillDust climate.showWeather core.shapes island.purgeLost progress.sendRecipes screens.board dimension.joined | slot8=none players=2
Leave/expanding: dimension.leave core.parts expand.stop look.clear core.shapes screens.board progress.recipes | expanding=false mode=expand.ViewOnlyMode
Leave/hunting: dimension.leave island.lost core.parts expand.stop look.clear core.shapes screens.board progress.recipes | hunting=false run=false inArena=false
Leave/plain: dimension.leave core.parts expand.stop look.clear core.shapes screens.board progress.recipes | diedFood=0 players=1
Leave/withOther: dimension.leave core.parts expand.stop look.clear core.shapes screens.board progress.recipes | diedFood=1 players=2
NewDay/noPlayers: island.purgeLost game.newDay | lost=1 players=0
NewDay/onePlayer: island.purgeLost game.newDay | lost=1 players=1
NewDay/twoPlayers: island.purgeLost game.newDay | lost=0 players=2
Second/01: farm.growCrops progress.checkHeld farm.barrels fairy.tick climate.tick dimension.second tinker.effects machine.monitor farm.plants screens.boards achievement.playSeconds progress.collection | dirty=true>dirty=false
Second/02: farm.growCrops progress.checkHeld farm.barrels fairy.tick climate.tick dimension.second tinker.effects machine.monitor farm.plants screens.boards achievement.playSeconds progress.collection | dirty=true>dirty=true
Second/03: farm.growCrops progress.checkHeld farm.barrels fairy.tick climate.tick dimension.second tinker.effects machine.monitor farm.plants screens.boards achievement.playSeconds progress.collection | dirty=true>dirty=false
Second/04: farm.growCrops progress.checkHeld farm.barrels fairy.tick climate.tick dimension.second tinker.effects machine.monitor farm.plants screens.boards achievement.playSeconds progress.collection | dirty=false>dirty=false
Second/advancement: farm.growCrops progress.checkHeld farm.barrels fairy.tick climate.tick dimension.second tinker.effects machine.monitor farm.plants screens.boards achievement.playSeconds progress.collection | advanced=true dirty=false stored=true
Second/noPlayers: farm.growCrops progress.checkHeld farm.barrels fairy.tick climate.tick dimension.second tinker.effects machine.monitor farm.plants screens.boards achievement.playSeconds progress.collection | players=0
Second/twoPlayers: farm.growCrops progress.checkHeld farm.barrels fairy.tick climate.tick dimension.second tinker.effects machine.monitor farm.plants screens.boards achievement.playSeconds progress.collection | players=2
Start: farm.loadCrops island.keepLoaded climate.apply | 
