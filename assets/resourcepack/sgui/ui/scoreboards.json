{
  "namespace": "scoreboard",
  "scoreboard_sidebar": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "anchor_from": "center",
    "anchor_to": "center",
    "controls": [
      {
        "sg_plain@scoreboard.sg_plain_sidebar": {
          "bindings": [
            {
              "binding_name": "#objective_sidebar_name",
              "binding_type": "global"
            },
            {
              "binding_type": "view",
              "source_property_name": "((#objective_sidebar_name - '§d§h§u§d') = #objective_sidebar_name)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "sg_hud@scoreboard.sg_hud": {
          "bindings": [
            {
              "binding_name": "#objective_sidebar_name",
              "binding_type": "global"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#objective_sidebar_name - '§d§h§u§d') = #objective_sidebar_name))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },
  "sg_hud": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "controls": [
      {
        "top_left@scoreboard.sg_row_stack": {
          "ignored": "$touch",
          "$sg_row_text": "(#player_name_sidebar - '§d§1')",
          "offset": [
            4,
            4
          ]
        }
      },
      {
        // A touch screen shows the chat at the top left and its jump and sneak buttons at the right
        // middle, so there the top left rows go to the top right, over the top right rows, and the
        // quest panel under them.
        "top_right": {
          "type": "stack_panel",
          "orientation": "vertical",
          "size": [
            "100%cm",
            "100%c"
          ],
          "anchor_from": "top_right",
          "anchor_to": "top_right",
          "use_child_anchors": true,
          "offset": [
            -4,
            4
          ],
          "controls": [
            {
              "top_left_touch@scoreboard.sg_row_stack": {
                "ignored": "(not $touch)",
                "$sg_row_text": "(#player_name_sidebar - '§d§1')",
                "$sg_row_anchor": "top_right",
                "$sg_row_alignment": "right"
              }
            },
            {
              "top_right@scoreboard.sg_row_stack": {
                "$sg_row_text": "(#player_name_sidebar - '§d§2')",
                "$sg_row_anchor": "top_right",
                "$sg_row_alignment": "right"
              }
            },
            {
              "quest_gap": {
                "type": "panel",
                "ignored": "(not $touch)",
                "size": [
                  0,
                  4
                ]
              }
            },
            {
              "quest_touch@scoreboard.sg_quest": {
                "ignored": "(not $touch)",
                "anchor_from": "top_right",
                "anchor_to": "top_right"
              }
            }
          ]
        }
      },
      {
        "quest@scoreboard.sg_quest": {
          "ignored": "$touch",
          "offset": [
            -4,
            -10
          ]
        }
      }
    ]
  },
  // One part of the HUD: a stack of the sidebar rows whose name starts with the part's marker. A
  // stack is built only while the objective name has the HUD marker. $sg_row_text is the whole
  // expression that drops the marker (a variable in part of an expression is not replaced), and the
  // rows see the stack's variables.
  "sg_row_stack": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [
      "100%cm",
      "100%c"
    ],
    "$sg_row_anchor|default": "top_left",
    "anchor_from": "$sg_row_anchor",
    "anchor_to": "$sg_row_anchor",
    "use_child_anchors": true,
    "collection_name": "scoreboard_players",
    "factory": {
      "name": "player_list_factory",
      "control_name": "scoreboard.sg_row"
    },
    "bindings": [
      {
        "binding_name": "#objective_sidebar_name",
        "binding_type": "global"
      },
      {
        "binding_name": "#scoreboard_sidebar_size",
        "binding_type": "global"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#objective_sidebar_name - '§d§h§u§d')",
        "target_property_name": "#sg_objective_rest"
      },
      {
        "binding_type": "view",
        "source_property_name": "((not (#sg_objective_rest = #objective_sidebar_name)) * #scoreboard_sidebar_size)",
        "target_property_name": "#collection_length"
      }
    ]
  },
  "sg_row": {
    "type": "label",
    "layer": 2,
    "localize": false,
    "locked_alpha": 1.0,
    "$sg_row_anchor|default": "top_left",
    "$sg_row_alignment|default": "left",
    "$sg_row_max_size|default": [
      260,
      10
    ],
    "size": [
      "default",
      10
    ],
    "max_size": "$sg_row_max_size",
    "text": "#text",
    "text_alignment": "$sg_row_alignment",
    "shadow": true,
    "bindings": [
      {
        "binding_name": "#player_name_sidebar",
        "binding_type": "collection",
        "binding_collection_name": "scoreboard_players"
      },
      {
        "binding_type": "view",
        "source_property_name": "$sg_row_text",
        "target_property_name": "#text"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not (#text = #player_name_sidebar))",
        "target_property_name": "#visible"
      }
    ],
    "anchor_from": "$sg_row_anchor",
    "anchor_to": "$sg_row_anchor"
  },
  "sg_quest": {
    "type": "image",
    "texture": "textures/ui/Black",
    "alpha": 0.45,
    "anchor_from": "right_middle",
    "anchor_to": "right_middle",
    "size": [
      "100%c + 10px",
      "100%c + 8px"
    ],
    "controls": [
      {
        "rows": {
          "type": "stack_panel",
          "orientation": "vertical",
          "size": [
            "100%cm",
            "100%c"
          ],
          "anchor_from": "center",
          "anchor_to": "center",
          "controls": [
            {
              "title@scoreboard.sg_row_stack": {
                "$sg_row_text": "(#player_name_sidebar - '§d§3')"
              }
            },
            {
              "gap": {
                "type": "panel",
                "size": [
                  0,
                  3
                ]
              }
            },
            {
              "lines@scoreboard.sg_row_stack": {
                "$sg_row_text": "(#player_name_sidebar - '§d§4')",
                "$sg_row_max_size": [
                  180,
                  10
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "sg_plain_sidebar": {
    "type": "image",
    "texture": "textures/ui/Black",
    "alpha": 0.4,
    "anchor_from": "right_middle",
    "anchor_to": "right_middle",
    "size": [
      "100%c + 8px",
      "100%c + 6px"
    ],
    "controls": [
      {
        "rows": {
          "type": "stack_panel",
          "orientation": "vertical",
          "size": [
            "100%cm",
            "100%c"
          ],
          "anchor_from": "center",
          "anchor_to": "center",
          "controls": [
            {
              "objective": {
                "type": "label",
                "layer": 2,
                "localize": false,
                "size": [
                  "default",
                  10
                ],
                "text": "#objective_sidebar_name",
                "bindings": [
                  {
                    "binding_name": "#objective_sidebar_name",
                    "binding_type": "global"
                  }
                ]
              }
            },
            {
              "players": {
                "type": "stack_panel",
                "orientation": "vertical",
                "size": [
                  "100%cm",
                  "100%c"
                ],
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "use_child_anchors": true,
                "collection_name": "scoreboard_players",
                "factory": {
                  "name": "player_list_factory",
                  "control_name": "scoreboard.sg_row_plain"
                },
                "bindings": [
                  {
                    "binding_name": "#objective_sidebar_name",
                    "binding_type": "global"
                  },
                  {
                    "binding_name": "#scoreboard_sidebar_size",
                    "binding_type": "global"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(#objective_sidebar_name - '§d§h§u§d')",
                    "target_property_name": "#sg_objective_rest"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "((#sg_objective_rest = #objective_sidebar_name) * #scoreboard_sidebar_size)",
                    "target_property_name": "#collection_length"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "sg_row_plain": {
    "type": "label",
    "layer": 2,
    "localize": false,
    "size": [
      "default",
      10
    ],
    "text": "#player_name_sidebar",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "bindings": [
      {
        "binding_name": "#player_name_sidebar",
        "binding_type": "collection",
        "binding_collection_name": "scoreboard_players"
      }
    ]
  }
}
