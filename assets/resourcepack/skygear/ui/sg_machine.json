  // The machine's slots fill the rows its layout uses, so the window is as
  // tall as a vanilla chest of that many rows (1 row 130, 2 rows 148, 3 rows
  // 166): the shared inventory below keeps its vanilla place.
  "top_half": {
    "type": "panel",
    "size": "$sg_machine_top_size",
    "offset": [
      0,
      12
    ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {
        "title@sg_machine.title": {}
      },
      {
        "slots@$sg_machine_slots": {
          "offset": [
            7,
            9
          ]
        }
      }
    ]
  },
  // The window title as on the vanilla furnace (furnace_label): centred at
  // the top of the window, 4px down (top_half sits 12px down).
  "title": {
    "type": "label",
    "layer": 2,
    "offset": [ 0, -8 ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "text": "$container_title",
    "color": "$title_text_color",
    "localize": "$localize_title",
    "enable_profanity_filter": true
  },
  // The dark rounded bar above the window's top right corner holds the info
  // icon left of the close button, like the control bar of the DDUI windows.
  // The icon is window slot 26 of the machine (infoSlot in machine.go) drawn
  // here instead of in a slot layout, so every machine window has it in the
  // same place.
  "control_bar": {
    "type": "image",
    "texture": "textures/ui/toolbar_background",
    "size": [ "100%c + 18px", 25 ],
    "offset": [ 0, -22 ],
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "layer": 3,
    "controls": [
      {
        "row": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "size": [ "100%c", 22 ],
          "anchor_from": "center",
          "anchor_to": "center",
          "controls": [
            {
              "bar_slots": {
                "type": "stack_panel",
                "orientation": "horizontal",
                "collection_name": "container_items",
                "size": [ "100%c", 18 ],
                "anchor_from": "center",
                "anchor_to": "center",
                "controls": [
                  { "s26@sg_machine.bar_button": { "collection_index": 26 } }
                ]
              }
            },
            {
              "close_slot": {
                "type": "panel",
                "size": [ 22, 22 ],
                "controls": [
                  {
                    "close@common.light_close_button": {
                      "$close_button_offset": [ 0, 0 ],
                      "anchor_from": "center",
                      "anchor_to": "center"
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },
  // A window button slot of the control bar. A machine with no output or no
  // input leaves the take or put slot empty (machine.go); the empty slot is
  // hidden so the stack folds it and the buttons stay next to the info icon.
  "bar_button": {
    "type": "panel",
    "size": [ 18, 18 ],
    "bindings": [
      {
        "binding_name": "#hover_text",
        "binding_type": "collection",
        "binding_collection_name": "container_items"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not (#hover_text = ''))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      { "slot@sg_machine.indicator": { "size": [ 18, 18 ] } }
    ]
  },
  "machine_panel": {
    "type": "panel",
    "$sg_machine_outputs|default": "(#collection_index = 13) or (#collection_index = 14) or (#collection_index = 15) or (#collection_index = 16)",
    "$sg_machine_root_size|default": [ 176, 130 ],
    "$sg_machine_top_size|default": [ "100%", 42 ],
    "controls": [
      {
        "container_gamepad_helpers@common.container_gamepad_helpers": {}
      },
      {
        "selected_item_details_factory@common.selected_item_details_factory": {}
      },
      {
        "item_lock_notification_factory@common.item_lock_notification_factory": {}
      },
      {
        "root_panel@common.root_panel": {
          "layer": 1,
          "size": "$sg_machine_root_size",
          "controls": [
            {
              "common_panel@common.common_panel": {
                "$dialog_background": "sg_machine.dark_bg",
                // The bar above the window has its own close button.
                "$show_close_button": false
              }
            },
            {
              "chest_panel": {
                "type": "panel",
                "layer": 5,
                "controls": [
                  {
                    "top_half@sg_machine.top_half": {}
                  },
                  {
                    "inventory_panel_bottom_half_with_label@common.inventory_panel_bottom_half_with_label": {}
                  },
                  {
                    "hotbar_grid@common.hotbar_grid_template": {}
                  },
                  {
                    "inventory_take_progress_icon_button@common.inventory_take_progress_icon_button": {}
                  },
                  {
                    "flying_item_renderer@common.flying_item_renderer": {
                      "layer": 15
                    }
                  }
                ]
              }
            },
            { "chrome@sg_machine.control_bar": {} },
            // The take all and put all bar of the inventoryui pack: take all moves
            // only the output slots ($sg_machine_outputs, by layout), put all also
            // the hotbar; the server puts what lands outside the inputs into them.
            {
              "quick_side_bar@sg_quick.side_bar": {
                "$quick_take_filter": "$sg_machine_outputs",
                "$quick_put_hotbar": true
              }
            },
            {
              "inventory_selected_icon_button@common.inventory_selected_icon_button": {}
            },
            {
              "gamepad_cursor@common.gamepad_cursor_button": {}
            }
          ]
        }
      }
    ]
  },
  "crusher_panel@sg_machine.machine_panel": {
    "$sg_machine_slots": "sg_machine.crusher_slots",
    "$sg_machine_outputs": "(#collection_index = 15)"
  },
  "sieve_panel@sg_machine.machine_panel": {
    "$sg_machine_slots": "sg_machine.sieve_slots"
  },
  "magicsieve_panel@sg_machine.machine_panel": {
