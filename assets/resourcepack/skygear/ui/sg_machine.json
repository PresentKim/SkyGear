  // The storage network terminal (content/skygear/netstore/terminalui.go):
  // six rows of slots, the network's items in the first five and the
  // buttons in the last. An item's name starts with its count text
  // (common/invui CountMark): a run of format codes the tooltip hides, cut
  // off here by its length in bytes and drawn at the slot's bottom right, as
  // a count over 64 does not fit the stack. Taking out the format signs from
  // a text that reads as a number gives an empty text, so the reset code's
  // letter stays in front and the clip box cuts it off with the blanks.
  "terminal_panel@sg_machine.machine_panel": {
    "$sg_machine_slots": "sg_machine.terminal_slots",
    "$sg_machine_outputs": "(#collection_index = -1)",
    "$sg_machine_root_size": [ 176, 205 ],
    "$sg_machine_top_size": [ "100%", 117 ],
    "$sg_machine_bar": "sg_machine.close_bar"
  },
  "terminal_slots": {
    "type": "grid",
    "size": [ 162, 108 ],
    "grid_dimensions": [ 9, 6 ],
    "grid_item_template": "sg_machine.net_slot",
    "collection_name": "container_items",
    "anchor_from": "top_left",
    "anchor_to": "top_left"
  },
  "net_slot": {
    "type": "panel",
    "size": [ 18, 18 ],
    "controls": [
      { "slot@sg_machine.slot": {} },
      // An empty slot of the list takes an item into the network.
      {
        "drop": {
          "type": "image",
          "texture": "textures/ui/ThinPlus",
          "size": [ 8, 8 ],
          "alpha": 0.35,
          "layer": 3,
          "bindings": [
            { "binding_type": "collection", "binding_collection_name": "container_items", "binding_name": "#hover_text", "binding_condition": "always" },
            { "binding_type": "collection_details", "binding_collection_name": "container_items" },
            { "binding_type": "view", "binding_condition": "always", "source_property_name": "((#hover_text = '') and (#collection_index < 45))", "target_property_name": "#visible" }
          ]
        }
      },
      { "count@sg_machine.net_count": {} },
      { "count_long@sg_machine.net_count_long": {} }
    ]
  },
  "net_count": {
    "type": "panel",
    "size": [ 20, 10 ],
    "layer": 20,
    "clips_children": true,
    "anchor_from": "bottom_right",
    "anchor_to": "bottom_right",
    "offset": [ 0, 1 ],
    "bindings": [
      { "binding_type": "collection", "binding_collection_name": "container_items", "binding_name": "#hover_text", "binding_condition": "always" },
      { "binding_type": "view", "binding_condition": "always", "source_property_name": "('%.12s' * (#hover_text - '§o' - '§f'))", "target_property_name": "#count_head" },
      { "binding_type": "view", "binding_condition": "always", "source_property_name": "(#count_head = '§ § § § ')", "target_property_name": "#visible" }
    ],
    "controls": [ { "l@sg_machine.net_count_label": {} } ]
  },
  "net_count_long": {
    "type": "panel",
    "size": [ 19, 10 ],
    "layer": 20,
    "clips_children": true,
    "anchor_from": "bottom_right",
    "anchor_to": "bottom_right",
    "offset": [ 0, 1 ],
    "bindings": [
      { "binding_type": "collection", "binding_collection_name": "container_items", "binding_name": "#hover_text", "binding_condition": "always" },
      { "binding_type": "view", "binding_condition": "always", "source_property_name": "('%.12s' * (#hover_text - '§o' - '§f'))", "target_property_name": "#count_head" },
      { "binding_type": "view", "binding_condition": "always", "source_property_name": "((not (#count_head = '§ § § § ')) and (not (#hover_text = '')))", "target_property_name": "#visible" }
    ],
    "controls": [ { "l@sg_machine.net_count_label": { "$net_count_scale": 0.62 } } ]
  },
  "net_count_label": {
    "$net_count_scale|default": 0.86,
    "type": "label",
    "localize": false,
    "color": [ 1, 1, 1 ],
    "shadow": true,
    "font_scale_factor": "$net_count_scale",
    "anchor_from": "bottom_right",
    "anchor_to": "bottom_right",
    "text": "#text",
    "bindings": [
      { "binding_type": "collection", "binding_collection_name": "container_items", "binding_name": "#hover_text", "binding_condition": "always" },
      { "binding_type": "view", "binding_condition": "always", "source_property_name": "(('§r' + ('%.21s' * (#hover_text - '§o' - '§f'))) - '§')", "target_property_name": "#text" }
    ]
  },
  // The crafting window of a terminal (terminalgrid.go), laid out like the
