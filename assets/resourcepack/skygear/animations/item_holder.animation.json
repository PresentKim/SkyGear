{
  "format_version": "1.8.0",
  "animations": {
    "animation.skygear.item_holder.handheld": {
      "loop": true,
      "bones": {
        "rightitem_handheld": {
          "rotation": [
            "query.variant > 0 ? math.mod(query.variant, 73) * 5 - 180 : 0",
            "query.variant > 0 ? math.mod(math.floor(query.variant / 73), 73) * 5 - 180 : 0",
            "query.variant > 0 ? math.floor(query.variant / 5329) * 5 - 180 : 0"
          ],
          "position": [
            "query.mark_variant > 0 ? math.mod(math.floor(query.mark_variant / 256), 32) - 16 : 0",
            "query.mark_variant > 0 ? math.mod(math.floor(query.mark_variant / 8192), 32) - 16 : 0",
            "query.mark_variant > 0 ? math.floor(query.mark_variant / 262144) - 16 : 0"
          ],
          "scale": "query.mark_variant > 0 ? math.mod(query.mark_variant, 256) / 100 : 0.65"
        }
      }
    }
  }
}
