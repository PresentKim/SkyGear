{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "skygear:range_box",
      "materials": {
        "default": "entity_alphablend"
      },
      "textures": {
        "default": "textures/entity/skygear/range_box"
      },
      "geometry": {
        "default": "geometry.skygear.range_box"
      },
      "animations": {
        "size": "animation.skygear.range_box.size"
      },
      "scripts": {
        "pre_animation": [
          "variable.w = math.mod(query.variant, 64) + 0.04;",
          "variable.h = math.mod(math.floor(query.variant / 64), 32) + 0.04;",
          "variable.d = math.mod(math.floor(query.variant / 2048), 64) + 0.04;",
          "variable.drop = math.floor(query.variant / 131072) - 64 + 1.02;"
        ],
        "animate": [
          "size"
        ]
      },
      "render_controllers": [
        "controller.render.skygear_range_box"
      ]
    }
  }
}
