{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "skygear:snowfall",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/snowflake"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 60,
        "max_particles": 240
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 2.2
      },
      "minecraft:emitter_shape_box": {
        "offset": [0, 24, 0],
        "half_dimensions": [14, 2, 14],
        "direction": [0, -1, 0]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "14 + variable.particle_random_1 * 2"
      },
      "minecraft:particle_initial_speed": "1.5 + variable.particle_random_2 * 0.5",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "math.sin(variable.particle_age * 90 + variable.particle_random_3 * 360) * 0.8",
          -1,
          "math.cos(variable.particle_age * 70 + variable.particle_random_4 * 360) * 0.8"
        ],
        "linear_drag_coefficient": 0.5
      },
      "minecraft:particle_motion_collision": {
        "collision_radius": 0.05,
        "expire_on_contact": true
      },
      "minecraft:particle_appearance_billboard": {
        "size": ["0.05 + variable.particle_random_1 * 0.05", "0.05 + variable.particle_random_1 * 0.05"],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 8,
          "texture_height": 8,
          "uv": [0, 0],
          "uv_size": [8, 8]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [1, 1, 1, 0.9]
      },
      "minecraft:particle_appearance_lighting": {}
    }
  }
}
