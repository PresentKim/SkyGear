// Slot decoration (docs/tech/slotdeco.md). The marks in an item's name
// (common/slotdeco) choose a front badge (tier pips) for every slot that
// shows the item and the rarity frame of the selected-item bubble. Edit by
// hand.
{
  "namespace": "sg_slot",
  "front": {
    "type": "image",
    "layer": 9,
    "size": [
      "100%",
      "100%"
    ],
    "texture": "#texture",
    "bindings": [
      {
        "binding_name": "#hover_text",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection_name"
      },
      {
        "binding_type": "view",
        "source_property_name": "((not ((#hover_text - '§k§l§r§1§r') = #hover_text)) * 1 + (not ((#hover_text - '§k§l§r§2§r') = #hover_text)) * 2 + (not ((#hover_text - '§k§l§r§3§r') = #hover_text)) * 3 + (not ((#hover_text - '§k§l§r§4§r') = #hover_text)) * 4 + (not ((#hover_text - '§k§l§r§5§r') = #hover_text)) * 5 + (not ((#hover_text - '§k§l§r§6§r') = #hover_text)) * 6)",
        "target_property_name": "#sg_tier"
      },
      {
        "binding_type": "view",
        "source_property_name": "('textures/ui/sg/front_' + #sg_tier)",
        "target_property_name": "#texture"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#sg_tier > 0)",
        "target_property_name": "#visible"
      }
    ]
  },
  "tip": {
    "type": "image",
    "layer": 1,
    "size": [
      "100%sm + 8px",
      "100%sm + 8px"
    ],
    "texture": "#texture",
    "bindings": [
      {
        "binding_name": "#selected_hover_text"
      },
      {
        "binding_type": "view",
        "source_property_name": "((not ((#selected_hover_text - '§k§r§a') = #selected_hover_text)) * 1 + (not ((#selected_hover_text - '§k§r§b') = #selected_hover_text)) * 2 + (not ((#selected_hover_text - '§k§r§d') = #selected_hover_text)) * 3 + (not ((#selected_hover_text - '§k§r§6') = #selected_hover_text)) * 4)",
        "target_property_name": "#sg_rarity"
      },
      {
        "binding_type": "view",
        "source_property_name": "('textures/ui/sg/tip_' + #sg_rarity)",
        "target_property_name": "#texture"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#sg_rarity > 0)",
        "target_property_name": "#visible"
      }
    ]
  }
}
