  "gslot_face_tip@df_form.gslot_face": {
    "controls": [
      { "bg@df_form.state_image": { "$df_state_texture": "$df_slot_texture" } },
      { "icon@df_form.button_icon": { "$df_icon_size": [ 16, 16 ] } },
      { "count@df_form.gslot_count": {} },
      { "tipl@df_form.gslot_tooltip_l": {} },
      { "tipr@df_form.gslot_tooltip_r": {} }
    ]
  },

  // gslot_button (mouse): hovering or pressing shows the tooltip.
  "gslot_button@common.button": {
    "$pressed_button_name": "button.form_button_click",
    "size": [ 22, 22 ],
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      }
    ],
    "controls": [
      { "default@df_form.gslot_face": {} },
      { "hover@df_form.gslot_face_tip": { "$df_slot_texture": "textures/ui/df/button_hover" } },
      { "pressed@df_form.gslot_face_tip": { "$df_slot_texture": "textures/ui/df/button_pressed" } }
    ]
  },

  // gslot_toggle (touch): the first tap selects the slot and shows the
  // tooltip, a tap on the selected slot presses it.
  "gslot_toggle@common.toggle": {
    "size": [ 22, 22 ],
    "$radio_toggle_group": true,
    "$toggle_name": "df_form_gslot",
    "$toggle_binding_type": "none",
    "$toggle_property_bag": { "#toggle_state": false },
    "$unchecked_control": "df_form.gslot_face",
    "$unchecked_hover_control": "df_form.gslot_face",
    "$unchecked_locked_control": "df_form.gslot_face",
    "$unchecked_locked_hover_control": "df_form.gslot_face",
    "$checked_control": "df_form.gslot_selected",
    "$checked_hover_control": "df_form.gslot_selected",
    "$checked_locked_control": "df_form.gslot_face",
    "$checked_locked_hover_control": "df_form.gslot_face"
  },

  "gslot_selected": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      { "press@df_form.gslot_press": { "layer": 10 } },
      { "tipl@df_form.gslot_tooltip_l": {} },
      { "tipr@df_form.gslot_tooltip_r": {} }
    ]
  },

  "gslot_press@common.button": {
    "$pressed_button_name": "button.form_button_click",
    "size": [ "100%", "100%" ],
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      }
    ],
    "controls": [
      { "default@df_form.gslot_face": { "$df_slot_texture": "textures/ui/df/button_hover" } },
      { "hover@df_form.gslot_face": { "$df_slot_texture": "textures/ui/df/button_hover" } },
      { "pressed@df_form.gslot_face": { "$df_slot_texture": "textures/ui/df/button_pressed" } }
    ]
  },

  "action_item@df_form.vis_action": {
    "type": "panel",
    "size": [ "100%", 32 ],
    "controls": [ { "button@df_form.list_button": {} } ]
  }
}
