    "anchor_to": "top_left",
    "factory": {
      "name": "buttons",
      "control_ids": { "button": "df_form.slot_info_item" }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length",
        "binding_condition": "visible"
      }
    ]
  },
  "marked_slot_upgrade": {
    "type": "stack_panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "factory": {
      "name": "buttons",
      "control_ids": { "button": "df_form.slot_upgrade_item" }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length",
        "binding_condition": "visible"
      }
    ]
  },
  "marked_slot_util": {
    "type": "stack_panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "factory": {
      "name": "buttons",
      "control_ids": { "button": "df_form.slot_util_item" }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length",
        "binding_condition": "visible"
      }
    ]
  },
  "slot_form": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "window@df_form.window": {
          "$df_window_size": [ 220, 136 ],
          "$df_content": "df_form.slot_content"
        }
      }
    ]
  },

  "slot_section_label": {
    "type": "label",
    "color": [ 0.62, 0.65, 0.72 ],
    "font_scale_factor": 0.8,
    "size": [ "default", 10 ]
  },

  "slot_content": {
    "type": "stack_panel",
    "size": [ "100% - 8px", "100%c" ],
    "offset": [ 4, 2 ],
    "orientation": "vertical",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {
        "top": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "size": [ "100%", "100%cm" ],
          "controls": [
            {
              "store@df_form.marked_slot_store": {
                "orientation": "horizontal",
                "size": [ "100%c", "100%cm" ]
              }
