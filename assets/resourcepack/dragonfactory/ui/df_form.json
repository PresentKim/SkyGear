  // Upgrade and utility slots: a button that shows its text as a tooltip
  // while hovered or pressed (mouse), or on touch a toggle: the first tap
  // selects the slot and shows the tooltip, a tap on the selected slot
  // presses it (11th playtest).
  "slot_upgrade_item@df_form.vis_slot_upgrade": {
    "type": "panel",
    "size": [ 24, 24 ],
    "$df_slot_control|default": "df_form.slot_button",
    "variables": [ { "requires": "$touch", "$df_slot_control": "df_form.slot_toggle" } ],
    "controls": [ { "slot@$df_slot_control": {} } ]
  },

  "slot_util_item@df_form.vis_slot_util": {
    "type": "panel",
    "size": [ 24, 24 ],
    "$df_slot_control|default": "df_form.slot_button",
    "variables": [ { "requires": "$touch", "$df_slot_control": "df_form.slot_toggle" } ],
    "controls": [ { "slot@$df_slot_control": {} } ]
  },

  // slot_tooltip is the engine's own tooltip (hover_text_renderer, the one
  // inventory items use), drawn at the pointer over every pane, so a pane
  // cannot clip it. It shows the whole button text; it only exists inside
  // the hovered or selected state of a slot.
  "slot_tooltip@common.hover_text": {
    "$hover_text_max_width": 0,
    "layer": 200,
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_name_override": "#hover_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      }
