  // gslot_count is the count at the slot's bottom right: bytes 9 to 19 of
  // the button text without the '~' padding.
  "gslot_count": {
    "type": "label",
    "layer": 4,
    "text": "#df_count",
    "color": [ 1, 1, 1 ],
    "shadow": true,
    "font_scale_factor": 0.75,
    "text_alignment": "right",
    "size": [ "default", "default" ],
    "offset": [ -1, 0 ],
    "anchor_from": "bottom_right",
    "anchor_to": "bottom_right",
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection", 
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", 
        "source_property_name": "((((('%.10s' * (#form_button_text - ('%.10s' * #form_button_text))) - '~~~~~~~~') - '~~~~') - '~~') - '~')",
        "target_property_name": "#df_count"
      }
    ]
  },

  // The tooltip is the text from byte 20 on, drawn by the engine at the
  // pointer (hover_text_renderer) so no pane clips it and no side has to be
  // chosen; the side byte (10) of the button text is not used any more.
  "gslot_hover_tip@common.hover_text": {
    "$hover_text_max_width": 0,
    "layer": 200,
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#form_button_text - ('%.20s' * #form_button_text))",
        "target_property_name": "#hover_text"
      }
    ]
  },

