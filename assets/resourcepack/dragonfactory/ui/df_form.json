    "size": [ "100% - 6px", "100%c" ],
    "orientation": "vertical",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      { "tabs@df_form.tabs": {} },
      {
        "body": {
          "type": "panel",
          "size": [ "100%", "100%c" ],
          "controls": [ { "label@df_form.body_label": {} } ]
        }
      },
      { "gap": { "type": "panel", "size": [ "100%", 6 ] } },
      {
        "cards_row": {
          "type": "panel",
          "size": [ "100%", "100%c" ],
          "controls": [
            {
              // Six 56px cells (336px) fill the 336px content (360px
