{
  // Dark DragonFactory theme for server forms. Textures: textures/ui/df
  // (generated by tools/uitextures). Button wiring follows the vanilla
  // server_form.dynamic_button contract: the button binds collection_details
  // of "form_buttons" and presses button.form_button_click.
  "namespace": "df_form",


  "title_label": {
    "type": "label",
    "text": "#df_title",
    "color": [ 0.93, 0.66, 0.19 ],
    "shadow": true,
    "size": [ "100% - 30px", "default" ],
    "offset": [ 8, 0 ],
    "anchor_from": "left_middle",
    "anchor_to": "left_middle",
    "layer": 2,
    "bindings": [
      { "binding_name": "#title_text", "binding_type": "global", "binding_condition": "once" },
      {
        "binding_type": "view", "binding_condition": "once",
        "source_property_name": "(#title_text - '§d§f§c§r' - '§d§f§s§r' - '§d§f§t§r' - '§d§f§i§r' - '§d§f§g§r' - '§d§f§h§r')",
        "target_property_name": "#df_title"
      }
    ]
  },

  // window draws the panel, the title bar and the close button around
  // $df_content.
  "window": {
    "type": "image",
    "texture": "textures/ui/df/panel",
    "$df_window_size|default": [ 280, "90%" ],
    "size": "$df_window_size",
    "max_size": [ "100% - 8px", "100% - 8px" ],
    "layer": 2,
    "controls": [
      {
        "title_bar": {
          "type": "image",
          "texture": "textures/ui/df/title",
          "size": [ "100% - 4px", 22 ],
          "offset": [ 0, 2 ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "layer": 1,
          "controls": [
            { "title@df_form.title_label": {} },
            {
              // The back button (ui.Back, marked §0§3§r) sits left of the
              // close button.
              "back@df_form.marked_back": {
                "orientation": "horizontal",
                "size": [ "100%c", 20 ],
                "offset": [ -24, 0 ],
                "anchor_from": "right_middle",
                "anchor_to": "right_middle"
              }
            },
            {
              "close@common.close_button": {
                "$close_button_offset": [ -1, 0 ],
                "anchor_from": "right_middle",
                "anchor_to": "right_middle"
              }
            }
          ]
        }
      },
      {
        "content": {
          "type": "panel",
          "size": [ "100% - 12px", "100% - 32px" ],
          "offset": [ 0, 27 ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "layer": 2,
          "controls": [ { "inner@$df_content": {} } ]
        }
      }
    ]
  },

  "body_label": {
    "type": "label",
    "text": "#form_text",
    "color": [ 0.85, 0.87, 0.9 ],
    "size": [ "100% - 4px", "default" ],
    "offset": [ 2, 0 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left"
  },

  // ---- marked buttons (ui.Tab, ui.Back, table actions) ----
  // Stack panels over all form buttons that show only the buttons of one
  // kind (one control per kind: a factory's control id cannot be a
  // variable): the item template hides the others, and hidden controls take no
  // space in a stack panel. Lists and grids hide every marked button (all
  // markers start with §0§).

  "marked_back": {
    "type": "stack_panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "factory": {
      "name": "buttons",
      "control_ids": { "button": "df_form.back_item" }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length"
      }
    ]
  },

  "marked_tabs": {
    "type": "stack_panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "factory": {
      "name": "buttons",
      "control_ids": { "button": "df_form.tab_item" }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length"
      }
    ]
  },

  "marked_total": {
    "type": "stack_panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "factory": {
      "name": "buttons",
      "control_ids": { "button": "df_form.total_item" }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length"
      }
    ]
  },

  "marked_actions": {
    "type": "stack_panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "factory": {
      "name": "buttons",
      "control_ids": { "button": "df_form.action_item" }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length"
      }
    ]
  },

  // The vis_* templates show their control only for buttons with a marker.
  // The markers are literal in each expression: variables are not
  // substituted inside binding expressions (8th playtest: no tabs shown).
  // vis_back: the back button
  "vis_back": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection", "binding_condition": "always_when_visible",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", "binding_condition": "always_when_visible",
        "source_property_name": "(not ((#form_button_text - '§0§3§r') = #form_button_text))",
        "target_property_name": "#visible"
      }
    ]
  },

  // vis_tab: tabs
  "vis_tab": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection", "binding_condition": "always_when_visible",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", "binding_condition": "always_when_visible",
        "source_property_name": "((not ((#form_button_text - '§0§1§r') = #form_button_text)) or (not ((#form_button_text - '§0§2§r') = #form_button_text)))",
        "target_property_name": "#visible"
      }
    ]
  },

  // vis_tab_on: the selected tab
  "vis_tab_on": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection", "binding_condition": "always_when_visible",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", "binding_condition": "always_when_visible",
        "source_property_name": "(not ((#form_button_text - '§0§2§r') = #form_button_text))",
        "target_property_name": "#visible"
      }
    ]
  },

  // vis_cell: table cells
  "vis_cell": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection", "binding_condition": "always_when_visible",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", "binding_condition": "always_when_visible",
        "source_property_name": "((not ((#form_button_text - '§0§5§r') = #form_button_text)) or (not ((#form_button_text - '§0§6§r') = #form_button_text)))",
        "target_property_name": "#visible"
      }
    ]
  },

  // vis_cell_text: text cells
  "vis_cell_text": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection", "binding_condition": "always_when_visible",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", "binding_condition": "always_when_visible",
        "source_property_name": "(not ((#form_button_text - '§0§5§r') = #form_button_text))",
        "target_property_name": "#visible"
      }
    ]
  },

  // vis_cell_num: number cells
  "vis_cell_num": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection", "binding_condition": "always_when_visible",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", "binding_condition": "always_when_visible",
        "source_property_name": "(not ((#form_button_text - '§0§6§r') = #form_button_text))",
        "target_property_name": "#visible"
      }
    ]
  },

  // vis_total: the table total
  "vis_total": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection", "binding_condition": "always_when_visible",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", "binding_condition": "always_when_visible",
        "source_property_name": "(not ((#form_button_text - '§0§8§r') = #form_button_text))",
        "target_property_name": "#visible"
      }
    ]
  },

  // vis_action: table actions
  "vis_action": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection", "binding_condition": "always_when_visible",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", "binding_condition": "always_when_visible",
        "source_property_name": "(not ((#form_button_text - '§0§4§r') = #form_button_text))",
        "target_property_name": "#visible"
      }
    ]
  },

  // unmarked_visible shows its control only for normal buttons.
  "unmarked_visible": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection", "binding_condition": "always_when_visible",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", "binding_condition": "always_when_visible",
        "source_property_name": "((#form_button_text - '§0§') = #form_button_text)",
        "target_property_name": "#visible"
      }
    ]
  },

  "back_item@df_form.vis_back": {
    "type": "panel",
    "size": [ 22, 20 ],
    "controls": [ { "button@df_form.icon_button": {} } ]
  },

  // icon_button is a small square button showing only the icon.
  "icon_button@common.button": {
    "$pressed_button_name": "button.form_button_click",
    "size": [ 20, 18 ],
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      }
    ],
    "controls": [
      { "default@df_form.state_image": { "$df_state_texture": "textures/ui/df/button" } },
      { "hover@df_form.state_image": { "$df_state_texture": "textures/ui/df/button_hover" } },
      { "pressed@df_form.state_image": { "$df_state_texture": "textures/ui/df/button_pressed" } },
      { "icon@df_form.button_icon": { "$df_icon_size": [ 12, 12 ] } }
    ]
  },

  // tabs is the strip of tab buttons at the top of the content.
  // The strip is as high as one tab ("100%cm": the largest child; "100%c"
  // added up every tab's height, 9th playtest), and 0 high without tabs.
  "tabs": {
    "type": "panel",
    "size": [ "100%", "100%cm" ],
    "controls": [
      {
        "strip@df_form.marked_tabs": {
          "orientation": "horizontal",
          "size": [ "100%", "100%cm" ]
        }
      }
    ]
  },

  "tab_item@df_form.vis_tab": {
    "type": "panel",
    "size": [ 64, 24 ],
    "controls": [ { "button@df_form.tab_button": {} } ]
  },

  "tab_button@common.button": {
    "$pressed_button_name": "button.form_button_click",
    "size": [ 62, 22 ],
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      }
    ],
    "controls": [
      { "default@df_form.state_image": { "$df_state_texture": "textures/ui/df/button" } },
      { "hover@df_form.state_image": { "$df_state_texture": "textures/ui/df/button_hover" } },
      { "pressed@df_form.state_image": { "$df_state_texture": "textures/ui/df/button_pressed" } },
      {
        // The selected tab (§0§2§r) keeps the highlighted look.
        "selected@df_form.vis_tab_on": {
          "type": "image",
          "texture": "textures/ui/df/button_hover",
          "size": [ "100%", "100%" ],
          "layer": 2
        }
      },
      {
        "icon@df_form.button_icon": {
          "$df_icon_size": [ 14, 14 ],
          "offset": [ 4, 0 ],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle"
        }
      },
      {
        "text": {
          "type": "label",
          "layer": 3,
          "text": "#form_button_text",
          "color": [ 0.95, 0.95, 0.97 ],
          "font_scale_factor": 0.8,
          "size": [ "100% - 22px", "default" ],
          "offset": [ 20, 0 ],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "bindings": [
            {
              "binding_name": "#form_button_text",
              "binding_type": "collection", "binding_condition": "always_when_visible",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      }
    ]
  },

  // ---- list (ActionForm, Modal) ----

  "action_form": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      { "window@df_form.window": { "$df_content": "df_form.list_scroll" } }
    ]
  },

  "list_scroll@common.scrolling_panel": {
    "anchor_to": "top_left",
    "anchor_from": "top_left",
    "$show_background": false,
    "size": [ "100%", "100%" ],
    "$scrolling_content": "df_form.list_content",
    "$scroll_size": [ 4, "100% - 4px" ],
    "$scrolling_pane_size": [ "100% - 6px", "100%" ],
    "$scrolling_pane_offset": [ 0, 0 ],
    "$scroll_bar_right_padding_size": [ 0, 0 ]
  },

  "list_content": {
    "type": "stack_panel",
    "size": [ "100% - 6px", "100%c" ],
    "orientation": "vertical",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      { "tabs@df_form.tabs": {} },
      {
        "body": {
          "type": "panel",
          "size": [ "100%", "100%c" ],
          "controls": [ { "label@df_form.body_label": {} } ]
        }
      },
      { "gap": { "type": "panel", "size": [ "100%", 6 ] } },
      { "buttons@df_form.list_buttons": {} }
    ]
  },

  "list_buttons": {
    "type": "stack_panel",
    "size": [ "100%", "100%c" ],
    "orientation": "vertical",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "factory": {
      "name": "buttons",
      "control_ids": {
        "button": "df_form.list_row",
        "label": "@server_form.dynamic_label",
        "header": "@server_form.dynamic_header",
        "divider": "@settings_common.option_group_section_divider"
      }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length"
      }
    ]
  },

  // list_row is one button with a 2px gap below it.
  "list_row@df_form.unmarked_visible": {
    "type": "panel",
    "size": [ "100%", 32 ],
    "controls": [ { "button@df_form.list_button": {} } ]
  },

  "state_image": {
    "type": "image",
    "size": [ "100%", "100%" ],
    "texture": "$df_state_texture",
    "layer": 1
  },

  // button_icon is a button's icon. A texture path ("textures/...") shows as
  // an image; anything else is an item (ui.ItemIcon: runtime ID * 65536)
  // that the client's item renderer draws like an inventory slot, so items
  // and blocks need no icon texture (same trick as Chest-UI).
  "button_icon": {
    "type": "panel",
    "layer": 3,
    "$df_icon_size|default": [ 20, 20 ],
    "size": "$df_icon_size",
    "controls": [
      { "image@df_form.button_icon_image": {} },
      { "item@df_form.button_icon_item": {} }
    ]
  },

  "button_icon_image": {
    "type": "image",
    "size": [ "100%", "100%" ],
    "bindings": [
      {
        "binding_name": "#form_button_texture",
        "binding_name_override": "#texture",
        "binding_type": "collection", "binding_condition": "always_when_visible",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_name": "#form_button_texture_file_system",
        "binding_name_override": "#texture_file_system",
        "binding_type": "collection", "binding_condition": "always_when_visible",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", "binding_condition": "always_when_visible",
        "source_property_name": "(('%.8s' * #texture) = 'textures')",
        "target_property_name": "#visible"
      }
    ]
  },

  "button_icon_item": {
    "type": "custom",
    "renderer": "inventory_item_renderer",
    "size": [ "100%", "100%" ],
    "layer": 1,
    "bindings": [
      {
        "binding_name": "#form_button_texture",
        "binding_type": "collection", "binding_condition": "always_when_visible",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", "binding_condition": "always_when_visible",
        "source_property_name": "(not ((#form_button_texture = '') or (#form_button_texture = 'loading') or (('%.8s' * #form_button_texture) = 'textures')))",
        "target_property_name": "#visible"
      },
      {
        "binding_type": "view", "binding_condition": "always_when_visible",
        "source_property_name": "(#form_button_texture - (#form_button_texture % 65536))",
        "target_property_name": "#item_id_aux"
      }
    ]
  },

  "list_button@common.button": {
    "$pressed_button_name": "button.form_button_click",
    "size": [ "100%", 30 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      }
    ],
    "controls": [
      { "default@df_form.state_image": { "$df_state_texture": "textures/ui/df/button" } },
      { "hover@df_form.state_image": { "$df_state_texture": "textures/ui/df/button_hover" } },
      { "pressed@df_form.state_image": { "$df_state_texture": "textures/ui/df/button_pressed" } },
      {
        "icon@df_form.button_icon": {
          "offset": [ 6, 0 ],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle"
        }
      },
      {
        "text": {
          "type": "label",
          "layer": 3,
          "text": "#form_button_text",
          "color": [ 0.95, 0.95, 0.97 ],
          "size": [ "100% - 36px", "default" ],
          "offset": [ 32, 0 ],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "bindings": [
            {
              "binding_name": "#form_button_text",
              "binding_type": "collection", "binding_condition": "always_when_visible",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      }
    ]
  },

  // ---- custom form (input, dropdown, ...) ----
  // Vanilla fields drawn straight in the dark window.

  "custom_form": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "window@df_form.window": {
          "$df_window_size": [ 280, "55%" ],
          "$df_content": "server_form.custom_form_panel"
        }
      }
    ]
  },

  // ---- card grid (title starts with §d§f§c§r): menu and shop ----
  // Buttons as icon-and-text cards, three per row, as many rows as needed.

  "card_form": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "window@df_form.window": {
          "$df_window_size": [ 300, "90%" ],
          "$df_content": "df_form.card_scroll"
        }
      }
    ]
  },

  "card_scroll@common.scrolling_panel": {
    "anchor_to": "top_left",
    "anchor_from": "top_left",
    "$show_background": false,
    "size": [ "100%", "100%" ],
    "$scrolling_content": "df_form.card_content",
    "$scroll_size": [ 4, "100% - 4px" ],
    "$scrolling_pane_size": [ "100% - 6px", "100%" ],
    "$scrolling_pane_offset": [ 0, 0 ],
    "$scroll_bar_right_padding_size": [ 0, 0 ]
  },

  "card_content": {
    "type": "stack_panel",
    "size": [ "100% - 6px", "100%c" ],
    "orientation": "vertical",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      { "tabs@df_form.tabs": {} },
      {
        "body": {
          "type": "panel",
          "size": [ "100%", "100%c" ],
          "controls": [ { "label@df_form.body_label": {} } ]
        }
      },
      { "gap": { "type": "panel", "size": [ "100%", 6 ] } },
      {
        "cards_row": {
          "type": "panel",
          "size": [ "100%", "100%c" ],
          "controls": [
            {
              // Three 90px cells (270px) fit the 276px content; a 100%
              // wide grid rounded down to two columns (7th playtest).
              "cards": {
                "type": "grid",
                "size": [ 270, "100%c" ],
                "anchor_from": "top_middle",
                "anchor_to": "top_middle",
                "grid_rescaling_type": "horizontal",
                "grid_item_template": "df_form.card",
                "collection_name": "form_buttons",
                "bindings": [
                  {
                    "binding_name": "#form_button_length",
                    "binding_name_override": "#maximum_grid_items"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  // card is one cell: a button with the icon on top and two lines of text.
  // Marked buttons (tabs, back) leave an empty cell; they come last.
  "card@df_form.unmarked_visible": {
    "type": "panel",
    "size": [ 90, 60 ],
    "controls": [ { "button@df_form.card_button": {} } ]
  },

  // ---- compact card grid (title starts with §d§f§s§r): the shop ----
  // Small cards, six per row in a wider window.

  "shop_form": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "window@df_form.window": {
          "$df_window_size": [ 360, "90%" ],
          "$df_content": "df_form.shop_scroll"
        }
      }
    ]
  },

  "shop_scroll@common.scrolling_panel": {
    "anchor_to": "top_left",
    "anchor_from": "top_left",
    "$show_background": false,
    "size": [ "100%", "100%" ],
    "$scrolling_content": "df_form.shop_content",
    "$scroll_size": [ 4, "100% - 4px" ],
    "$scrolling_pane_size": [ "100% - 6px", "100%" ],
    "$scrolling_pane_offset": [ 0, 0 ],
    "$scroll_bar_right_padding_size": [ 0, 0 ]
  },

  "shop_content": {
    "type": "stack_panel",
    "size": [ "100% - 6px", "100%c" ],
    "orientation": "vertical",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      { "tabs@df_form.tabs": {} },
      {
        "body": {
          "type": "panel",
          "size": [ "100%", "100%c" ],
          "controls": [ { "label@df_form.body_label": {} } ]
        }
      },
      { "gap": { "type": "panel", "size": [ "100%", 6 ] } },
      {
        "cards_row": {
          "type": "panel",
          "size": [ "100%", "100%c" ],
          "controls": [
            {
              // Six 56px cells (336px) fill the 336px content (360px
              // window - 12px - 6px scroll bar - 6px); 340px cut off the
              // left column (9th playtest).
              "cards": {
                "type": "grid",
                "size": [ 336, "100%c" ],
                "anchor_from": "top_middle",
                "anchor_to": "top_middle",
                "grid_rescaling_type": "horizontal",
                "grid_item_template": "df_form.shop_card",
                "collection_name": "form_buttons",
                "bindings": [
                  {
                    "binding_name": "#form_button_length",
                    "binding_name_override": "#maximum_grid_items"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },


  // shop_card is a small, inventory-like cell: icon, name and price.
  "shop_card@df_form.unmarked_visible": {
    "type": "panel",
    "size": [ 56, 48 ],
    "controls": [
      {
        "button@df_form.card_button": {
          "size": [ 54, 46 ],
          "$df_card_icon": [ 16, 16 ],
          "$df_card_font": 0.6
        }
      }
    ]
  },

  "card_button@common.button": {
    "$pressed_button_name": "button.form_button_click",
    "$df_card_icon|default": [ 20, 20 ],
    "$df_card_font|default": 0.8,
    "size": [ 86, 56 ],
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      }
    ],
    "controls": [
      { "default@df_form.state_image": { "$df_state_texture": "textures/ui/df/button" } },
      { "hover@df_form.state_image": { "$df_state_texture": "textures/ui/df/button_hover" } },
      { "pressed@df_form.state_image": { "$df_state_texture": "textures/ui/df/button_pressed" } },
      {
        "icon@df_form.button_icon": {
          "$df_icon_size": "$df_card_icon",
          "offset": [ 0, 4 ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle"
        }
      },
      {
        "text": {
          "type": "label",
          "layer": 3,
          "text": "#form_button_text",
          "color": [ 0.95, 0.95, 0.97 ],
          "text_alignment": "center",
          "font_scale_factor": "$df_card_font",
          "size": [ "100% - 4px", "default" ],
          "offset": [ 0, -3 ],
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "bindings": [
            {
              "binding_name": "#form_button_text",
              "binding_type": "collection", "binding_condition": "always_when_visible",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      }
    ]
  },

  // ---- table (title starts with §d§f§t§r, Go ui.TableMenu) ----
  // Non-clickable cells (§0§5§r text, §0§6§r number, §0§7§r header) four
  // per row, then the total line (§0§8§r) and the action buttons (§0§4§r).

  "table_form": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "window@df_form.window": {
          "$df_window_size": [ 340, "80%" ],
          "$df_content": "df_form.table_scroll"
        }
      }
    ]
  },

  "table_scroll@common.scrolling_panel": {
    "anchor_to": "top_left",
    "anchor_from": "top_left",
    "$show_background": false,
    "size": [ "100%", "100%" ],
    "$scrolling_content": "df_form.table_content",
    "$scroll_size": [ 4, "100% - 4px" ],
    "$scrolling_pane_size": [ "100% - 6px", "100%" ],
    "$scrolling_pane_offset": [ 0, 0 ],
    "$scroll_bar_right_padding_size": [ 0, 0 ]
  },

  "table_content": {
    "type": "stack_panel",
    "size": [ "100% - 6px", "100%c" ],
    "orientation": "vertical",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {
        "body": {
          "type": "panel",
          "size": [ "100%", "100%c" ],
          "controls": [ { "label@df_form.body_label": {} } ]
        }
      },
      { "gap": { "type": "panel", "size": [ "100%", 4 ] } },
      {
        "cells_row": {
          "type": "panel",
          "size": [ "100%", "100%c" ],
          "controls": [
            {
              "cells": {
                "type": "grid",
                "size": [ 320, "100%c" ],
                "anchor_from": "top_middle",
                "anchor_to": "top_middle",
                "grid_rescaling_type": "horizontal",
                "grid_item_template": "df_form.table_cell",
                "collection_name": "form_buttons",
                "bindings": [
                  {
                    "binding_name": "#form_button_length",
                    "binding_name_override": "#maximum_grid_items"
                  }
                ]
              }
            }
          ]
        }
      },
      { "gap2": { "type": "panel", "size": [ "100%", 6 ] } },
      {
        "total@df_form.marked_total": {
          "orientation": "vertical",
          "size": [ "100%", "100%c" ]
        }
      },
      { "gap3": { "type": "panel", "size": [ "100%", 4 ] } },
      {
        "actions@df_form.marked_actions": {
          "orientation": "vertical",
          "size": [ "100%", "100%c" ]
        }
      }
    ]
  },

  // table_cell is one 80×20 cell; non-cell buttons (total, actions) come
  // last and leave empty cells.
  "table_cell@df_form.vis_cell": {
    "type": "panel",
    "size": [ 80, 20 ],
    "controls": [
      { "line": { "type": "image", "texture": "textures/ui/df/slot", "size": [ "100%", 1 ], "anchor_from": "bottom_middle", "anchor_to": "bottom_middle", "alpha": 0.5 } },
      {
        // 16×16 like an inventory slot: the item renderer draws items at
        // that size and a smaller box let them spill over the left edge,
        // where the scroll view clipped them (10th playtest; still a little
        // at 4, 11th playtest).
        "icon@df_form.button_icon": {
          "$df_icon_size": [ 16, 16 ],
          "offset": [ 7, 0 ],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle"
        }
      },
      {
        // Text cells: left, after the icon if there is one.
        "text@df_form.cell_text": {
          "text_alignment": "left",
          "offset": [ 26, 0 ],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle"
        }
      },
      {
        // Number cells: right-aligned.
        "num@df_form.cell_num": {
          "text_alignment": "right",
          "offset": [ -4, 0 ],
          "anchor_from": "right_middle",
          "anchor_to": "right_middle"
        }
      }
    ]
  },

  // cell_text and cell_num are the labels of text and number cells.
  "cell_text@df_form.vis_cell_text": {
    "type": "label",
    "layer": 3,
    "text": "#form_button_text",
    "color": [ 0.95, 0.95, 0.97 ],
    "font_scale_factor": 0.85,
    "size": [ "100% - 20px", "default" ]
  },

  "cell_num@df_form.vis_cell_num": {
    "type": "label",
    "layer": 3,
    "text": "#form_button_text",
    "color": [ 0.95, 0.95, 0.97 ],
    "font_scale_factor": 0.85,
    "size": [ "100% - 20px", "default" ]
  },

  "total_item@df_form.vis_total": {
    "type": "panel",
    "size": [ "100%", 18 ],
    "controls": [
      {
        "text": {
          "type": "label",
          "text": "#form_button_text",
          "color": [ 0.93, 0.66, 0.19 ],
          "text_alignment": "right",
          "size": [ "100% - 8px", "default" ],
          "offset": [ -4, 0 ],
          "anchor_from": "right_middle",
          "anchor_to": "right_middle",
          "bindings": [
            {
              "binding_name": "#form_button_text",
              "binding_type": "collection", "binding_condition": "always_when_visible",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      }
    ]
  },

  // ---- slots (title starts with §d§f§i§r, Go ui.SlotMenu) ----
  // An inventory-like window (the drawer, 11th playtest): a storage slot
  // that only shows (§0§9§r: icon, count at the bottom right) with info
  // text on its right (§0§b§r), then pressable slots in two groups, storage
  // upgrades on the left (§0§a§r) and utilities on the right (§0§c§r), whose
  // text is their tooltip, then action buttons (§0§4§r).

  "vis_slot_store": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection", "binding_condition": "always_when_visible",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", "binding_condition": "always_when_visible",
        "source_property_name": "(not ((#form_button_text - '§0§9§r') = #form_button_text))",
        "target_property_name": "#visible"
      }
    ]
  },
  "vis_slot_info": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection", "binding_condition": "always_when_visible",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", "binding_condition": "always_when_visible",
        "source_property_name": "(not ((#form_button_text - '§0§b§r') = #form_button_text))",
        "target_property_name": "#visible"
      }
    ]
  },
  "vis_slot_upgrade": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection", "binding_condition": "always_when_visible",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", "binding_condition": "always_when_visible",
        "source_property_name": "(not ((#form_button_text - '§0§a§r') = #form_button_text))",
        "target_property_name": "#visible"
      }
    ]
  },
  "vis_slot_util": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection", "binding_condition": "always_when_visible",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", "binding_condition": "always_when_visible",
        "source_property_name": "(not ((#form_button_text - '§0§c§r') = #form_button_text))",
        "target_property_name": "#visible"
      }
    ]
  },
  "marked_slot_store": {
    "type": "stack_panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "factory": {
      "name": "buttons",
      "control_ids": { "button": "df_form.slot_store_item" }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length"
      }
    ]
  },
  "marked_slot_info": {
    "type": "stack_panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "factory": {
      "name": "buttons",
      "control_ids": { "button": "df_form.slot_info_item" }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length"
      }
    ]
  },
  "marked_slot_upgrade": {
    "type": "stack_panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "factory": {
      "name": "buttons",
      "control_ids": { "button": "df_form.slot_upgrade_item" }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length"
      }
    ]
  },
  "marked_slot_util": {
    "type": "stack_panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "factory": {
      "name": "buttons",
      "control_ids": { "button": "df_form.slot_util_item" }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length"
      }
    ]
  },
  "slot_form": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "window@df_form.window": {
          "$df_window_size": [ 220, 136 ],
          "$df_content": "df_form.slot_content"
        }
      }
    ]
  },

  "slot_section_label": {
    "type": "label",
    "color": [ 0.62, 0.65, 0.72 ],
    "font_scale_factor": 0.8,
    "size": [ "default", 10 ]
  },

  "slot_content": {
    "type": "stack_panel",
    "size": [ "100% - 8px", "100%c" ],
    "offset": [ 4, 2 ],
    "orientation": "vertical",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {
        "top": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "size": [ "100%", "100%cm" ],
          "controls": [
            {
              "store@df_form.marked_slot_store": {
                "orientation": "horizontal",
                "size": [ "100%c", "100%cm" ]
              }
            },
            { "gap": { "type": "panel", "size": [ 6, 1 ] } },
            {
              "info@df_form.marked_slot_info": {
                "orientation": "vertical",
                "size": [ "fill", "100%cm" ]
              }
            }
          ]
        }
      },
      { "gap": { "type": "panel", "size": [ "100%", 8 ] } },
      {
        "bottom": {
          "type": "panel",
          "size": [ "100%", "100%cm" ],
          "controls": [
            {
              "left": {
                "type": "stack_panel",
                "orientation": "vertical",
                "size": [ "100%cm", "100%c" ],
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "controls": [
                  { "label@df_form.slot_section_label": { "text": "저장 업그레이드" } },
                  {
                    "slots@df_form.marked_slot_upgrade": {
                      "orientation": "horizontal",
                      "size": [ "100%c", "100%cm" ]
                    }
                  }
                ]
              }
            },
            {
              "right": {
                "type": "stack_panel",
                "orientation": "vertical",
                "size": [ "100%cm", "100%c" ],
                "anchor_from": "top_right",
                "anchor_to": "top_right",
                "controls": [
                  { "label@df_form.slot_section_label": { "text": "유틸리티" } },
                  {
                    "slots@df_form.marked_slot_util": {
                      "orientation": "horizontal",
                      "size": [ "100%c", "100%cm" ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      { "gap2": { "type": "panel", "size": [ "100%", 6 ] } },
      {
        "actions@df_form.marked_actions": {
          "orientation": "vertical",
          "size": [ "100%", "100%c" ]
        }
      }
    ]
  },

  // slot_store_item only shows: a slot with the icon and the count, no
  // button.
  "slot_store_item@df_form.vis_slot_store": {
    "type": "panel",
    "size": [ 32, 32 ],
    "controls": [
      { "bg@df_form.state_image": { "$df_state_texture": "textures/ui/df/slot" } },
      { "icon@df_form.button_icon": { "$df_icon_size": [ 24, 24 ] } },
      { "count@df_form.slot_count": {} }
    ]
  },

  "slot_info_item@df_form.vis_slot_info": {
    "type": "panel",
    "size": [ "100%", 32 ],
    "controls": [
      {
        "text": {
          "type": "label",
          "layer": 3,
          "text": "#form_button_text",
          "color": [ 0.95, 0.95, 0.97 ],
          "size": [ "100%", "default" ],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "bindings": [
            {
              "binding_name": "#form_button_text",
              "binding_type": "collection", "binding_condition": "always_when_visible",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      }
    ]
  },

  // Upgrade and utility slots: a button that shows its text as a tooltip
  // while hovered or pressed (mouse), or on touch a toggle: the first tap
  // selects the slot and shows the tooltip, a tap on the selected slot
  // presses it (11th playtest).
  "slot_upgrade_item@df_form.vis_slot_upgrade": {
    "type": "panel",
    "size": [ 24, 24 ],
    "$df_slot_control|default": "df_form.slot_button",
    "variables": [ { "requires": "$touch", "$df_slot_control": "df_form.slot_toggle" } ],
    "controls": [ { "slot@$df_slot_control": {} } ]
  },

  "slot_util_item@df_form.vis_slot_util": {
    "type": "panel",
    "size": [ 24, 24 ],
    "$df_slot_control|default": "df_form.slot_button",
    "variables": [ { "requires": "$touch", "$df_slot_control": "df_form.slot_toggle" } ],
    "controls": [ { "slot@$df_slot_control": {} } ]
  },

  // slot_tooltip shows the button text in a box above the slot.
  "slot_tooltip": {
    "type": "image",
    "texture": "textures/ui/df/panel",
    "layer": 200,
    "size": [ "100%c + 8px", "100%c + 6px" ],
    "offset": [ 0, -2 ],
    "anchor_from": "top_middle",
    "anchor_to": "bottom_middle",
    "controls": [
      {
        "text": {
          "type": "label",
          "layer": 1,
          "text": "#form_button_text",
          "color": [ 0.95, 0.95, 0.97 ],
          "font_scale_factor": 0.8,
          "size": [ "default", "default" ],
          "max_size": [ 150, "default" ],
          "bindings": [
            {
              "binding_name": "#form_button_text",
              "binding_type": "collection", "binding_condition": "always_when_visible",
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      }
    ]
  },

  // slot_face is a slot's look: the background texture and the icon.
  "slot_face": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "$df_slot_texture|default": "textures/ui/df/slot",
    "controls": [
      { "bg@df_form.state_image": { "$df_state_texture": "$df_slot_texture" } },
      { "icon@df_form.button_icon": { "$df_icon_size": [ 16, 16 ] } }
    ]
  },

  "slot_face_tip@df_form.slot_face": {
    "controls": [
      { "bg@df_form.state_image": { "$df_state_texture": "$df_slot_texture" } },
      { "icon@df_form.button_icon": { "$df_icon_size": [ 16, 16 ] } },
      { "tip@df_form.slot_tooltip": {} }
    ]
  },

  // slot_toggle (touch): unselected it only looks like a slot; selected it
  // is highlighted, shows the tooltip and carries the real button.
  "slot_toggle@common.toggle": {
    "size": [ 22, 22 ],
    "$radio_toggle_group": true,
    "$toggle_name": "df_form_slot",
    "$toggle_binding_type": "none",
    "$toggle_property_bag": { "#toggle_state": false },
    "$unchecked_control": "df_form.slot_face",
    "$unchecked_hover_control": "df_form.slot_face",
    "$unchecked_locked_control": "df_form.slot_face",
    "$unchecked_locked_hover_control": "df_form.slot_face",
    "$checked_control": "df_form.slot_selected",
    "$checked_hover_control": "df_form.slot_selected",
    "$checked_locked_control": "df_form.slot_face",
    "$checked_locked_hover_control": "df_form.slot_face"
  },

  "slot_selected": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      { "press@df_form.slot_press": { "layer": 10 } },
      { "tip@df_form.slot_tooltip": {} }
    ]
  },

  // slot_press is the real button of a selected touch slot.
  "slot_press@common.button": {
    "$pressed_button_name": "button.form_button_click",
    "size": [ "100%", "100%" ],
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      }
    ],
    "controls": [
      { "default@df_form.slot_face": { "$df_slot_texture": "textures/ui/df/button_hover" } },
      { "hover@df_form.slot_face": { "$df_slot_texture": "textures/ui/df/button_hover" } },
      { "pressed@df_form.slot_face": { "$df_slot_texture": "textures/ui/df/button_pressed" } }
    ]
  },

  "slot_count": {
    "type": "label",
    "layer": 4,
    "text": "#form_button_text",
    "color": [ 1, 1, 1 ],
    "shadow": true,
    "font_scale_factor": 0.75,
    "text_alignment": "right",
    "size": [ "default", "default" ],
    "offset": [ -1, 0 ],
    "anchor_from": "bottom_right",
    "anchor_to": "bottom_right",
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection", "binding_condition": "always_when_visible",
        "binding_collection_name": "form_buttons"
      }
    ]
  },

  // slot_button (mouse) looks like an inventory slot; hovering or
  // pressing it shows its text as a tooltip.
  "slot_button@common.button": {
    "$pressed_button_name": "button.form_button_click",
    "size": [ 22, 22 ],
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      }
    ],
    "controls": [
      { "default@df_form.slot_face": {} },
      { "hover@df_form.slot_face_tip": { "$df_slot_texture": "textures/ui/df/button_hover" } },
      { "pressed@df_form.slot_face_tip": { "$df_slot_texture": "textures/ui/df/button_pressed" } }
    ]
  },

  // ---- item slots (ui.ItemRows, ui.ItemGrid) ----
  // Forms that show items like an inventory: every slot is a button with the
  // item as its icon (button_icon), its count at the bottom right and its
  // tooltip (the item name and lines) in a box when hovered (mouse) or
  // selected by a first tap (touch). The button text carries all three at
  // fixed places, like the WAILA container fields: a 9 byte marker
  // (§0§d§r row A, §0§e§r row B, §0§f§r wrapping grid), the count in 10
  // bytes starting with a colour code and padded with '~', then the tooltip.
  // The pack cuts them with '%.9s' / '%.10s' / '%.19s' and strips the '~'
  // (a digits-only text would turn into a number and not show, so the colour
  // code stays). §0§g§r and §0§h§r are the headings of rows A and B.

  // Slot of row A.
  "vis_gslot_a": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection", "binding_condition": "always_when_visible",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", "binding_condition": "always_when_visible",
        "source_property_name": "(not ((#form_button_text - '§0§d§r') = #form_button_text))",
        "target_property_name": "#visible"
      }
    ]
  },
  // Slot of row B.
  "vis_gslot_b": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection", "binding_condition": "always_when_visible",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", "binding_condition": "always_when_visible",
        "source_property_name": "(not ((#form_button_text - '§0§e§r') = #form_button_text))",
        "target_property_name": "#visible"
      }
    ]
  },
  // Slot of the wrapping grid.
  "vis_gslot_w": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection", "binding_condition": "always_when_visible",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", "binding_condition": "always_when_visible",
        "source_property_name": "(not ((#form_button_text - '§0§f§r') = #form_button_text))",
        "target_property_name": "#visible"
      }
    ]
  },
  // Heading of row A.
  "vis_gslot_h1": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection", "binding_condition": "always_when_visible",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", "binding_condition": "always_when_visible",
        "source_property_name": "(not ((#form_button_text - '§0§g§r') = #form_button_text))",
        "target_property_name": "#visible"
      }
    ]
  },
  // Heading of row B.
  "vis_gslot_h2": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection", "binding_condition": "always_when_visible",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", "binding_condition": "always_when_visible",
        "source_property_name": "(not ((#form_button_text - '§0§h§r') = #form_button_text))",
        "target_property_name": "#visible"
      }
    ]
  },
  "marked_gslot_a": {
    "type": "stack_panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "factory": {
      "name": "buttons",
      "control_ids": { "button": "df_form.gslot_a_item" }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length"
      }
    ]
  },
  "marked_gslot_b": {
    "type": "stack_panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "factory": {
      "name": "buttons",
      "control_ids": { "button": "df_form.gslot_b_item" }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length"
      }
    ]
  },
  "marked_gslot_h1": {
    "type": "stack_panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "factory": {
      "name": "buttons",
      "control_ids": { "button": "df_form.gslot_h1_item" }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length"
      }
    ]
  },
  "marked_gslot_h2": {
    "type": "stack_panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "factory": {
      "name": "buttons",
      "control_ids": { "button": "df_form.gslot_h2_item" }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length"
      }
    ]
  },

  // The detail form (ui.ItemDetail, the research screen): two columns in a
  // 460px window. Left: a card with the big item, the name and status text
  // and below it the action buttons (marked_actions), then the description
  // (the form body). Right: the heading and row of slots of row A, then of
  // row B (§0§g§r, §0§d§r, §0§h§r, §0§e§r).
  "gslot_detail_form": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "window@df_form.window": {
          "$df_window_size": [ 460, "85%" ],
          "$df_content": "df_form.gslot_detail_scroll"
        }
      }
    ]
  },

  "gslot_detail_scroll@common.scrolling_panel": {
    "anchor_to": "top_left",
    "anchor_from": "top_left",
    "$show_background": false,
    "size": [ "100%", "100%" ],
    "$scrolling_content": "df_form.gslot_detail_content",
    "$scroll_size": [ 4, "100% - 4px" ],
    "$scrolling_pane_size": [ "100% - 6px", "100%" ],
    "$scrolling_pane_offset": [ 0, 0 ],
    "$scroll_bar_right_padding_size": [ 0, 0 ]
  },

  "gslot_detail_content": {
    "type": "stack_panel",
    "size": [ "100% - 6px", "100%c" ],
    "orientation": "horizontal",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {
        "left": {
          "type": "image",
          "texture": "textures/ui/df/panel",
          "size": [ 190, "100%c + 12px" ],
          "controls": [
            {
              "inner": {
                "type": "stack_panel",
                "orientation": "vertical",
                "size": [ "100% - 12px", "100%c" ],
                "offset": [ 6, 6 ],
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "controls": [
                  {
                    "card": {
                      "type": "stack_panel",
                      "orientation": "horizontal",
                      "size": [ "100%", "100%cm" ],
                      "controls": [
                        {
                          "icon@df_form.marked_gdetail_icon": {
                            "orientation": "horizontal",
                            "size": [ "100%c", "100%cm" ]
                          }
                        },
                        { "gap": { "type": "panel", "size": [ 6, 1 ] } },
                        {
                          "info": {
                            "type": "stack_panel",
                            "orientation": "vertical",
                            "size": [ "fill", "100%c" ],
                            "controls": [
                              {
                                "name@df_form.marked_gdetail_name": {
                                  "orientation": "vertical",
                                  "size": [ "100%", "100%c" ]
                                }
                              },
                              { "gap": { "type": "panel", "size": [ "100%", 4 ] } },
                              {
                                "actions@df_form.marked_actions": {
                                  "orientation": "vertical",
                                  "size": [ "100%", "100%c" ]
                                }
                              }
                            ]
                          }
                        }
                      ]
                    }
                  },
                  { "gap": { "type": "panel", "size": [ "100%", 8 ] } },
                  {
                    "body": {
                      "type": "panel",
                      "size": [ "100%", "100%c" ],
                      "controls": [ { "label@df_form.body_label": {} } ]
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      { "gap": { "type": "panel", "size": [ 8, 1 ] } },
      {
        "right": {
          "type": "image",
          "texture": "textures/ui/df/panel",
          "size": [ "fill", "100%c + 12px" ],
          "controls": [
            {
              "inner": {
                "type": "stack_panel",
                "orientation": "vertical",
                "size": [ "100% - 12px", "100%c" ],
                "offset": [ 6, 6 ],
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "controls": [
                  {
                    "head1@df_form.marked_gslot_h1": {
                      "orientation": "vertical",
                      "size": [ "100%", "100%c" ]
                    }
                  },
                  {
                    "row_a@df_form.marked_gslot_a": {
                      "orientation": "horizontal",
                      "size": [ "100%", "100%cm" ]
                    }
                  },
                  { "gap": { "type": "panel", "size": [ "100%", 10 ] } },
                  {
                    "head2@df_form.marked_gslot_h2": {
                      "orientation": "vertical",
                      "size": [ "100%", "100%c" ]
                    }
                  },
                  {
                    "row_b@df_form.marked_gslot_b": {
                      "orientation": "horizontal",
                      "size": [ "100%", "100%cm" ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  // The detail card: the big item and the name and status text of the one
  // button marked §0§i§r.
  "vis_gdetail": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection", "binding_condition": "always_when_visible",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", "binding_condition": "always_when_visible",
        "source_property_name": "(not ((#form_button_text - '§0§i§r') = #form_button_text))",
        "target_property_name": "#visible"
      }
    ]
  },
  "marked_gdetail_icon": {
    "type": "stack_panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "factory": {
      "name": "buttons",
      "control_ids": { "button": "df_form.gdetail_icon_item" }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length"
      }
    ]
  },
  "marked_gdetail_name": {
    "type": "stack_panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "factory": {
      "name": "buttons",
      "control_ids": { "button": "df_form.gdetail_name_item" }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length"
      }
    ]
  },
  "gdetail_icon_item@df_form.vis_gdetail": {
    "type": "panel",
    "size": [ 44, 44 ],
    "controls": [
      { "bg@df_form.state_image": { "$df_state_texture": "textures/ui/df/slot" } },
      { "icon@df_form.button_icon": { "$df_icon_size": [ 32, 32 ], "anchor_from": "center", "anchor_to": "center" } }
    ]
  },
  "gdetail_name_item@df_form.vis_gdetail": {
    "type": "panel",
    "size": [ "100%", "100%c" ],
    "controls": [
      {
        "text": {
          "type": "label",
          "layer": 3,
          "text": "#df_name",
          "color": [ 0.95, 0.95, 0.97 ],
          "size": [ "100%", "default" ],
          "bindings": [
            {
              "binding_name": "#form_button_text",
              "binding_type": "collection", "binding_condition": "always_when_visible",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_type": "view", "binding_condition": "always_when_visible",
              "source_property_name": "(#form_button_text - '§0§i§r')",
              "target_property_name": "#df_name"
            }
          ]
        }
      }
    ]
  },

  "gslot_wrap_form": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "window@df_form.window": {
          "$df_window_size": [ 300, "80%" ],
          "$df_content": "df_form.gslot_wrap_scroll"
        }
      }
    ]
  },

  "gslot_wrap_scroll@common.scrolling_panel": {
    "anchor_to": "top_left",
    "anchor_from": "top_left",
    "$show_background": false,
    "size": [ "100%", "100%" ],
    "$scrolling_content": "df_form.gslot_wrap_content",
    "$scroll_size": [ 4, "100% - 4px" ],
    "$scrolling_pane_size": [ "100% - 6px", "100%" ],
    "$scrolling_pane_offset": [ 0, 0 ],
    "$scroll_bar_right_padding_size": [ 0, 0 ]
  },

  // The wrapping grid holds 11 slots (24px) per row; the buttons that are
  // not slots (back, actions) come last and leave empty cells.
  "gslot_wrap_content": {
    "type": "stack_panel",
    "size": [ "100% - 6px", "100%c" ],
    "orientation": "vertical",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      { "tabs@df_form.tabs": {} },
      { "tabgap": { "type": "panel", "size": [ "100%", 6 ] } },
      {
        "body": {
          "type": "panel",
          "size": [ "100%", "100%c" ],
          "controls": [ { "label@df_form.body_label": {} } ]
        }
      },
      { "gap": { "type": "panel", "size": [ "100%", 6 ] } },
      {
        "grid_row": {
          "type": "panel",
          "size": [ "100%", "100%c" ],
          "controls": [
            {
              "slots": {
                "type": "grid",
                "size": [ 264, "100%c" ],
                "anchor_from": "top_middle",
                "anchor_to": "top_middle",
                "grid_rescaling_type": "horizontal",
                "grid_item_template": "df_form.gslot_w_item",
                "collection_name": "form_buttons",
                "bindings": [
                  {
                    "binding_name": "#form_button_length",
                    "binding_name_override": "#maximum_grid_items"
                  }
                ]
              }
            }
          ]
        }
      },
      { "gap2": { "type": "panel", "size": [ "100%", 8 ] } },
      {
        "actions@df_form.marked_actions": {
          "orientation": "vertical",
          "size": [ "100%", "100%c" ]
        }
      }
    ]
  },

  // The three slot kinds differ only in the marker they show for.
  "gslot_a_item@df_form.vis_gslot_a": {
    "type": "panel",
    "size": [ 24, 24 ],
    "$df_slot_control|default": "df_form.gslot_button",
    "variables": [ { "requires": "$touch", "$df_slot_control": "df_form.gslot_toggle" } ],
    "controls": [ { "slot@$df_slot_control": {} } ]
  },
  "gslot_b_item@df_form.vis_gslot_b": {
    "type": "panel",
    "size": [ 24, 24 ],
    "$df_slot_control|default": "df_form.gslot_button",
    "variables": [ { "requires": "$touch", "$df_slot_control": "df_form.gslot_toggle" } ],
    "controls": [ { "slot@$df_slot_control": {} } ]
  },
  "gslot_w_item@df_form.vis_gslot_w": {
    "type": "panel",
    "size": [ 24, 24 ],
    "$df_slot_control|default": "df_form.gslot_button",
    "variables": [ { "requires": "$touch", "$df_slot_control": "df_form.gslot_toggle" } ],
    "controls": [ { "slot@$df_slot_control": {} } ]
  },

  // A heading is a small grey text; its button text minus the marker.
  "gslot_h1_item@df_form.vis_gslot_h1": {
    "type": "panel",
    "size": [ "100%", 12 ],
    "controls": [
      {
        "text": {
          "type": "label",
          "layer": 3,
          "text": "#df_head",
          "color": [ 0.62, 0.65, 0.72 ],
          "font_scale_factor": 0.8,
          "size": [ "100%", "default" ],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "bindings": [
            {
              "binding_name": "#form_button_text",
              "binding_type": "collection", "binding_condition": "always_when_visible",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_type": "view", "binding_condition": "always_when_visible",
              "source_property_name": "(#form_button_text - '§0§g§r')",
              "target_property_name": "#df_head"
            }
          ]
        }
      }
    ]
  },
  "gslot_h2_item@df_form.vis_gslot_h2": {
    "type": "panel",
    "size": [ "100%", 12 ],
    "controls": [
      {
        "text": {
          "type": "label",
          "layer": 3,
          "text": "#df_head",
          "color": [ 0.62, 0.65, 0.72 ],
          "font_scale_factor": 0.8,
          "size": [ "100%", "default" ],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "bindings": [
            {
              "binding_name": "#form_button_text",
              "binding_type": "collection", "binding_condition": "always_when_visible",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_type": "view", "binding_condition": "always_when_visible",
              "source_property_name": "(#form_button_text - '§0§h§r')",
              "target_property_name": "#df_head"
            }
          ]
        }
      }
    ]
  },

  // gslot_count is the count at the slot's bottom right: bytes 9 to 19 of
  // the button text without the '~' padding.
  "gslot_count": {
    "type": "label",
    "layer": 4,
    "text": "#df_count",
    "color": [ 1, 1, 1 ],
    "shadow": true,
    "font_scale_factor": 0.75,
    "text_alignment": "right",
    "size": [ "default", "default" ],
    "offset": [ -1, 0 ],
    "anchor_from": "bottom_right",
    "anchor_to": "bottom_right",
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection", "binding_condition": "always_when_visible",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", "binding_condition": "always_when_visible",
        "source_property_name": "((((('%.10s' * (#form_button_text - ('%.10s' * #form_button_text))) - '~~~~~~~~') - '~~~~') - '~~') - '~')",
        "target_property_name": "#df_count"
      }
    ]
  },

  // The tooltip is the text from byte 20 on, in a box above the slot. The
  // pane around the slots clips it, so Go says in byte 10 (the "align"
  // field, 'l' or 'r') which edge of the box sits on the slot: 'l' grows
  // to the right of the slot (slots on the left), 'r' to the left.
  "gslot_tooltip_text": {
    "type": "label",
    "layer": 1,
    "text": "#df_tip",
    "color": [ 0.95, 0.95, 0.97 ],
    "font_scale_factor": 0.8,
    "size": [ "default", "default" ],
    "max_size": [ 150, "default" ],
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection", "binding_condition": "always_when_visible",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", "binding_condition": "always_when_visible",
        "source_property_name": "(#form_button_text - ('%.20s' * #form_button_text))",
        "target_property_name": "#df_tip"
      }
    ]
  },

  "gslot_tooltip_l": {
    "type": "image",
    "texture": "textures/ui/df/panel",
    "layer": 200,
    "size": [ "100%c + 8px", "100%c + 6px" ],
    "offset": [ 0, -2 ],
    "anchor_from": "top_left",
    "anchor_to": "bottom_left",
    "controls": [ { "text@df_form.gslot_tooltip_text": {} } ],
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection", "binding_condition": "always_when_visible",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", "binding_condition": "always_when_visible",
        "source_property_name": "(('%.1s' * (#form_button_text - ('%.9s' * #form_button_text))) = 'l')",
        "target_property_name": "#visible"
      }
    ]
  },

  "gslot_tooltip_r": {
    "type": "image",
    "texture": "textures/ui/df/panel",
    "layer": 200,
    "size": [ "100%c + 8px", "100%c + 6px" ],
    "offset": [ 0, -2 ],
    "anchor_from": "top_right",
    "anchor_to": "bottom_right",
    "controls": [ { "text@df_form.gslot_tooltip_text": {} } ],
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection", "binding_condition": "always_when_visible",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", "binding_condition": "always_when_visible",
        "source_property_name": "(('%.1s' * (#form_button_text - ('%.9s' * #form_button_text))) = 'r')",
        "target_property_name": "#visible"
      }
    ]
  },

  "gslot_face": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "$df_slot_texture|default": "textures/ui/df/slot",
    "controls": [
      { "bg@df_form.state_image": { "$df_state_texture": "$df_slot_texture" } },
      { "icon@df_form.button_icon": { "$df_icon_size": [ 16, 16 ] } },
      { "count@df_form.gslot_count": {} }
