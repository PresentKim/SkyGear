              }
            },
            { "inset": { "type": "image", "texture": "textures/ui/df/tree_inset", "size": [ "100% - 16px", "100% - 31px" ], "offset": [ 8, 23 ], "anchor_from": "top_left", "anchor_to": "top_left", "layer": 3 } },
            {
              "viewport": {
                "type": "panel",
                "size": [ "100% - 18px", "100% - 33px" ],
                "offset": [ 9, 24 ],
                "anchor_from": "top_left",
                "anchor_to": "top_left",
