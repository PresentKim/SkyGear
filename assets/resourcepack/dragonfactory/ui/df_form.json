    "type": "stack_panel",
    "size": [ "100% - 6px", "100%c" ],
    "orientation": "vertical",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      { "tabs@df_form.tabs": {} },
      { "tabgap": { "type": "panel", "size": [ "100%", 6 ] } },
      {
        "body": {
          "type": "panel",
          "size": [ "100%", "100%c" ],
          "controls": [ { "label@df_form.body_label": {} } ]
        }
      },
      { "gap": { "type": "panel", "size": [ "100%", 6 ] } },
      {
        "grid_row": {
          "type": "panel",
          "size": [ "100%", "100%c" ],
