{
  // Dark DragonFactory theme for server forms. Textures: textures/ui/df
  // (generated by tools/uitextures). Button wiring follows the vanilla
  // server_form.dynamic_button contract: the button binds collection_details
  // of "form_buttons" and presses button.form_button_click.
  "namespace": "df_form",


  "title_label": {
    "type": "label",
    "text": "#df_title",
    "color": [ 0.93, 0.66, 0.19 ],
    "shadow": true,
    "size": [ "100% - 30px", "default" ],
    "offset": [ 8, 0 ],
    "anchor_from": "left_middle",
    "anchor_to": "left_middle",
    "layer": 2,
    "bindings": [
      { "binding_name": "#title_text", "binding_type": "global", "binding_condition": "once" },
      {
        "binding_type": "view", "binding_condition": "once",
        "source_property_name": "(#title_text - '§d§f§c§r' - '§d§f§s§r' - '§d§f§t§r' - '§d§f§i§r' - '§d§f§g§r' - '§d§f§h§r' - '§d§f§j§r' - '§d§f§x§r' - '§d§f§y§r' - '§d§f§z§r')",
        "target_property_name": "#df_title"
      }
    ]
  },

  // window draws the panel, the title bar and the close button around
  // $df_content.
  "window": {
    "type": "image",
    "texture": "textures/ui/df/panel",
    "$df_window_size|default": [ 280, "90%" ],
    "size": "$df_window_size",
    "max_size": [ "100% - 8px", "100% - 8px" ],
    "layer": 2,
    "controls": [
      // The inner edge of the panel (light top left, dark bottom right).
      {
        "bevel": {
          "type": "image",
          "texture": "textures/ui/df/panel_bevel",
          "size": [ "100%", "100%" ],
          "layer": 0
        }
      },
      {
        "title_bar": {
          "type": "image",
          "texture": "textures/ui/df/title",
          "size": [ "100% - 4px", 22 ],
          "offset": [ 0, 2 ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "layer": 1,
          "controls": [
            { "title@df_form.title_label": {} },
            {
              // The help button (ui.Help, marked §0§p§r) sits left of the
              // back button.
              "help@df_form.marked_help": {
                "orientation": "horizontal",
                "size": [ "100%c", 20 ],
                "offset": [ -48, 0 ],
                "anchor_from": "right_middle",
                "anchor_to": "right_middle"
              }
            },
            {
              // The back button (ui.Back, marked §0§3§r) sits left of the
              // close button.
              "back@df_form.marked_back": {
                "orientation": "horizontal",
                "size": [ "100%c", 20 ],
                "offset": [ -24, 0 ],
                "anchor_from": "right_middle",
                "anchor_to": "right_middle"
              }
            },
            {
              "close@common.close_button": {
                "$close_button_offset": [ -1, 0 ],
                "anchor_from": "right_middle",
                "anchor_to": "right_middle"
              }
            }
          ]
        }
      },
      {
        "content": {
          "type": "panel",
          "size": [ "100% - 12px", "100% - 32px" ],
          "offset": [ 0, 27 ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "layer": 2,
          "controls": [ { "inner@$df_content": {} } ]
        }
      }
    ]
  },

  "body_label": {
    "type": "label",
    "text": "#form_text",
    "color": [ 0.85, 0.87, 0.9 ],
    "size": [ "100% - 4px", "default" ],
    "offset": [ 2, 0 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left"
  },

  // ---- marked buttons (ui.Tab, ui.Back, table actions) ----
  // Stack panels over all form buttons that show only the buttons of one
  // kind (one control per kind: a factory's control id cannot be a
  // variable): the item template hides the others, and hidden controls take no
  // space in a stack panel. Lists and grids hide every marked button (all
  // markers start with §0§).

  "marked_back": {
    "type": "stack_panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "factory": {
      "name": "buttons",
      "control_ids": { "button": "df_form.back_item" }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length",
        "binding_condition": "visible"
      }
    ]
  },

  "marked_help": {
    "type": "stack_panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "factory": {
      "name": "buttons",
      "control_ids": { "button": "df_form.help_item" }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length",
        "binding_condition": "visible"
      }
    ]
  },

  "marked_tabs": {
    "type": "stack_panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "factory": {
      "name": "buttons",
      "control_ids": { "button": "df_form.tab_item" }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length",
        "binding_condition": "visible"
      }
    ]
  },

  "marked_total": {
    "type": "stack_panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "factory": {
      "name": "buttons",
      "control_ids": { "button": "df_form.total_item" }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length",
        "binding_condition": "visible"
      }
    ]
  },

  "marked_actions": {
    "type": "stack_panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "factory": {
      "name": "buttons",
      "control_ids": { "button": "df_form.action_item" }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length",
        "binding_condition": "visible"
      }
    ]
  },

  // The vis_* templates show their control only for buttons with a marker.
  // The markers are literal in each expression: variables are not
  // substituted inside binding expressions (8th playtest: no tabs shown).
  // vis_back: the back button
  "vis_back": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection", 
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", 
        "source_property_name": "(not ((#form_button_text - '§0§3§r') = #form_button_text))",
        "target_property_name": "#visible"
      }
    ]
  },

  "vis_help": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#form_button_text - '§0§p§r') = #form_button_text))",
        "target_property_name": "#visible"
      }
    ]
  },

  // vis_tab: tabs
  "vis_tab": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection", 
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", 
        "source_property_name": "((not ((#form_button_text - '§0§1§r') = #form_button_text)) or (not ((#form_button_text - '§0§2§r') = #form_button_text)))",
        "target_property_name": "#visible"
      }
    ]
  },

  // vis_tab_on: the selected tab
  "vis_tab_on": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection", 
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", 
        "source_property_name": "(not ((#form_button_text - '§0§2§r') = #form_button_text))",
        "target_property_name": "#visible"
      }
    ]
  },

  // vis_cell: table cells
  "vis_cell": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection", 
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", 
        "source_property_name": "((not ((#form_button_text - '§0§5§r') = #form_button_text)) or (not ((#form_button_text - '§0§6§r') = #form_button_text)))",
        "target_property_name": "#visible"
      }
    ]
  },

  // vis_cell_text: text cells
  "vis_cell_text": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection", 
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", 
        "source_property_name": "(not ((#form_button_text - '§0§5§r') = #form_button_text))",
        "target_property_name": "#visible"
      }
    ]
  },

  // vis_cell_num: number cells
  "vis_cell_num": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection", 
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", 
        "source_property_name": "(not ((#form_button_text - '§0§6§r') = #form_button_text))",
        "target_property_name": "#visible"
      }
    ]
  },

  // vis_total: the table total
  "vis_total": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection", 
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", 
        "source_property_name": "(not ((#form_button_text - '§0§8§r') = #form_button_text))",
        "target_property_name": "#visible"
      }
    ]
  },

  // vis_action: table actions
  "vis_action": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection", 
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", 
        "source_property_name": "(not ((#form_button_text - '§0§4§r') = #form_button_text))",
        "target_property_name": "#visible"
      }
    ]
  },

  // unmarked_visible shows its control only for normal buttons.
  "unmarked_visible": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection", 
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", 
        "source_property_name": "((#form_button_text - '§0§') = #form_button_text)",
        "target_property_name": "#visible"
      }
    ]
  },

  "help_item@df_form.vis_help": {
    "type": "panel",
    "size": [ 22, 20 ],
    "controls": [ { "button@df_form.help_button": {} } ]
  },

  // help_button is the "?" button; hovering (or pressing) it shows the text
  // of the button after the marker as an engine tooltip.
  "help_tip@common.hover_text": {
    "$hover_text_max_width": 0,
    "layer": 200,
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#form_button_text - '§0§p§r')",
        "target_property_name": "#hover_text"
      }
    ]
  },

  "help_mark": {
    "type": "label",
    "text": "?",
    "layer": 3,
    "color": [ 1, 1, 1 ],
    "shadow": true,
    "anchor_from": "center",
    "anchor_to": "center"
  },

  "help_face": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "$df_help_texture|default": "textures/ui/df/button",
    "controls": [
      { "bg@df_form.state_image": { "$df_state_texture": "$df_help_texture" } },
      { "mark@df_form.help_mark": {} }
    ]
  },

  "help_face_tip@df_form.help_face": {
    "controls": [
      { "bg@df_form.state_image": { "$df_state_texture": "$df_help_texture" } },
      { "mark@df_form.help_mark": {} },
      { "tip@df_form.help_tip": {} }
    ]
  },

  "help_button@common.button": {
    "$focus_enabled": false,
    "$pressed_button_name": "button.form_button_click",
    "size": [ 20, 18 ],
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      }
    ],
    "controls": [
      { "default@df_form.help_face": {} },
      { "hover@df_form.help_face_tip": { "$df_help_texture": "textures/ui/df/button_hover" } },
      { "pressed@df_form.help_face_tip": { "$df_help_texture": "textures/ui/df/button_pressed" } }
    ]
  },

  "back_item@df_form.vis_back": {
    "type": "panel",
    "size": [ 22, 20 ],
    "controls": [ { "button@df_form.icon_button": {} } ]
  },

  // icon_button is a small square button showing only the icon.
  "icon_button@common.button": {
    "$focus_enabled": false,
    "$pressed_button_name": "button.form_button_click",
    "size": [ 20, 18 ],
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      }
    ],
    "controls": [
      { "default@df_form.state_image": { "$df_state_texture": "textures/ui/df/button" } },
      { "hover@df_form.state_image": { "$df_state_texture": "textures/ui/df/button_hover" } },
      { "pressed@df_form.state_image": { "$df_state_texture": "textures/ui/df/button_pressed" } },
      { "icon@df_form.button_icon": { "$df_icon_size": [ 12, 12 ] } }
    ]
  },

  // tabs is the strip of tab buttons at the top of the content.
  // The strip is as high as one tab ("100%cm": the largest child; "100%c"
  // added up every tab's height, 9th playtest), and 0 high without tabs.
  "tabs": {
    "type": "panel",
    "size": [ "100%", "100%cm" ],
    "controls": [
      {
        "strip@df_form.marked_tabs": {
          "orientation": "horizontal",
          "size": [ "100%", "100%cm" ]
        }
      }
    ]
  },

  "tab_item@df_form.vis_tab": {
    "type": "panel",
    "size": [ 54, 24 ],
    "controls": [ { "button@df_form.tab_button": {} } ]
  },

  // A tab (textures/ui/df/tab*): dark and low; the pointer lights it; the
  // selected one (§0§2§r) is raised, with an accent bar on top and an
  // accent label. Both labels are bound; one shows.
  "tab_button@common.button": {
    "$focus_enabled": false,
    "$pressed_button_name": "button.form_button_click",
    "size": [ 52, 22 ],
    "anchor_from": "bottom_left",
    "anchor_to": "bottom_left",
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      }
    ],
    "controls": [
      { "default@df_form.state_image": { "$df_state_texture": "textures/ui/df/tab" } },
      { "hover@df_form.state_image": { "$df_state_texture": "textures/ui/df/tab_hover" } },
      { "pressed@df_form.state_image": { "$df_state_texture": "textures/ui/df/tab_hover" } },
      {
        "selected@df_form.vis_tab_on": {
          "type": "image",
          "texture": "textures/ui/df/tab_on",
          "size": [ "100%", "100% + 2px" ],
          "anchor_from": "bottom_left",
          "anchor_to": "bottom_left",
          "layer": 2
        }
      },
      {
        "icon@df_form.button_icon": {
          "$df_icon_size": [ 12, 12 ],
          "offset": [ 3, 0 ],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle"
        }
      },
      {
        "text": {
          "type": "label",
          "layer": 3,
          "text": "#form_button_text",
          "color": [ 0.7, 0.72, 0.78 ],
          "font_scale_factor": 0.8,
          "size": [ "100% - 18px", "default" ],
          "offset": [ 17, 0 ],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "bindings": [
            {
              "binding_name": "#form_button_text",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_type": "view",
              "source_property_name": "((#form_button_text - '§0§2§r') = #form_button_text)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "text_on": {
          "type": "label",
          "layer": 3,
          "text": "#form_button_text",
          "color": [ 1, 0.86, 0.5 ],
          "font_scale_factor": 0.8,
          "size": [ "100% - 18px", "default" ],
          "offset": [ 17, 0 ],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "bindings": [
            {
              "binding_name": "#form_button_text",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#form_button_text - '§0§2§r') = #form_button_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },

  // ---- list (ActionForm, Modal) ----

  "action_form": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      { "window@df_form.window": { "$df_content": "df_form.list_scroll" } }
    ]
  },

  "list_scroll@common.scrolling_panel": {
    "anchor_to": "top_left",
    "anchor_from": "top_left",
    "$show_background": false,
    "size": [ "100%", "100%" ],
    "$scrolling_content": "df_form.list_content",
    "$scroll_size": [ 4, "100% - 4px" ],
    "$scrolling_pane_size": [ "100% - 6px", "100%" ],
    "$scrolling_pane_offset": [ 0, 0 ],
    "$scroll_bar_right_padding_size": [ 0, 0 ]
  },

  "list_content": {
    "type": "stack_panel",
    "size": [ "100% - 6px", "100%c" ],
    "orientation": "vertical",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      { "tabs@df_form.tabs": {} },
      {
        "body": {
          "type": "panel",
          "size": [ "100%", "100%c" ],
          "controls": [ { "label@df_form.body_label": {} } ]
        }
      },
      { "gap": { "type": "panel", "size": [ "100%", 6 ] } },
      { "buttons@df_form.list_buttons": {} }
    ]
  },

  "list_buttons": {
    "type": "stack_panel",
    "size": [ "100%", "100%c" ],
    "orientation": "vertical",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "factory": {
      "name": "buttons",
      "control_ids": {
        "button": "df_form.list_row",
        "label": "@server_form.dynamic_label",
        "header": "@server_form.dynamic_header",
        "divider": "@settings_common.option_group_section_divider"
      }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length",
        "binding_condition": "visible"
      }
    ]
  },

  // list_row is one button with a 2px gap below it.
  "list_row@df_form.unmarked_visible": {
    "type": "panel",
    "size": [ "100%", 32 ],
    "controls": [ { "button@df_form.list_button": {} } ]
  },

  "state_image": {
    "type": "image",
    "size": [ "100%", "100%" ],
    "texture": "$df_state_texture",
    "layer": 1
  },

  // button_icon is a button's icon. A texture path ("textures/...") shows as
  // an image; anything else is an item (ui.ItemIcon: runtime ID * 65536)
  // that the client's item renderer draws like an inventory slot, so items
  // and blocks need no icon texture (same trick as Chest-UI).
  "button_icon": {
    "type": "panel",
    "layer": 3,
    "$df_icon_size|default": [ 20, 20 ],
    "size": "$df_icon_size",
    "controls": [
      { "image@df_form.button_icon_image": {} },
      { "item@df_form.button_icon_item": {} }
    ]
  },

  "button_icon_image": {
    "type": "image",
    "size": [ "100%", "100%" ],
    "bindings": [
      {
        "binding_name": "#form_button_texture",
        "binding_name_override": "#texture",
        "binding_type": "collection", 
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_name": "#form_button_texture_file_system",
        "binding_name_override": "#texture_file_system",
        "binding_type": "collection", 
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", 
        "source_property_name": "(('%.8s' * #texture) = 'textures')",
        "target_property_name": "#visible"
      }
    ]
  },

  "button_icon_item": {
    "type": "custom",
    "renderer": "inventory_item_renderer",
    "size": [ "100%", "100%" ],
    "layer": 1,
    "bindings": [
      {
        "binding_name": "#form_button_texture",
        "binding_type": "collection", 
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", 
        "source_property_name": "(not ((#form_button_texture = '') or (#form_button_texture = 'loading') or (('%.8s' * #form_button_texture) = 'textures')))",
        "target_property_name": "#visible"
      },
      {
        "binding_type": "view", 
        "source_property_name": "(#form_button_texture - (#form_button_texture % 65536))",
        "target_property_name": "#item_id_aux"
      }
    ]
  },

  "list_button@common.button": {
    "$focus_enabled": false,
    "$pressed_button_name": "button.form_button_click",
    "size": [ "100%", 30 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      }
    ],
    "controls": [
      { "default@df_form.state_image": { "$df_state_texture": "textures/ui/df/button" } },
