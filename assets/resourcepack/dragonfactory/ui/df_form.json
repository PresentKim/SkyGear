      { "gap": { "type": "panel", "size": [ "100%", 8 ] } },
      {
        "bottom": {
          "type": "panel",
          "size": [ "100%", "100%cm" ],
          "controls": [
            {
              "left": {
                "type": "stack_panel",
                "orientation": "vertical",
                "size": [ "100%cm", "100%c" ],
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "controls": [
                  { "label@df_form.slot_section_label": { "text": "저장 업그레이드" } },
