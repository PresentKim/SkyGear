    "$scroll_size": [ 6, "100%" ],
    "$scrolling_pane_size": [ "100% - 8px", "100%" ],
    "$scrolling_pane_offset": [ 0, 0 ],
    "$scroll_bar_right_padding_size": [ 0, 0 ]
  },
  "tree_content": {
    "type": "panel",
    "size": [ "100%", 591 ],
    "controls": [
      {
        "grid": {
          "type": "grid",
          "size": [ 352, 567 ],
          "offset": [ 8, 12 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "grid_dimensions": [ 11, 21 ],
          "maximum_grid_items": 231,
          "grid_item_template": "df_form.tree_cell",
          "collection_name": "form_buttons"
        }
      }
    ]
