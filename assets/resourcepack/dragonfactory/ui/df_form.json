        "binding_name": "#form_button_text",
        "binding_type": "collection", 
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", 
        "source_property_name": "(not ((#form_button_text - '§0§c§r') = #form_button_text))",
        "target_property_name": "#visible"
      }
    ]
  },
  "marked_slot_store": {
    "type": "stack_panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "factory": {
      "name": "buttons",
      "control_ids": { "button": "df_form.slot_store_item" }
