    "anchor_to": "right_middle",
    "size": [
      "100%c + 8px",
      "100%c + 6px"
    ],
    "controls": [
      {
        "rows": {
          "type": "stack_panel",
          "orientation": "vertical",
          "size": [
            "100%cm",
            "100%c"
          ],
          "anchor_from": "center",
          "anchor_to": "center",
          "controls": [
            {
              "objective": {
                "type": "label",
                "layer": 2,
                "localize": false,
                "size": [
                  "default",
                  10
                ],
                "text": "#objective_sidebar_name",
                "bindings": [
                  {
