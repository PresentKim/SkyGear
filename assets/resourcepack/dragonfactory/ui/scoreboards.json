{
  "namespace": "scoreboard",
  "scoreboard_sidebar": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "anchor_from": "center",
    "anchor_to": "center",
    "controls": [
      {
        // The lobby's launcher frame (ui/df_lobby.json, hud.FrameTitle).
        "lobby_frame@df_lobby.frame": {
          "bindings": [
            {
              "binding_name": "#objective_sidebar_name",
              "binding_type": "global"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#objective_sidebar_name - '§d§l§b') = #objective_sidebar_name))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "df_plain@scoreboard.df_plain_sidebar": {
          "bindings": [
            {
              "binding_name": "#objective_sidebar_name",
              "binding_type": "global"
            },
            {
              "binding_type": "view",
              "source_property_name": "((#objective_sidebar_name - '§d§h§u§d') = #objective_sidebar_name)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "df_hud@scoreboard.df_hud": {
          "bindings": [
            {
              "binding_name": "#objective_sidebar_name",
              "binding_type": "global"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#objective_sidebar_name - '§d§h§u§d') = #objective_sidebar_name))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },
  "df_hud": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "controls": [
      {
        "top_left@scoreboard.df_top_left_stack": {
          "offset": [
            4,
            4
          ]
        }
      },
      {
        "top_right@scoreboard.df_top_right_stack": {
          "offset": [
            -4,
            4
          ]
        }
      },
      {
        "quest@scoreboard.df_quest": {
          "offset": [
            -4,
            -10
          ],
          // The lobby has no quest: no empty panel at the right edge.
          "bindings": [
            {
              "binding_name": "#objective_sidebar_name",
              "binding_type": "global"
            },
            {
              "binding_type": "view",
              "source_property_name": "((#objective_sidebar_name - '§d§l§b') = #objective_sidebar_name)",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },
  "df_top_left_stack": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [
      "100%cm",
      "100%c"
    ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "use_child_anchors": true,
    "collection_name": "scoreboard_players",
    "factory": {
      "name": "player_list_factory",
      "control_name": "scoreboard.df_row_top_left"
    },
    "bindings": [
      {
        "binding_name": "#scoreboard_sidebar_size",
        "binding_type": "global",
        "binding_name_override": "#collection_length"
      }
    ]
  },
  "df_top_right_stack": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [
      "100%cm",
      "100%c"
    ],
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "use_child_anchors": true,
    "collection_name": "scoreboard_players",
    "factory": {
      "name": "player_list_factory",
      "control_name": "scoreboard.df_row_top_right"
    },
    "bindings": [
      {
        "binding_name": "#scoreboard_sidebar_size",
        "binding_type": "global",
        "binding_name_override": "#collection_length"
      }
    ]
  },
  "df_row_top_left": {
    "type": "label",
    "layer": 2,
    "localize": false,
    "locked_alpha": 1.0,
    "size": [
      "default",
      10
    ],
    "max_size": [
      260,
      10
    ],
    "text": "#text",
    "text_alignment": "left",
    "shadow": true,
    "bindings": [
      {
        "binding_name": "#player_name_sidebar",
        "binding_type": "collection",
        "binding_collection_name": "scoreboard_players"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#player_name_sidebar - '§d§1')",
        "target_property_name": "#text"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#player_name_sidebar - '§d§1') = #player_name_sidebar))",
        "target_property_name": "#visible"
      }
    ],
    "anchor_from": "top_left",
    "anchor_to": "top_left"
  },
  "df_row_top_right": {
    "type": "label",
    "layer": 2,
    "localize": false,
    "locked_alpha": 1.0,
    "size": [
      "default",
