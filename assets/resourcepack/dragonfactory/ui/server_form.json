{
  // Overrides the vanilla server form roots with the dark DragonFactory theme
  // (ui/df_form.json). Title tokens choose the layout (Go: internal/ui):
  // §d§f§g§r (ui.GridToken) a fixed 9×6 icon grid, §d§f§c§r (ui.CardToken)
  // a grid of icon-and-text cards, none a list.
  "namespace": "server_form",

  // The vanilla screen content is a 0×0 panel whose forms have fixed sizes.
  // Make it fill the screen so the theme can size and dim relative to it.
  "main_screen_content": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "server_form_factory": {
          "type": "factory",
          "control_ids": {
            "long_form": "@server_form.long_form",
            "custom_form": "@server_form.custom_form"
          }
        }
      }
    ]
  },

  "long_form": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "list@df_form.action_form": {
          "bindings": [
            { "binding_name": "#title_text", "binding_type": "global" },
            {
              "binding_type": "view",
              "source_property_name": "(((#title_text - '§d§f§g§r') - '§d§f§c§r') = #title_text)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "cards@df_form.card_form": {
          "bindings": [
            { "binding_name": "#title_text", "binding_type": "global" },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - '§d§f§c§r') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "grid@df_form.grid_form": {
          "bindings": [
            { "binding_name": "#title_text", "binding_type": "global" },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#title_text - '§d§f§g§r') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },

  "custom_form": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [ { "custom@df_form.custom_form": {} } ]
  }
}
