{
  // Overrides the vanilla server form roots with the dark DragonFactory theme
  // (ui/df_form.json). A title starting with §d§f§c§r (Go: ui.CardToken)
  // shows the buttons as a grid of icon-and-text cards, §d§f§s§r
  // (ui.ShopToken) as a compact grid, §d§f§t§r (ui.TableToken) as a table,
  // §d§f§i§r (ui.SlotToken) as inventory-like slots, §d§f§g§r / §d§f§h§r
  // (ui.DetailToken, ui.WrapToken) as item slots with counts and tooltips,
  // §d§f§j§r (ui.ColumnsToken) as two columns of them, §d§f§y§r (ui.SplitToken)
  // as a grid with the detail of the chosen slot beside it, §d§f§l§r
  // (ui.ListSplitToken) as a list with the detail of the chosen row beside it,
  // §d§f§z§r (ui.TreeToken) as the advancement tree, otherwise a list. A title with
  // §d§f§n§r (ui.NoAnimToken) shows the window at once; the others slide it up.
  "namespace": "server_form",

  // The vanilla screen content is a 0×0 panel whose forms have fixed sizes.
  // Make it fill the screen so the theme can size and dim relative to it.
  "main_screen_content": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "server_form_factory": {
          "type": "factory",
          "control_ids": {
            "long_form": "@server_form.long_form",
            "custom_form": "@server_form.custom_form"
          }
        }
      }
    ]
  },

  "long_form": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "list@df_form.action_form": {
          "visible": false,
          "bindings": [
            { "binding_name": "#title_text", "binding_type": "global", "binding_condition": "once" },
            {
              "binding_type": "view", "binding_condition": "once",
              "source_property_name": "((((#title_text - '§d§f§c§r') = #title_text) and ((#title_text - '§d§f§s§r') = #title_text) and ((#title_text - '§d§f§t§r') = #title_text) and ((#title_text - '§d§f§i§r') = #title_text) and ((#title_text - '§d§f§g§r') = #title_text) and ((#title_text - '§d§f§j§r') = #title_text) and ((#title_text - '§d§f§y§r') = #title_text) and ((#title_text - '§d§f§l§r') = #title_text) and ((#title_text - '§d§f§z§r') = #title_text) and ((#title_text - '§d§f§x§r') = #title_text) and ((#title_text - '§d§f§h§r') = #title_text)) and ((#title_text - '§d§f§n§r') = #title_text))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "list_s@df_form.action_form": {
          "visible": false,
          "$df_anims": [], "$df_anims_tree": [],
          "bindings": [
            { "binding_name": "#title_text", "binding_type": "global", "binding_condition": "once" },
            {
              "binding_type": "view", "binding_condition": "once",
              "source_property_name": "((((#title_text - '§d§f§c§r') = #title_text) and ((#title_text - '§d§f§s§r') = #title_text) and ((#title_text - '§d§f§t§r') = #title_text) and ((#title_text - '§d§f§i§r') = #title_text) and ((#title_text - '§d§f§g§r') = #title_text) and ((#title_text - '§d§f§j§r') = #title_text) and ((#title_text - '§d§f§y§r') = #title_text) and ((#title_text - '§d§f§l§r') = #title_text) and ((#title_text - '§d§f§z§r') = #title_text) and ((#title_text - '§d§f§x§r') = #title_text) and ((#title_text - '§d§f§h§r') = #title_text)) and (not ((#title_text - '§d§f§n§r') = #title_text)))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "cards@df_form.card_form": {
          "visible": false,
          "bindings": [
            { "binding_name": "#title_text", "binding_type": "global", "binding_condition": "once" },
