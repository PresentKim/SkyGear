// The lobby's launcher frame (docs/design/01-platform.md §1): a dark title
// bar with the game's name and a band at the bottom over the whole screen,
// the lobby island showing between them. It fills the dfui theme's
// lobby_frame hook (ui/dfui_hooks.json), which the theme draws in the HUD
// (sidebar objective with §d§l§b, hud.FrameTitle) and, as the HUD is hidden
// while a form is open, behind lobby forms (title marker §d§f§w§r,
// ui.LobbyToken): it is on screen with a form open or closed. Lobby forms do
// not darken the screen.
{
  "namespace": "df_lobby",
  "frame": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "top": {
          "type": "image",
          "texture": "textures/ui/Black",
          "alpha": 0.6,
          "size": [ "100%", 34 ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "controls": [
            {
              "title": {
                "type": "label",
                "layer": 1,
                "text": "df.lobby.title",
                "font_type": "MinecraftTen",
                "font_scale_factor": 1.6,
                "color": [ 1, 1, 1 ],
                "shadow": true,
                "anchor_from": "center",
                "anchor_to": "center"
              }
            }
          ]
        }
      },
      {
        "top_line": {
          "type": "image",
          "texture": "textures/ui/white",
          "color": [ 0.95, 0.7, 0.2 ],
          "size": [ "100%", 1 ],
          "offset": [ 0, 34 ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle"
        }
      },
      {
        "bottom": {
          "type": "image",
          "texture": "textures/ui/Black",
          "alpha": 0.6,
          "size": [ "100%", 16 ],
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle"
        }
      },
      {
        "bottom_line": {
          "type": "image",
          "texture": "textures/ui/white",
          "color": [ 0.95, 0.7, 0.2 ],
          "size": [ "100%", 1 ],
          "offset": [ 0, -16 ],
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle"
        }
      }
    ]
  }
}
