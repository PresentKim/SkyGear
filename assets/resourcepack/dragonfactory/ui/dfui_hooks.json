// Fills the hooks of the common dfui theme (its ui/dfui_hooks.json); this
// pack is loaded above dfui, so these definitions win.
{
  "namespace": "dfui_hooks",

  // The lobby's launcher frame (ui/df_lobby.json).
  "lobby_frame": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [ { "frame@df_lobby.frame": {} } ]
  },

  // The lobby's main menu as pictures (ui/df_lobby.json).
  "lobby_menu": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [ { "menu@df_lobby.menu": {} } ]
  }
}
