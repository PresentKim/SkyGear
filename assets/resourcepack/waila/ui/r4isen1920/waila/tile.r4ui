{
	/* r4isen1920によって作成されました | MITライセンス */

	"namespace": "r4isen1920_waila_tile",

	//* dragonfactory change: the server (Go, no Script API) sends the looked-at
	//* item's runtime ID × 65536 in the subtitle, after an "i" so the pack
	//* still reads the subtitle as text (a bare number broke the block state
	//* check: a grey box and "expected a string"), in 11 characters left
	//* padded with 'x'. It is read from the subtitle *variable* the title
	//* factory gives ($var_subtitle_text, like all the panel's text) into the
	//* property bag, as older WAILA versions read the title; binding
	//* expressions on #hud_subtitle_text_string never gave an item (11th
	//* playtest). This replaces the script's inventory slot mirror. *//
	"df_subtitle_item_renderer": {
		"type": "custom",
		"renderer": "inventory_item_renderer",
		"layer": "($layer + 1)",
		"$df_aux": "((((('%.11s' * ($var_subtitle_text - ('%.1s' * $var_subtitle_text))) - 'xxxxxxxx') - 'xxxx') - 'xx') - 'x')",
		"property_bag": {
			"#item_id_aux": "$df_aux"
		}
	},

	//! Deprecated in favor of "item_aux_inv_renderer" !//
	"item_aux_renderer": {
		"type": "custom",
		"renderer": "inventory_item_renderer",

		"layer": "($layer + 1)",

		"property_bag": {
			"#item_id_aux": "$item_aux"
		}
	},

	//* Author: NguyenDuck (https://github.com/NguyenDuck) *//
	"item_aux_inv_renderer@common.empty_panel": {
		"$collection_index": 17,
		"$show_item_count": false,

		"controls": [
			{
				"inv": {
					"type": "custom",
					"renderer": "inventory_item_renderer",

					"anchor_from": "top_left",
					"anchor_to": "top_left",
					"size": ["100%", "100%"],
					"layer": "($layer + 1)",

					"controls": [
						{
							"stack": {
								"type": "stack_panel",
								"size": [0, 0],

								"$slot_name": "slot",
								"$collection_name": "hotbar_items",
								"collection_name": "$collection_name",

								"controls": [
									{
										"$slot_name@common.empty_panel": {
											"collection_index": "$collection_index",
											"bindings": [
												{
													"binding_type": "collection",
													"binding_name": "#item_id_aux",
													"binding_collection_name": "$collection_name",
													"binding_condition": "visibility_changed"
												},
												{
													"binding_type": "collection",
													"binding_name": "#inventory_stack_count",
													"binding_collection_name": "$collection_name",
													"binding_condition": "visibility_changed"
												}
											]
										}
									}
								],
								"bindings": [
									{
										"binding_type": "view",
										"source_control_name": "$slot_name",
										"resolve_sibling_scope": true,
										"source_property_name": "#item_id_aux",
										"target_property_name": "#item_id_aux"
									},
									{
										"binding_type": "view",
										"source_control_name": "$slot_name",
										"resolve_sibling_scope": true,
										"source_property_name": "#inventory_stack_count",
										"target_property_name": "#inventory_stack_count"
									}
								]
							}
						},

						{
							"item_amount@r4isen1920_waila_common.label": {
								"anchor_from": "bottom_right",
								"anchor_to": "bottom_right",
								"offset": [0, 1],

								"text": "#text",
								"font_scale_factor": 0.75,
								"shadow": true,

								"ignored": "(not $show_item_count)",

								"bindings": [
									{
										"binding_type": "view",
										"source_control_name": "stack",
										"resolve_sibling_scope": true,
										"source_property_name": "#inventory_stack_count",
										"target_property_name": "#text"
									}
								]
							}
						}
					],
					"bindings": [
						{
							"binding_type": "view",
							"source_control_name": "stack",
							"resolve_sibling_scope": true,
							"source_property_name": "#item_id_aux",
							"target_property_name": "#item_id_aux"
						}
					]
				}
			}
		]
	},

	//* dragonfactory change: container slots come from the subtitle the server
	//* sends ("i", the 11-character icon field, per slot 11 characters of
	//* item and 4 of count, then "e"; docs/tech/waila.md) instead of player
	//* inventory slots the script filled, read from $var_subtitle_text like
	//* the icon. The count's expression is in the label's own variables
	//* (like the name label's $text). Generated; internal/waila
	//* TestPackFields checks it. *//
	"item_inventory": {
		"type": "panel",
		"$index|default": 0,
		"$df_aux|default": "0",
		"size": [
			14,
			14
		],
		"variables": [
			{
				"requires": "($index = 0)",
				"$df_aux": "((((('%.11s' * ($var_subtitle_text - ('%.12s' * $var_subtitle_text))) - 'xxxxxxxx') - 'xxxx') - 'xx') - 'x')"
			},
			{
				"requires": "($index = 1)",
				"$df_aux": "((((('%.11s' * ($var_subtitle_text - ('%.27s' * $var_subtitle_text))) - 'xxxxxxxx') - 'xxxx') - 'xx') - 'x')"
			},
			{
				"requires": "($index = 2)",
				"$df_aux": "((((('%.11s' * ($var_subtitle_text - ('%.42s' * $var_subtitle_text))) - 'xxxxxxxx') - 'xxxx') - 'xx') - 'x')"
			},
			{
				"requires": "($index = 3)",
				"$df_aux": "((((('%.11s' * ($var_subtitle_text - ('%.57s' * $var_subtitle_text))) - 'xxxxxxxx') - 'xxxx') - 'xx') - 'x')"
			},
			{
				"requires": "($index = 4)",
				"$df_aux": "((((('%.11s' * ($var_subtitle_text - ('%.72s' * $var_subtitle_text))) - 'xxxxxxxx') - 'xxxx') - 'xx') - 'x')"
			},
			{
				"requires": "($index = 5)",
				"$df_aux": "((((('%.11s' * ($var_subtitle_text - ('%.87s' * $var_subtitle_text))) - 'xxxxxxxx') - 'xxxx') - 'xx') - 'x')"
			},
			{
				"requires": "($index = 6)",
				"$df_aux": "((((('%.11s' * ($var_subtitle_text - ('%.102s' * $var_subtitle_text))) - 'xxxxxxxx') - 'xxxx') - 'xx') - 'x')"
			},
			{
				"requires": "($index = 7)",
				"$df_aux": "((((('%.11s' * ($var_subtitle_text - ('%.117s' * $var_subtitle_text))) - 'xxxxxxxx') - 'xxxx') - 'xx') - 'x')"
			},
			{
				"requires": "($index = 8)",
				"$df_aux": "((((('%.11s' * ($var_subtitle_text - ('%.132s' * $var_subtitle_text))) - 'xxxxxxxx') - 'xxxx') - 'xx') - 'x')"
			},
			{
				"requires": "($index = 9)",
				"$df_aux": "((((('%.11s' * ($var_subtitle_text - ('%.147s' * $var_subtitle_text))) - 'xxxxxxxx') - 'xxxx') - 'xx') - 'x')"
			},
			{
				"requires": "($index = 10)",
				"$df_aux": "((((('%.11s' * ($var_subtitle_text - ('%.162s' * $var_subtitle_text))) - 'xxxxxxxx') - 'xxxx') - 'xx') - 'x')"
			},
			{
				"requires": "($index = 11)",
				"$df_aux": "((((('%.11s' * ($var_subtitle_text - ('%.177s' * $var_subtitle_text))) - 'xxxxxxxx') - 'xxxx') - 'xx') - 'x')"
			},
			{
				"requires": "($index = 12)",
				"$df_aux": "((((('%.11s' * ($var_subtitle_text - ('%.192s' * $var_subtitle_text))) - 'xxxxxxxx') - 'xxxx') - 'xx') - 'x')"
			},
			{
				"requires": "($index = 13)",
				"$df_aux": "((((('%.11s' * ($var_subtitle_text - ('%.207s' * $var_subtitle_text))) - 'xxxxxxxx') - 'xxxx') - 'xx') - 'x')"
			},
			{
				"requires": "($index = 14)",
				"$df_aux": "((((('%.11s' * ($var_subtitle_text - ('%.222s' * $var_subtitle_text))) - 'xxxxxxxx') - 'xxxx') - 'xx') - 'x')"
			},
			{
				"requires": "($index = 15)",
				"$df_aux": "((((('%.11s' * ($var_subtitle_text - ('%.237s' * $var_subtitle_text))) - 'xxxxxxxx') - 'xxxx') - 'xx') - 'x')"
			},
			{
				"requires": "($index = 16)",
				"$df_aux": "((((('%.11s' * ($var_subtitle_text - ('%.252s' * $var_subtitle_text))) - 'xxxxxxxx') - 'xxxx') - 'xx') - 'x')"
			},
			{
				"requires": "($index = 17)",
				"$df_aux": "((((('%.11s' * ($var_subtitle_text - ('%.267s' * $var_subtitle_text))) - 'xxxxxxxx') - 'xxxx') - 'xx') - 'x')"
			}
		],
		"controls": [
			{
				"item": {
					"type": "custom",
					"renderer": "inventory_item_renderer",
					"size": [
						"100%",
						"100%"
					],
					"layer": "($layer + 1)",
					"property_bag": {
						"#item_id_aux": "$df_aux"
					}
				}
			},
			{
				"count@r4isen1920_waila_common.label": {
					"anchor_from": "bottom_right",
					"anchor_to": "bottom_right",
					"offset": [
						1,
						1
					],
					"font_scale_factor": 0.75,
					"text_alignment": "right",
					"shadow": true,
					"layer": "($layer + 2)",
					"$df_count|default": "",
					"variables": [
						{
							"requires": "($index = 0)",
							"$df_count": "('§r' + ('%.4s' * ($var_subtitle_text - ('%.23s' * $var_subtitle_text))))"
						},
						{
							"requires": "($index = 1)",
							"$df_count": "('§r' + ('%.4s' * ($var_subtitle_text - ('%.38s' * $var_subtitle_text))))"
						},
						{
							"requires": "($index = 2)",
							"$df_count": "('§r' + ('%.4s' * ($var_subtitle_text - ('%.53s' * $var_subtitle_text))))"
						},
						{
							"requires": "($index = 3)",
							"$df_count": "('§r' + ('%.4s' * ($var_subtitle_text - ('%.68s' * $var_subtitle_text))))"
						},
						{
							"requires": "($index = 4)",
							"$df_count": "('§r' + ('%.4s' * ($var_subtitle_text - ('%.83s' * $var_subtitle_text))))"
						},
						{
							"requires": "($index = 5)",
							"$df_count": "('§r' + ('%.4s' * ($var_subtitle_text - ('%.98s' * $var_subtitle_text))))"
						},
						{
							"requires": "($index = 6)",
							"$df_count": "('§r' + ('%.4s' * ($var_subtitle_text - ('%.113s' * $var_subtitle_text))))"
						},
						{
							"requires": "($index = 7)",
							"$df_count": "('§r' + ('%.4s' * ($var_subtitle_text - ('%.128s' * $var_subtitle_text))))"
						},
						{
							"requires": "($index = 8)",
							"$df_count": "('§r' + ('%.4s' * ($var_subtitle_text - ('%.143s' * $var_subtitle_text))))"
						},
						{
							"requires": "($index = 9)",
							"$df_count": "('§r' + ('%.4s' * ($var_subtitle_text - ('%.158s' * $var_subtitle_text))))"
						},
						{
							"requires": "($index = 10)",
							"$df_count": "('§r' + ('%.4s' * ($var_subtitle_text - ('%.173s' * $var_subtitle_text))))"
						},
						{
							"requires": "($index = 11)",
							"$df_count": "('§r' + ('%.4s' * ($var_subtitle_text - ('%.188s' * $var_subtitle_text))))"
						},
						{
							"requires": "($index = 12)",
							"$df_count": "('§r' + ('%.4s' * ($var_subtitle_text - ('%.203s' * $var_subtitle_text))))"
						},
						{
							"requires": "($index = 13)",
							"$df_count": "('§r' + ('%.4s' * ($var_subtitle_text - ('%.218s' * $var_subtitle_text))))"
						},
						{
							"requires": "($index = 14)",
							"$df_count": "('§r' + ('%.4s' * ($var_subtitle_text - ('%.233s' * $var_subtitle_text))))"
						},
						{
							"requires": "($index = 15)",
							"$df_count": "('§r' + ('%.4s' * ($var_subtitle_text - ('%.248s' * $var_subtitle_text))))"
						},
						{
							"requires": "($index = 16)",
							"$df_count": "('§r' + ('%.4s' * ($var_subtitle_text - ('%.263s' * $var_subtitle_text))))"
						},
						{
							"requires": "($index = 17)",
							"$df_count": "('§r' + ('%.4s' * ($var_subtitle_text - ('%.278s' * $var_subtitle_text))))"
						}
					],
					"text": "$df_count"
				}
			}
		]
	},

	//* dragonfactory change: small marks after the name (a drawer's lock and
	//* upgrades) and a line with an item icon ("참나무 원목 [icon] x 132/1,024"),
	//* read from the subtitle tail (internal/waila tail.go; TestTail checks
	//* the places). Expressions are whole in each property: a variable
	//* from a variables block used inside another expression stays text. *//
	"df_marks": {
		"type": "stack_panel",
		"orientation": "horizontal",
		"size": [
			"100%c",
			10
		],
		"controls": [
			{
				"lock@r4isen1920_waila_common.label": {
					"text": "$df_lock",
					"font_scale_factor": 0.6,
					"offset": [
						1,
						2
					],
					"$df_lock|default": "",
					"variables": [
						{
							"requires": "(('%.1s' * ($var_subtitle_text - ('%.293s' * $var_subtitle_text))) = 'L')",
							"$df_lock": "§e"
						}
					]
				}
			},
			{
				"multiplier@r4isen1920_waila_common.label": {
					"text": "$df_mult",
					"font_scale_factor": 0.6,
					"offset": [
						1,
						2
					],
					"$df_mult|default": "",
					"variables": [
						{
							"requires": "(('%.1s' * ($var_subtitle_text - ('%.294s' * $var_subtitle_text))) = 'b')",
							"$df_mult": "§b×2"
						},
						{
							"requires": "(('%.1s' * ($var_subtitle_text - ('%.294s' * $var_subtitle_text))) = 'c')",
							"$df_mult": "§b×4"
						},
						{
							"requires": "(('%.1s' * ($var_subtitle_text - ('%.294s' * $var_subtitle_text))) = 'd')",
							"$df_mult": "§b×8"
						}
					]
				}
			},
			{
				"void@r4isen1920_waila_common.label": {
					"text": "$df_void",
					"font_scale_factor": 0.6,
					"offset": [
						1,
						2
					],
					"$df_void|default": "",
					"variables": [
						{
							"requires": "(('%.1s' * ($var_subtitle_text - ('%.295s' * $var_subtitle_text))) = 'V')",
							"$df_void": "§f"
						}
					]
				}
			}
		]
	},

	"df_item_line": {
		"type": "stack_panel",
		"orientation": "horizontal",
		"size": [
			"100%c",
			10
		],
		"controls": [
			{
				"name@r4isen1920_waila_common.label": {
					"color": [
						0.75,
						0.75,
						0.75
					],
					"text": "($var_subtitle_text - ('%.321s' * $var_subtitle_text))"
				}
			},
			{
				"icon": {
					"type": "custom",
					"renderer": "inventory_item_renderer",
					"size": [
						9,
						9
					],
					"offset": [
						1,
						-1
					],
					"layer": "($layer + 1)",
					"$df_aux": "((((('%.11s' * ($var_subtitle_text - ('%.282s' * $var_subtitle_text))) - 'xxxxxxxx') - 'xxxx') - 'xx') - 'x')",
					"property_bag": {
						"#item_id_aux": "$df_aux"
					}
				}
			},
			{
				"text@r4isen1920_waila_common.label": {
					"offset": [
						2,
						0
					],
					"text": "(((((('%.24s' * ($var_subtitle_text - ('%.297s' * $var_subtitle_text))) - '~~~~~~~~~~~~~~~~') - '~~~~~~~~') - '~~~~') - '~~') - '~')"
				}
			},
			{
				"gauge@r4isen1920_waila_common.label": {
					"offset": [
						2,
						0
					],
					"text": "$df_gauge",
					"$df_gauge|default": "",
					"variables": [
						{
							"requires": "(('%.1s' * ($var_subtitle_text - ('%.296s' * $var_subtitle_text))) = 'a')",
							"$df_gauge": ""
						},
						{
							"requires": "(('%.1s' * ($var_subtitle_text - ('%.296s' * $var_subtitle_text))) = 'b')",
							"$df_gauge": ""
						},
						{
							"requires": "(('%.1s' * ($var_subtitle_text - ('%.296s' * $var_subtitle_text))) = 'c')",
							"$df_gauge": ""
						},
						{
							"requires": "(('%.1s' * ($var_subtitle_text - ('%.296s' * $var_subtitle_text))) = 'd')",
							"$df_gauge": ""
						},
						{
							"requires": "(('%.1s' * ($var_subtitle_text - ('%.296s' * $var_subtitle_text))) = 'e')",
							"$df_gauge": ""
						},
						{
							"requires": "(('%.1s' * ($var_subtitle_text - ('%.296s' * $var_subtitle_text))) = 'f')",
							"$df_gauge": ""
						},
						{
							"requires": "(('%.1s' * ($var_subtitle_text - ('%.296s' * $var_subtitle_text))) = 'g')",
							"$df_gauge": ""
						},
						{
							"requires": "(('%.1s' * ($var_subtitle_text - ('%.296s' * $var_subtitle_text))) = 'h')",
							"$df_gauge": ""
						},
						{
							"requires": "(('%.1s' * ($var_subtitle_text - ('%.296s' * $var_subtitle_text))) = 'i')",
							"$df_gauge": ""
						},
						{
							"requires": "(('%.1s' * ($var_subtitle_text - ('%.296s' * $var_subtitle_text))) = 'j')",
							"$df_gauge": ""
						},
						{
							"requires": "(('%.1s' * ($var_subtitle_text - ('%.296s' * $var_subtitle_text))) = 'k')",
							"$df_gauge": ""
						}
					]
				}
			}
		]
	},

	"furnace_inventory": {
		"type": "stack_panel",
		"orientation": "horizontal",

		"size": ["100%c", 14],

		"controls": [
			{
				"input@r4isen1920_waila_tile.item_inventory": {
					"$index": 0
				}
			},
			{
				"fuel@r4isen1920_waila_tile.item_inventory": {
					"$index": 1
				}
			},
			{
				"arrow_centerer@common.empty_panel": {
					"size": [21, "100%"], // 15px + 6px (padding)
					"controls": [
						{
							"arrow@r4isen1920_waila_common.image": {
								"size": [15, 10],
								"texture": "textures/r4isen1920/waila/arrow"
							}
						}
					]
				}
			},
			{
				"output@r4isen1920_waila_tile.item_inventory": {
					"$index": 2
				}
			}
		]
	},

	"brewing_stand_inventory": {
		"type": "stack_panel",
		"orientation": "horizontal",

		"size": ["100%c", 30],

		"controls": [
			{
				"inputs": {
					"type": "stack_panel",
					"orientation": "vertical",

					"size": [14, "100%"],

					"controls": [
						{
							"reagent@r4isen1920_waila_tile.item_inventory": {
								"$index": 0
							}
						},
						{ "padding@common.empty_panel": { "size": [14, 2] } },
						{
							"blaze_powder@r4isen1920_waila_tile.item_inventory": {
								"$index": 4
							}
						}
					]
				}
			},
			{
				"bubbles_centerer@common.empty_panel": {
					"size": [18, "100%"], // 12px + 6px (padding)
					"controls": [
						{
							"bubbles@r4isen1920_waila_common.image": {
								"size": [12, 30],
								"texture": "textures/r4isen1920/waila/bubbles"
							}
						}
					]
				}
			},
			{
				"potion_1_and_3": {
					"type": "stack_panel",
					"orientation": "vertical",

					"size": [14, "100%"],

					"controls": [
						{
							"potion_1@r4isen1920_waila_tile.item_inventory": {
								"$index": 1
							}
						},
						{ "padding@common.empty_panel": { "size": [14, 2] } },
						{
							"potion_3@r4isen1920_waila_tile.item_inventory": {
								"$index": 3
							}
						}
					]
				}
			},
			{
				"potion_2_centerer@common.empty_panel": {
					"size": [14, "100%"],

					"controls": [
						{
							"potion_2@r4isen1920_waila_tile.item_inventory": {
								"$index": 2
							}
						}
					]
				}
			}
		]
	},

	"generic_container_inventory_item@common.empty_panel": {
		"size": ["100%c - 1px", "100%c - 1px"],

		"$border_type|default": "center",

		"controls": [
			{
				// dragonfactory change: no grey slot borders (the slots show the kinds
				// of items, not the real layout; 11th playtest). Same size.
				"border": {
					"type": "panel",
					"size": ["100%c + 4px", "100%c + 4px"],

					"variables": {
						"requires": "true",
						"$index": "$a_index"
					},

					"controls": [
						{
							"item@r4isen1920_waila_tile.item_inventory": {
							}
						}
					]
				}
			}
		]
	},
	"generic_container_inventory_row": {
		"type": "stack_panel",
		"orientation": "horizontal",
		"size": ["100%c", "100%cm"]
	},

