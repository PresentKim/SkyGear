{

	"namespace": "waila_common",

	"label": {
		"type": "label",

		"size": ["default", "default"],
		"font_scale_factor": 1.0,
		"localize": false,
		"shadow": true,
		"enable_profanity_filter": false,

		"layer": "($layer + 1)"
	},

	"image": {
		"type": "image",

		"force_texture_reload": true,
		"allow_debug_missing_texture": false,

		"layer": "($layer + 1)"
	},

	"icon_renderer@common.empty_panel": {
		// this panel just re-centers the image
		"size": ["100%c - 0.5px", "100%c - 0.5px"],

		"controls": [
			{
				"icon@image": {
					// a-c: empty, half, full heart; d-f: empty, half, full armour; x-z: none
					"$texture_path|default": "",
					"variables": [
						{ "requires": "($texture = 'a')", "$texture_path": "textures/ui/heart_background" },
						{ "requires": "($texture = 'b')", "$texture_path": "textures/ui/heart_half" },
						{ "requires": "($texture = 'c')", "$texture_path": "textures/ui/heart_new" },
						{ "requires": "($texture = 'd')", "$texture_path": "textures/ui/armor_empty" },
						{ "requires": "($texture = 'e')", "$texture_path": "textures/ui/armor_half" },
						{ "requires": "($texture = 'f')", "$texture_path": "textures/ui/armor_full" }
					],
					"texture": "$texture_path",
					"ignored": "(($texture = 'x') or ($texture = 'y') or ($texture = 'z'))",

					"size": [9, 9],
					"uv_size": [9, 9],

					"layer": 101
				}
			}
		]
	}
}
