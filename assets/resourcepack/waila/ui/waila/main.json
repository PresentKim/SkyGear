{

	"namespace": "waila_main",

	"main@common.empty_panel": {
		"size": ["100%cm", "100%cm"],

		/* 他のすべての上に設定 */
		"$layer": 1,
		"layer": "$layer",

		"$var_title_text": "($var_title_text1 - '__waila:anchor.top_middle__')",		

		"controls": [
			{
				"bg": {
					"type": "image",
					"texture": "textures/ui/purpleBorder",

					"keep_ratio": false,
					"bilinear": false,
					"alpha": 0.75,

					"size": ["100%c + 10px", "100%c + 8px"],
					"layer": "($layer + 1)",

					"controls": [
						{
							"hori": {
								"type": "stack_panel",
								"orientation": "horizontal",

								"size": ["100%c", "100%cm"],
								"min_size": ["100%c", 20],
								"use_child_anchors": true,

								"$tooltip_renderer_type": "('%.2s' * ($var_title_text - ('%.7s' * $var_title_text)))",

								"controls": [
									{
										"icon_panel": {
											"type": "stack_panel",
											"orientation": "horizontal",

											"anchor_from": "top_left",
											"anchor_to": "top_left",
											"size": ["100%c", "100%cm"],
											"offset": [0, "150%y"],
											"use_child_anchors": true,

											"$set_ignored|default": false,

											"$ignore_block_icon|default": false,
											"$ignore_entity_icon|default": false,

											"variables": [
												{
													"requires": "(('%.10s' * ($var_title_text - ('%.8s' * $var_title_text))) = ':-00000NaN')",
													"$ignore_block_icon": true
												},
												{
													"requires": "($var_subtitle_text = '0000000000000')",
													"$ignore_entity_icon": true
												},

												/* 無視されるケースを処理 -- アイコンが無効な場合は非表示 */
												{
													"requires": "($ignore_block_icon and ($tooltip_renderer_type = 'A:'))",
													"$set_ignored": true
												},
												{
													"requires": "($ignore_entity_icon and not ($tooltip_renderer_type = 'A:'))",
													"$set_ignored": true
												}
											],

											"controls": [
												{
													"left_padding@common.empty_panel": {
														"size": [0.75, 1],

														/* エンティティ画像テクスチャにのみ表示 */
														"visible": "(not ($tooltip_renderer_type = 'A:'))",
														"ignored": "$ignore_entity_icon"
													}
												},
												{
													"renderer@common.empty_panel": {
														"size": [20, 20],
														"ignored": "$set_ignored",

														"controls": [
															{
																"block@waila_tile.sg_subtitle_item_renderer": {
																	"size": ["100%", "100%"],

																	"visible": "($tooltip_renderer_type = 'A:')"
																}
															},
															{
																"entity@waila_entity.entity_portrait_renderer": {
																	"size": ["100% - 5px", "100%x"],

																	"visible": "(not ($tooltip_renderer_type = 'A:'))",
																	"ignored": "$ignore_entity_icon"
																}
															}
														]
													}
												},
												{
													"right_padding@common.empty_panel": {
														"size": [5.25, 1],
														"ignored": "$set_ignored"
													}
												},

												{
													/* 内部エラーを避けるためにダミー要素を追加し、このスタックパネルを満たしたままにする */
													"empty@common.empty_panel": {
														"size": [1, 1],
														"ignored": "(not $set_ignored)"
													}
												}
											]
										}
									},
									{
										"information_panel@common.empty_panel": {
											"anchor_from": "top_left",
											"anchor_to": "top_left",
											"size": ["100%cm", "100%cm"],
											"offset": [1, 0],

											"controls": [
												{
													"label_stack": {
														"type": "stack_panel",
														"orientation": "vertical",

														"anchor_from": "top_left",
														"anchor_to": "top_left",
														"size": ["100%cm", "100%c"],

														"controls": [
															//* _waila:A:zz,t;zz,z: ...
															{
																// skygear change: the name with small marks after it, then the
																// item line (tile.json sg_marks, sg_item_line).
																"sg_name_row": {
																	"type": "stack_panel",
																	"orientation": "horizontal",
																	"size": ["100%c", "100%cm"],
																	"controls": [
																		{
																			"hover_name_and_namespace@waila_common.label": {
																				"min_size": ["default", 10], // skygear change: was 20 (the icon height); slots and lines sat low (11th playtest)
			
																				"text": "$text",
																				"variables": [
																					{
																						"requires": "($tooltip_renderer_type = 'A:')",
																						"$text": "('' + ($var_title_text - ('%.19s' * $var_title_text)) - '__waila:inv.hopper__' - 'tile.' - 'entity.' - '.name' - '__waila:sg.line__' - '__waila:inv.furnace__' - '__waila:inv.brewstand__' - '__waila:inv.chest__')"
																					},
																					{
																						"requires": "(not ($tooltip_renderer_type = 'A:'))",
																						"$text": "('' + ($var_title_text - ('%.325s' * $var_title_text)) - '__waila:inv.hopper__' - 'tile.' - 'entity.' - '.name' - '__waila:humanoid.')"
																					}
																				]
																			}
																		},
																		{ "sg_marks@waila_tile.sg_marks": {} }
																	]
																}
															},
															{
																"sg_item_line@waila_tile.sg_item_line": {
																	"ignored": "(($var_title_text - '__waila:sg.line__') = $var_title_text)"
																}
															},

															{
																"inventory_items@common.empty_panel": {
																	"size": ["100%c", "100%cm + 3px"],
																	"controls": [
																		{
																			"furnace_inventory@waila_tile.furnace_inventory": {
																				"ignored": "(($var_title_text - '__waila:inv.furnace__') = $var_title_text)"
																			}
																		},
																		{
																			"brewing_stand_inventory@waila_tile.brewing_stand_inventory": {
																				"ignored": "(($var_title_text - '__waila:inv.brewstand__') = $var_title_text)"
																			}
																		},
																		{
																			"chest_inventory@waila_tile.chest_inventory": {
																				"ignored": "(($var_title_text - '__waila:inv.chest__') = $var_title_text)"
																			}
																		},
																		{
																			"hopper_inventory@waila_tile.hopper_inventory": {
																				"ignored": "(($var_title_text) = $var_title_text)"
																			}
																		}
																	],
																	"ignored": "(($var_title_text - '__waila:inv.') = $var_title_text)"
																}
															},

															{
																"block_states@common.empty_panel": {
																	"size": ["100%cm", "100%cm"],
																	"controls": [
																		{
																			"border@waila_common.image": {
																				"size": ["100%c + 4px", "100%c + 4px"],
																				"texture": "textures/waila/border_center",

																				"controls": [
																					{
																						"list@waila_common.label": {
																							"text": "($var_subtitle_text - '__waila:block_states__')",
																							"font_scale_factor": 0.75
																						}
																					}
																				],

																				"ignored": "(not ($tooltip_renderer_type = 'A:'))"
																			}
																		}
																	],
																	// skygear change: the server sends no block states, and
																	// this label warned "expected a string" (11th playtest).
																	"ignored": true
																}
															}
														]
													}
												},

												//* _waila:B:yyyyyyyyyyyyyyyyyyyydddddddddd ...
												{
													"entity_metadatas@common.empty_panel": {
														"anchor_from": "top_left",
														"anchor_to": "top_left",
														"size": ["100%c", "100%c - 10px"],
														"offset": [0, 11],

														/* エンティティをレンダリングしていない場合は無視 */
														"ignored": "($tooltip_renderer_type = 'A:')",

														"controls": [
															{
																"verti": {
																	"type": "stack_panel",
																	"orientation": "vertical",

																	"anchor_from": "top_left",
																	"anchor_to": "top_left",
																	"size": ["100%cm", "100%c"],

																	"controls": [
																		{
																			"top_padding@common.empty_panel": {
																				"size": [1, 0.5]
																			}
																		},

																		{
																			"health_0@waila_entity.health_renderer_0": {}
																		},
																		{
																			"health_1@waila_entity.health_renderer_1": {}
																		},

																		{
																			"armor@waila_entity.armor_renderer": {}
																		},

																		{
																			"effects_padding_top@common.empty_panel": {
																				"$size": [0, 0.5],
																				"size": "$size",

																				"$is_int_health": "(('' + ('%.2s' * ($var_title_text - ('%.9s' * $var_title_text)))) = 'yx')",
																				"variables": {
																					"requires": "($is_int_health)",
																					"$size": [0, 8.5]
																				},

																				"ignored": "(('%.3s' * ($var_title_text - ('%.322s' * $var_title_text))) = 'e00')"
																			}
																		},
																		{
																			"effects@waila_entity.effects_renderer": {} 
																		}
																	]
																}
															}
														]
													}
												}
											]
										}
									},
									{
										"tags_panel@waila_tile.block_tags": {} 
									}
								]
							}
						}
					],

					"ignored": "(not ('%.7s' * $var_title_text = '_waila:'))"
				}
			}
		]
	},

	"centerer@common.empty_panel": {
		"$s_anchor|default": "top_middle",

		"size": ["100%", "100%"],

		/* 変数を初期化 */
		"$var_title_text1": "$title_text",
		"$var_subtitle_text": "$subtitle_text",

		"variables": [
			{
				"requires": "(not (($var_title_text1 - '__waila:anchor.top_middle__') = $var_title_text1))",
				"$s_anchor": "top_middle"
			}
		],

		"controls": [
			{
				"main@waila_main.main": {
					"anchor_from": "$s_anchor",
					"anchor_to": "$s_anchor",

					"$offset|default": [0, 0],
					"offset": "$offset",

					"variables": [
						// skygear change: top middle sits below the boss bar (urgent
						// missions use it) and the touch pause buttons.
						{
							"requires": "($s_anchor = 'top_middle')",
							"$offset": [ 0, 26 ]
						},
						// offset to avoid clipping with the hotbar
						{
							"requires": "($s_anchor = 'bottom_middle')",
							"$offset": [ 0, -46 ]
						}
					]
				}
			}
		]
	}
}
