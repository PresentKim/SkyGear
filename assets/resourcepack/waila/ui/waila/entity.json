{

	"namespace": "waila_entity",

	"status_effect_renderer@common.empty_panel": {
		"size": ["100%c", "100%c"],

		//* エフェクト名と持続時間を含む拡張版を表示するかどうか
		"$is_expanded|default": true,

		//* 使用するアイコン
		"$data_a|default": "",

		//* 使用するローカリゼーションキー
		"$data_b|default": "",

		//* エフェクトがネガティブな場合
		"$data_c|default": false,

		//* エフェクトの持続時間と増幅度を整形した文字列
		"$data_d|default": "d00:00p0",

		"controls": [
			{
				"icon_and_label_expanded": {
					"type": "stack_panel",
					"orientation": "horizontal",

					"size": "$size",
					"$size|default": ["100%c", "100%cm + 4px"],
					"variables": {
						"requires": "(not $is_expanded)",
						"$size": [0, 0]
					},

					"ignored": "(('%.2s' * ($data_d - ('%.6s' * $data_d))) = 'p0')",
					"visible": "$is_expanded",

					"controls": [
						{
							"icon_panel@common.empty_panel": {
								"size": ["100%y", "100%sm"],

								"controls": [
									{
										"icon@waila_common.image": {
											"$texture": "('textures/ui/' + $data_a + '_effect')",
											"texture": "$texture",
											"keep_ratio": true,

											"size": ["100% - 4px", "100% - 4px"]
										}
									}
								]
							}
						},
						{ "padding@common.empty_panel": { "size": [ 2.5, 0 ] } },
						{
							"label_panel": {
								"type": "stack_panel",
								"orientation": "vertical",

								"size": ["100%cm + 2px", "100%c"],

								"controls": [
									{
										"name_and_amplifier": {
											"type": "stack_panel",
											"orientation": "horizontal",

											"size": ["100%c", "100%cm"],

											"$data_e": "('%.2s' * ($data_d - ('%.6s' * $data_d)))",

											"variables": [
												{
													"requires": "$data_c",
													"$color": "$c_color_format"
												},
												{
													"requires": "(not $data_c)",
													"$color": "$f_color_format"
												}
											],

											"controls": [
												{
													"name@waila_common.label": {
														"text": "$data_b",
														"font_scale_factor": 0.75,
														"localize": true,
														"color": "$color"
													}
												},
												{
													"padding@waila_common.label": {
														"text": " ",
														"font_scale_factor": 0.75,
														"color": "$color"
													}
												},
												{
													"amplifier@waila_common.label": {
														"text": "$text",
														"font_scale_factor": 0.75,
														"color": "$color",

														"$text": "",
														"variables": [
															{ "requires": "($data_e = 'p2')", "$text": "II" },
															{ "requires": "($data_e = 'p3')", "$text": "III" },
															{ "requires": "($data_e = 'p4')", "$text": "IV" },
															{ "requires": "($data_e = 'p5')", "$text": "V" },
															{ "requires": "($data_e = 'p6')", "$text": "VI" },
															{ "requires": "($data_e = 'p7')", "$text": "VII" },
															{ "requires": "($data_e = 'p8')", "$text": "VIII" },
															{ "requires": "($data_e = 'p9')", "$text": "IX" }
														]
													}
												}
											]
										}
									},
									{
										"duration@waila_common.label": {
											"text": "#text",
											"font_scale_factor": 0.75,
											"color": "$7_color_format",

											"property_bag": {
												"#data_d": "('§z' + $data_d)"
											},
											"bindings": [
												{
													"binding_type": "view",
													"source_property_name": "(('%.9s' * #data_d) - 'd')",
													"target_property_name": "#text"
												}
											]
										}
									}
								]
							}
						}
					]
				}
			},
			{
				"icon_and_label_mini@common.empty_panel": {
					"size": "$size",
					"$size|default": ["100%cm", "100%cm"],
					"variables": {
						"requires": "$is_expanded",
						"$size": [0, 0]
					},

					"ignored": "(('%.2s' * ($data_d - ('%.6s' * $data_d))) = 'p0')",
					"visible": "(not $is_expanded)",

					"controls": [
						{
							"icon_panel@common.empty_panel": {
								"size": ["100%c + 4px", "100%c + 2px"],

								"controls": [
									{
										"icon@waila_common.image": {
											"$texture": "('textures/ui/' + $data_a + '_effect')",
											"texture": "$texture",
											"keep_ratio": true,

											"size": [10, 10],

											"$data_e": "('%.2s' * ($data_d - ('%.6s' * $data_d)))",

											"controls": [
												{
													"amplifier@waila_common.label": {
														"anchor_from": "bottom_right",
														"anchor_to": "bottom_right",
														"offset": [0, 1],

														"text": "$text",
														"font_scale_factor": 0.75,
														"color": "$color",

														"$text": "",
														"variables": [
															{
																"requires": "$data_c",
																"$color": "$c_color_format"
															},
															{
																"requires": "(not $data_c)",
																"$color": "$f_color_format"
															},

															{ "requires": "($data_e = 'p2')", "$text": "II" },
															{ "requires": "($data_e = 'p3')", "$text": "III" },
															{ "requires": "($data_e = 'p4')", "$text": "IV" },
															{ "requires": "($data_e = 'p5')", "$text": "V" },
															{ "requires": "($data_e = 'p6')", "$text": "VI" },
															{ "requires": "($data_e = 'p7')", "$text": "VII" },
															{ "requires": "($data_e = 'p8')", "$text": "VIII" },
															{ "requires": "($data_e = 'p9')", "$text": "IX" }
														]
													}
												}
											]
										}
									}
								]
							}
						}
					]
				}
			}
		]
	},

	"entity_portrait_renderer": {
		"type": "custom",
		"renderer": "live_horse_renderer",

		"offset": "$offset",
		"layer": "($layer + 1)",

		"property_bag": {
			"#entity_id": "$var_subtitle_text"
		},

		"variables": [
			{
				"requires": "(($var_title_text - '__waila:humanoid.') = $var_title_text)",
				"$offset": [0, "75%y + 2.5px"]
			},
			{
				"requires": "(not (($var_title_text - '__waila:humanoid.') = $var_title_text))",
				"$offset": [0, -2.5]
			}
		]
	},

