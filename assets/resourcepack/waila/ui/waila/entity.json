	"effects_renderer@common.empty_panel": {
		//* _waila:B:yyyyyyyyyyyyyyyyyyyydddddddddd:zz,t;zz,z:d00:00p0d00:00p0d00:00p0d00:00p0d00:00p0d00:00p0d00:00p0d00:00p0d00:00p0d00:00p0d00:00p0d00:00p0d00:00p0d00:00p0d00:00p0d00:00p0d00:00p0d00:00p0d00:00p0d00:00p0d00:00p0d00:00p0d00:00p0d00:00p0d00:00p0d00:00p0d00:00p0d00:00p0d00:00p0d00:00p0d00:00p0d00:00p0d00:00p0d00:00p0e00

		"size": ["100%c + 3px", "100%c + 1px"],

		"$effects_length": "('%.3s' * ($var_title_text - ('%.322s' * $var_title_text)))",

		"ignored": "(('%.3s' * ($var_title_text - ('%.322s' * $var_title_text))) = 'e00')",

		"controls": [
			{
				"verti": {
					"type": "stack_panel",
					"orientation": "vertical",

					"size": ["100%cm", "100%c"],
					"offset": [0, 0.5],
					"$is_expanded": true,

					"ignored": "($effects_length = 'e03' or $effects_length = 'e04')",

