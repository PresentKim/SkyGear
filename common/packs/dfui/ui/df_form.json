  // gslot_deco: the frame and badge of an item slot, chosen by the marks in
  // the first line of its tooltip (decor.go tipName, docs/tech/slotdeco.md).
  // One picture per slot (textures/ui/df/deco_<rarity>_<front>.png), one
  // control, so a grid of slots stays cheap.
  "gslot_deco": {
    "type": "image",
    "layer": 30,
    "size": [
      "100%",
      "100%"
    ],
    "texture": "#texture",
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view",
        "source_property_name": "((not ((#form_button_text - '§k§r§a') = #form_button_text)) * 1 + (not ((#form_button_text - '§k§r§b') = #form_button_text)) * 2 + (not ((#form_button_text - '§k§r§d') = #form_button_text)) * 3 + (not ((#form_button_text - '§k§r§6') = #form_button_text)) * 4)",
        "target_property_name": "#df_rarity"
      },
      {
        "binding_type": "view",
        "source_property_name": "((not ((#form_button_text - '§k§l§r§1§r') = #form_button_text)) * 1 + (not ((#form_button_text - '§k§l§r§2§r') = #form_button_text)) * 2 + (not ((#form_button_text - '§k§l§r§3§r') = #form_button_text)) * 3 + (not ((#form_button_text - '§k§l§r§4§r') = #form_button_text)) * 4 + (not ((#form_button_text - '§k§l§r§5§r') = #form_button_text)) * 5 + (not ((#form_button_text - '§k§l§r§6§r') = #form_button_text)) * 6)",
        "target_property_name": "#df_front"
      },
      {
        "binding_type": "view",
        "source_property_name": "('textures/ui/df/deco_' + #df_rarity + '_' + #df_front)",
        "target_property_name": "#texture"
      },
      {
        "binding_type": "view",
        "source_property_name": "((#df_rarity > 0) or (#df_front > 0))",
        "target_property_name": "#visible"
      }
    ]
  },

