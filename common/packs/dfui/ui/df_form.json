        "source_property_name": "(not ((#form_button_text - '§0§o§r') = #form_button_text))",
        "target_property_name": "#visible"
      }
    ]
  },
  // The chosen row: the same row one rank brighter.
  "vis_list_row_on": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
