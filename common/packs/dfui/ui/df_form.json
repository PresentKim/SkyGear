      { "on@df_form.vis_tab_on": { "type": "image", "texture": "textures/ui/df/tree_tab_on", "size": [ 24, 29 ], "anchor_from": "top_left", "anchor_to": "top_left", "layer": 2 } },
      { "icon@df_form.button_icon": { "$df_icon_size": [ 16, 16 ], "offset": [ 0, 1 ] } },
