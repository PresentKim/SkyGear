  // heading, the text on the window and the action buttons. The rows are the
  // first buttons after the heading.
  "vis_list_head": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#form_button_text - '§0§7§r') = #form_button_text))",
        "target_property_name": "#visible"
      }
    ]
  },
  "vis_list_row": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
