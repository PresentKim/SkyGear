  // The actions of a ListSplitMenu: the first is a full width button and the
  // rest sit two to a row, the odd one out leaving its right cell empty. The
  // button order of the form is the grid order (primary, left, right, left…),
  // so a column marker (ui.ListSplitMenu) puts each button in its cell.
  // The actions take only the room their buttons need, so a short body
  // and a few actions fit the column without a scroll bar.
  "list_split_actions": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [ "100%", "100%c" ],
    "controls": [
      {
        "primary@df_form.marked_list_primary": {
          "orientation": "vertical",
          "size": [ "100%", "100%c" ]
        }
      },
      { "gap": { "type": "panel", "size": [ "100%", 2 ] } },
      {
        "row": {
          "type": "panel",
          "size": [ "100%", "100%cm" ],
          "controls": [
            {
              "col_a@df_form.marked_list_col_a": {
                "orientation": "vertical",
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "size": [ "50% - 2px", "100%c" ]
              }
            },
            {
              "col_b@df_form.marked_list_col_b": {
                "orientation": "vertical",
                "anchor_from": "top_right",
                "anchor_to": "top_right",
                "size": [ "50% - 2px", "100%c" ]
              }
            }
          ]
        }
      }
    ]
  },

