    "$scroll_size": [ 4, "100% - 4px" ],
    "$scrolling_pane_size": [ "100% - 6px", "100%" ],
    "$scrolling_pane_offset": [ 0, 0 ],
    "$scroll_bar_right_padding_size": [ 0, 0 ]
  },

  // The wrapping grid holds 11 slots (24px) per row; the buttons that are
  // not slots (back, actions) come last and leave empty cells.
  "gslot_wrap_content": {
    "type": "stack_panel",
    "size": [ "100% - 6px", "100%c" ],
    "orientation": "vertical",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      { "tabgap": { "type": "panel", "size": [ "100%", 6 ] } },
      {
        "body": {
          "type": "panel",
          "size": [ "100%", "100%c" ],
          "bindings": [
            { "binding_name": "#form_text" },
            { "binding_type": "view", "source_property_name": "(not (#form_text = ''))", "target_property_name": "#visible" }
          ],
          "controls": [ { "label@df_form.body_label": {} } ]
        }
      },
      { "gap": { "type": "panel", "size": [ "100%", 6 ] } },
      {
        "grid_row": {
          "type": "panel",
          "size": [ "100%", "100%c" ],
          "controls": [
            {
              "slots": {
                "type": "grid",
                "size": [ 264, "100%c" ],
                "anchor_from": "top_middle",
                "anchor_to": "top_middle",
                "grid_rescaling_type": "horizontal",
                "grid_item_template": "df_form.gslot_cell",
                "collection_name": "form_buttons",
                "bindings": [
                  {
                    "binding_name": "#form_button_length",
                    "binding_name_override": "#maximum_grid_items",
                    "binding_condition": "visible"
                  }
                ]
              }
            }
          ]
        }
      },
      { "gap2": { "type": "panel", "size": [ "100%", 8 ] } },
      {
        "actions@df_form.marked_actions": {
          "orientation": "vertical",
          "size": [ "100%", "100%c" ]
        }
      }
    ]
  },

  // A cell of the wrapping grid: a slot, or the heading of a section (§0§g§r,
  // its text runs over the empty cells after it), or nothing (pad cells).
  "gslot_cell": {
    "type": "panel",
    "size": [ 24, 24 ],
    "controls": [
      { "slot@df_form.gslot_w_item": {} },
      { "head@df_form.gslot_grid_head": {} }
    ]
  },

  "gslot_grid_head@df_form.vis_gslot_h1": {
    "type": "panel",
    "size": [ 24, 24 ],
    "controls": [
      {
        "text": {
          "type": "label",
          "layer": 3,
          "text": "#df_head",
          "color": [ 0.2, 0.2, 0.2 ],
          "size": [ "default", "default" ],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "offset": [ 2, 4 ],
          "bindings": [
            {
              "binding_name": "#form_button_text",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#form_button_text - '§0§g§r')",
              "target_property_name": "#df_head"
            }
          ]
        }
      }
    ]
  },

  // The three slot kinds differ only in the marker they show for.
  "gslot_a_item@df_form.vis_gslot_a": {
    "type": "panel",
    "size": [ 24, 24 ],
    "$df_slot_control|default": "df_form.gslot_button",
    "controls": [ { "slot@$df_slot_control": {} } ]
  },
  "gslot_b_item@df_form.vis_gslot_b": {
    "type": "panel",
    "size": [ 24, 24 ],
    "$df_slot_control|default": "df_form.gslot_button",
    "controls": [ { "slot@$df_slot_control": {} } ]
  },
  "gslot_w_item@df_form.vis_gslot_w": {
    "type": "panel",
    "size": [ 24, 24 ],
    "$df_slot_control|default": "df_form.gslot_button",
    "controls": [ { "slot@$df_slot_control": {} } ]
  },

  // A heading is a small grey text; its button text minus the marker.
  "gslot_h1_item@df_form.vis_gslot_h1": {
    "type": "panel",
    "size": [ "100%", 12 ],
    "controls": [
      {
        "text": {
          "type": "label",
          "layer": 3,
          "text": "#df_head",
          "color": [ 0.3, 0.3, 0.3 ],
          "font_scale_factor": 0.8,
          "size": [ "100%", "default" ],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "bindings": [
            {
              "binding_name": "#form_button_text",
              "binding_type": "collection", 
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_type": "view", 
              "source_property_name": "(#form_button_text - '§0§g§r')",
              "target_property_name": "#df_head"
            }
          ]
        }
      }
    ]
  },
  "gslot_h2_item@df_form.vis_gslot_h2": {
    "type": "panel",
    "size": [ "100%", 12 ],
    "controls": [
      {
        "text": {
          "type": "label",
          "layer": 3,
          "text": "#df_head",
          "color": [ 0.3, 0.3, 0.3 ],
          "font_scale_factor": 0.8,
          "size": [ "100%", "default" ],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "bindings": [
            {
              "binding_name": "#form_button_text",
              "binding_type": "collection", 
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_type": "view", 
              "source_property_name": "(#form_button_text - '§0§h§r')",
              "target_property_name": "#df_head"
            }
          ]
        }
      }
    ]
  },

  // gslot_count is the count at the slot's bottom right: bytes 9 to 19 of
  // the button text without the '~' padding.
  "gslot_count": {
    "type": "label",
    "layer": 4,
    "text": "#df_count",
    "color": [ 1, 1, 1 ],
    "shadow": true,
    "font_scale_factor": 0.75,
    "text_alignment": "right",
    "size": [ "default", "default" ],
    "offset": [ -1, 0 ],
    "anchor_from": "bottom_right",
    "anchor_to": "bottom_right",
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection", 
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", 
        "source_property_name": "((((('%.10s' * (#form_button_text - ('%.10s' * #form_button_text))) - '~~~~~~~~') - '~~~~') - '~~') - '~')",
        "target_property_name": "#df_count"
      }
    ]
  },

  // The tooltip is the text from byte 20 on, drawn by the engine at the
  // pointer (hover_text_renderer) so no pane clips it and no side has to be
  // chosen; the side byte (10) of the button text is not used any more.
  "gslot_hover_tip@common.hover_text": {
    "$hover_text_max_width": 0,
    "layer": 200,
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#form_button_text - ('%.20s' * #form_button_text))",
        "target_property_name": "#hover_text"
      }
    ]
  },

  "gslot_face": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "$df_slot_texture|default": "textures/ui/cell_image",
    "controls": [
      { "bg@df_form.state_image": { "$df_state_texture": "$df_slot_texture" } },
      { "icon@df_form.button_icon": { "$df_icon_size": [ 16, 16 ] } },
      { "count@df_form.gslot_count": {} }
    ]
  },

  "gslot_face_tip@df_form.gslot_face": {
    "controls": [
      { "bg@df_form.state_image": { "$df_state_texture": "$df_slot_texture" } },
      { "icon@df_form.button_icon": { "$df_icon_size": [ 16, 16 ] } },
      { "count@df_form.gslot_count": {} },
      { "tip@df_form.gslot_hover_tip": {} }
    ]
  },

  // gslot_deco: the frame and badge of an item slot, chosen by the marks in
  // the first line of its tooltip (decor.go tipName, docs/tech/slotdeco.md).
  // One picture per slot (textures/ui/df/deco_<rarity>_<front>.png), one
  // control, so a grid of slots stays cheap.
  "gslot_deco": {
    "type": "image",
    "layer": 6,
    "size": [
      "100%",
      "100%"
    ],
    "texture": "#texture",
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view",
        "source_property_name": "((not ((#form_button_text - '§k§r§a') = #form_button_text)) * 1 + (not ((#form_button_text - '§k§r§b') = #form_button_text)) * 2 + (not ((#form_button_text - '§k§r§d') = #form_button_text)) * 3 + (not ((#form_button_text - '§k§r§6') = #form_button_text)) * 4)",
        "target_property_name": "#df_rarity"
      },
      {
        "binding_type": "view",
        "source_property_name": "((not ((#form_button_text - '§k§l§r§1§r') = #form_button_text)) * 1 + (not ((#form_button_text - '§k§l§r§2§r') = #form_button_text)) * 2 + (not ((#form_button_text - '§k§l§r§3§r') = #form_button_text)) * 3 + (not ((#form_button_text - '§k§l§r§4§r') = #form_button_text)) * 4 + (not ((#form_button_text - '§k§l§r§5§r') = #form_button_text)) * 5 + (not ((#form_button_text - '§k§l§r§6§r') = #form_button_text)) * 6)",
        "target_property_name": "#df_front"
      },
      {
        "binding_type": "view",
        "source_property_name": "('textures/ui/df/deco_' + #df_rarity + '_' + #df_front)",
        "target_property_name": "#texture"
      },
      {
        "binding_type": "view",
        "source_property_name": "((#df_rarity > 0) or (#df_front > 0))",
        "target_property_name": "#visible"
      }
    ]
  },

  // gslot_button (mouse and touch): hovering, or holding a finger down, shows
  // the tooltip; a tap or click presses it. No toggle: radio toggles cannot
  // be exclusive across grid cells, so several tooltips opened at once.
  "gslot_button@common.button": {
    "$focus_enabled": false,
    "$pressed_button_name": "button.form_button_click",
    "size": [ 22, 22 ],
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      }
    ],
    "controls": [
      { "default@df_form.gslot_face": {} },
      { "hover@df_form.gslot_face_tip": { "$df_slot_texture": "textures/ui/df/button_hover" } },
      { "pressed@df_form.gslot_face_tip": { "$df_slot_texture": "textures/ui/df/button_pressed" } },
      { "deco@df_form.gslot_deco": {} }
    ]
  },

  "action_item@df_form.vis_action": {
    "type": "panel",
    "size": [ "100%", 32 ],
    "controls": [ { "button@df_form.list_button": {} } ]
  },

  // ---- split form (title starts with §d§f§y§r, Go ui.SplitMenu) ----
  // Left: tabs, a grid of 40 cells (8×5: slots, the chosen slot, empty
  // frames), page buttons. Right: the detail of the chosen slot (card,
  // actions, text, two rows of slots). The grid is the first 40 buttons.
  // The chosen slot of the split grid.
  "vis_gslot_sel": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#form_button_text - '§0§s§r') = #form_button_text))",
        "target_property_name": "#visible"
      }
    ]
  },
  // An empty frame of the split grid.
  "vis_gslot_empty": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#form_button_text - '§0§t§r') = #form_button_text))",
        "target_property_name": "#visible"
      }
    ]
  },
  // A page button under the split grid.
  "vis_pager": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
