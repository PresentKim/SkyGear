                            "size": [ "100%", "100%c" ]
                          }
                        },
                        {
                          "row_a@df_form.marked_cols_a": {
                            "orientation": "horizontal",
                            "size": [ "100%", "100%cm" ]
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            },
            { "gap": { "type": "panel", "size": [ 8, 1 ] } },
            {
              "right": {
                "type": "image",
                "texture": "textures/ui/df/panel",
                "size": [ "fill", "100%c + 12px" ],
                "controls": [
                  {
                    "inner": {
                      "type": "stack_panel",
                      "orientation": "vertical",
                      "size": [ "100% - 12px", "100%c" ],
                      "offset": [ 6, 6 ],
                      "anchor_from": "top_left",
