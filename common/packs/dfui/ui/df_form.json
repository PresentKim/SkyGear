              "binding_name": "#form_button_text",
              "binding_type": "collection",
              "binding_collection_name": "form_buttons"
            },
            {
              "binding_type": "view",
              "source_property_name": "(('%.9s' * #form_button_text) + ('%.60s' * (#form_button_text - ('%.9s' * #form_button_text))))",
              "target_property_name": "#df_name"
            }
          ]
        }
      },
      {
        // The information line under the name, one size smaller and in a
        // lighter grey (the row's text carries its own colour codes).
        "info": {
          "type": "label",
          "layer": 3,
          "text": "#df_info",
          "color": [ 0.8, 0.8, 0.82 ],
