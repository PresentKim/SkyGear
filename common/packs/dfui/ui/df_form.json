{
  // The dfui theme for server forms. Textures: textures/ui/df (generated by
  // tools/uitextures, tools/treetex and tools/slotdecotex). Button wiring
  // follows the vanilla server_form.dynamic_button contract: the button binds
  // collection_details of "form_buttons" and presses button.form_button_click.
  "namespace": "df_form",


  "title_label": {
    "type": "label",
    "text": "#df_title",
    "color": [ 0.25, 0.25, 0.25 ],
    "size": [ "100%", "default" ],
    "text_alignment": "center",
    "anchor_from": "center",
    "anchor_to": "center",
    "layer": 2,
    "bindings": [
      { "binding_name": "#title_text", "binding_type": "global" },
      {
        "binding_type": "view",
        "source_property_name": "(#title_text - '§d§f§c§r' - '§d§f§s§r' - '§d§f§t§r' - '§d§f§i§r' - '§d§f§g§r' - '§d§f§h§r' - '§d§f§j§r' - '§d§f§y§r' - '§d§f§l§r' - '§d§f§e§r' - '§d§f§z§r' - '§d§f§b§r' - '§d§f§w§r' - '§d§f§u§r')",
        "target_property_name": "#df_title"
      }
    ]
  },

  // The dark rounded bar above the window's top right corner with the help,
  // back and close buttons (the bar is as wide as the buttons it holds).
  "control_bar": {
          "type": "image",
          "texture": "textures/ui/toolbar_background",
          "size": [ "100%c + 6px", 25 ],
          "offset": [ 0, -22 ],
          "anchor_from": "top_right",
          "anchor_to": "top_right",
          "layer": -2,
          "controls": [
            {
              "row": {
                "type": "stack_panel",
                "orientation": "horizontal",
                "size": [ "100%c", 22 ],
                "anchor_from": "center",
                "anchor_to": "center",
                "controls": [
                  {
                    // The page arrows (ui.BarPager, marked §0§j§r) sit left
                    // of the help button.
                    "pager@df_form.marked_bar_pager": {
                      "orientation": "horizontal",
                      "size": [ "100%c", 22 ]
                    }
                  },
                  {
                    // The help button (ui.Help, marked §0§p§r) sits left of
                    // the back button.
                    "help@df_form.marked_help": {
                      "orientation": "horizontal",
                      "size": [ "100%c", 22 ]
                    }
                  },
                  {
                    // The back button (ui.Back, marked §0§3§r) sits left of
                    // the close button.
                    "back@df_form.marked_back": {
                      "orientation": "horizontal",
                      "size": [ "100%c", 22 ]
                    }
                  },
                  {
                    // An input form's back button (ui.Input with a back
                    // callback, title marked §d§f§b§r).
                    "input_back@df_form.marked_input_back": {}
                  },
                  {
                    "close_slot": {
                      "type": "panel",
                      "size": [ 17, 22 ],
                      "controls": [
                        {
                          "close@common.light_close_button": {
                            "$close_button_offset": [ 0, 0 ],
                            "anchor_from": "center",
                            "anchor_to": "center"
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },

  // window draws the panel, the title bar and the close button around
  // $df_content.
  "window": {
    "type": "image",
    "texture": "textures/ui/dialog_background_opaque",
    // No window is larger than the game's inventory screen (326×166, with
    // the tabs and the control bar above it like the inventory's toolbar):
    // the touch layout scales the interface up, and only a window that size
    // fits a phone's screen.
    "$df_window_size|default": [ 230, 166 ],
    "$df_tabs|default": "df_form.marked_tabs",
    "$df_chrome|default": "df_form.control_bar",
    // "$df_title|default": false hides the title (the input form draws no
    // title: its field's label names the question).
    "$df_title|default": true,
    "$df_content_offset|default": [ 0, 18 ],
    "$df_content_size|default": [ "100% - 12px", "100% - 24px" ],
    "size": "$df_window_size",
    "max_size": [ "100% - 8px", "100% - 8px" ],
    "layer": 2,
    "controls": [
      // The screen around the window is darkened like the game's own screens,
      // but not in the lobby (ui.LobbyToken): there the lobby island and its
      // launcher frame stay bright around the window.
      {
        "dim": {
          "type": "image",
          "texture": "textures/ui/Black",
          "alpha": 0.5,
          "keep_ratio": false,
          "size": [ 4000, 4000 ],
          "anchor_from": "center",
          "anchor_to": "center",
          "layer": -8,
          "bindings": [
            { "binding_name": "#title_text", "binding_type": "global" },
            {
              "binding_type": "view",
              "source_property_name": "((#title_text - '§d§f§w§r') = #title_text)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      // The tabs sit on the window's top edge like the game's own tabs.
      {
        "tabs_top@$df_tabs": {
          "orientation": "horizontal",
          "size": [ "100%c", 24 ],
          "offset": [ 8, -22 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "layer": 3
        }
      },
      // The help, back and close buttons sit in a dark rounded bar of their
      // own above the window's top right corner, like the game's own screens.
      { "chrome@$df_chrome": {} },
      // The inner edge of the panel (light top left, dark bottom right).
      {
        "bevel": {
          "type": "image",
          "texture": "textures/ui/df/panel_bevel",
          "size": [ "100%", "100%" ],
          "layer": 0
        }
      },
      // The title is a line of text at the top of the window, like the
      // game's own container titles.
      {
        "title_bar": {
          "type": "panel",
          "size": [ "100% - 8px", 10 ],
          "offset": [ 0, 6 ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "layer": 1,
          "visible": "$df_title",
          "controls": [
            { "title@df_form.title_label": {} }
          ]
        }
      },
      {
        "content": {
          "type": "panel",
          "size": "$df_content_size",
          "offset": "$df_content_offset",
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "layer": 2,
          "controls": [ { "inner@$df_content": {} } ]
        }
      }
    ]
  },

  "body_label": {
    "type": "label",
    "text": "#df_body",
    "bindings": [ { "binding_name": "#form_text" }, { "binding_type": "view", "source_property_name": "(#form_text - ('%.12s' * #form_text))", "target_property_name": "#df_body" } ],
    "color": [ 0.2, 0.2, 0.2 ],
    "size": [ "100% - 4px", "default" ],
    "offset": [ 2, 0 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left"
  },

  // ---- marked buttons (ui.Tab, ui.Back, table actions) ----
  // Stack panels over all form buttons that show only the buttons of one
  // kind (one control per kind: a factory's control id cannot be a
  // variable): the item template hides the others, and hidden controls take no
  // space in a stack panel. Lists and grids hide every marked button (all
  // markers start with §0§).

  "marked_back": {
    "type": "stack_panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "factory": {
      "name": "buttons",
      "control_ids": { "button": "df_form.back_item" }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length",
        "binding_condition": "visible"
      }
    ]
  },

  // An input form's back button: input forms have no button collection, so
  // this is one plain button, shown when the title has ui.InputBackToken. A
  // custom form sends no data for the back or the close button, so both reach
  // the form's Close callback and go back.
  "marked_input_back": {
    "type": "panel",
    "size": [ 17, 22 ],
    "visible": false,
    "bindings": [
      { "binding_name": "#title_text", "binding_type": "global" },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#title_text - '§d§f§b§r') = #title_text))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [ { "button@df_form.input_back_button": {} } ]
  },

  "input_back_button@common.button": {
    "$focus_enabled": false,
    "$pressed_button_name": "button.menu_exit",
    "size": [ 15, 15 ],
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "controls": [
      { "default@df_form.state_image": { "$df_state_texture": "textures/ui/df/clear" } },
      { "hover@df_form.state_image": { "$df_state_texture": "textures/ui/df/hover_flat" } },
      { "pressed@df_form.state_image": { "$df_state_texture": "textures/ui/df/press_flat" } },
      { "icon": { "type": "image", "texture": "textures/ui/df/chevron_left", "size": [ 9, 12 ], "layer": 3 } }
    ]
  },

  "marked_help": {
    "type": "stack_panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "factory": {
      "name": "buttons",
      "control_ids": { "button": "df_form.help_item" }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length",
        "binding_condition": "visible"
      }
    ]
  },

  "marked_tabs": {
    "type": "stack_panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "factory": {
      "name": "buttons",
      "control_ids": { "button": "df_form.tab_item" }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length",
        "binding_condition": "visible"
      }
    ]
  },

  "marked_total": {
    "type": "stack_panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "factory": {
      "name": "buttons",
      "control_ids": { "button": "df_form.total_item" }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length",
        "binding_condition": "visible"
      }
    ]
  },

  "marked_actions": {
    "type": "stack_panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "factory": {
      "name": "buttons",
      "control_ids": { "button": "df_form.action_item" }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length",
        "binding_condition": "visible"
      }
    ]
  },

  // The vis_* templates show their control only for buttons with a marker.
  // The markers are literal in each expression: variables are not
  // substituted inside binding expressions (8th playtest: no tabs shown).
  // vis_back: the back button
  "vis_back": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection", 
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", 
        "source_property_name": "(not ((#form_button_text - '§0§3§r') = #form_button_text))",
        "target_property_name": "#visible"
      }
    ]
  },

  "vis_help": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#form_button_text - '§0§p§r') = #form_button_text))",
        "target_property_name": "#visible"
      }
    ]
  },

  // vis_tab: tabs
  "vis_tab": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection", 
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", 
        "source_property_name": "((not ((#form_button_text - '§0§1§r') = #form_button_text)) or (not ((#form_button_text - '§0§2§r') = #form_button_text)))",
        "target_property_name": "#visible"
      }
    ]
  },

  // vis_tab_on: the selected tab
  "vis_tab_on": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection", 
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", 
        "source_property_name": "(not ((#form_button_text - '§0§2§r') = #form_button_text))",
        "target_property_name": "#visible"
      }
    ]
  },

  // vis_cell: table cells
  "vis_cell": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection", 
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", 
        "source_property_name": "((not ((#form_button_text - '§0§5§r') = #form_button_text)) or (not ((#form_button_text - '§0§6§r') = #form_button_text)))",
        "target_property_name": "#visible"
      }
    ]
  },

  // vis_cell_text: text cells
  "vis_cell_text": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection", 
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", 
        "source_property_name": "(not ((#form_button_text - '§0§5§r') = #form_button_text))",
        "target_property_name": "#visible"
      }
    ]
  },

  // vis_cell_num: number cells
  "vis_cell_num": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection", 
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", 
        "source_property_name": "(not ((#form_button_text - '§0§6§r') = #form_button_text))",
        "target_property_name": "#visible"
      }
    ]
  },

  // vis_total: the table total
  "vis_total": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection", 
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", 
        "source_property_name": "(not ((#form_button_text - '§0§8§r') = #form_button_text))",
        "target_property_name": "#visible"
      }
    ]
  },

  // vis_action: table actions
  "vis_action": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection", 
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", 
        "source_property_name": "(not ((#form_button_text - '§0§4§r') = #form_button_text))",
        "target_property_name": "#visible"
      }
    ]
  },

  // unmarked_visible shows its control only for normal buttons.
  "unmarked_visible": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection", 
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", 
        "source_property_name": "((#form_button_text - '§0§') = #form_button_text)",
        "target_property_name": "#visible"
      }
    ]
  },

  "help_item@df_form.vis_help": {
    "type": "panel",
    "size": [ 17, 22 ],
    "controls": [ { "button@df_form.help_button": {} } ]
  },

  // help_button is the "?" button; hovering (or pressing) it shows the text
  // of the button after the marker as an engine tooltip.
  "help_tip@common.hover_text": {
    "$hover_text_max_width": 0,
    "layer": 200,
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#form_button_text - '§0§p§r')",
        "target_property_name": "#hover_text"
      }
    ]
  },

  "help_face": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "$df_help_texture|default": "textures/ui/how_to_play_button_default_light",
    "controls": [
      { "mark": { "type": "image", "texture": "$df_help_texture", "size": [ 15, 15 ], "layer": 3 } }
    ]
  },
  "help_face_tip@df_form.help_face": {
    "controls": [
      { "mark": { "type": "image", "texture": "$df_help_texture", "size": [ 15, 15 ], "layer": 3 } },
      { "tip@df_form.help_tip": {} }
    ]
  },


  "help_button@common.button": {
    "$focus_enabled": false,
    "$pressed_button_name": "button.form_button_click",
    "size": [ 15, 15 ],
    "anchor_from": "center",
    "anchor_to": "center",
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      }
    ],
    "controls": [
      { "default@df_form.help_face": {} },
      { "hover@df_form.help_face_tip": { "$df_help_texture": "textures/ui/how_to_play_button_hover_light" } },
      { "pressed@df_form.help_face_tip": { "$df_help_texture": "textures/ui/how_to_play_button_pressed_light" } }
    ]
  },

  "back_item@df_form.vis_back": {
    "type": "panel",
    "size": [ 17, 22 ],
    "controls": [ { "button@df_form.icon_button": {} } ]
  },

  // icon_button is a small square button showing only the icon.
  "icon_button@common.button": {
    "$focus_enabled": false,
    "$pressed_button_name": "button.form_button_click",
    "size": [ 15, 15 ],
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      }
    ],
    "controls": [
      { "default@df_form.state_image": { "$df_state_texture": "textures/ui/df/clear" } },
      { "hover@df_form.state_image": { "$df_state_texture": "textures/ui/df/hover_flat" } },
      { "pressed@df_form.state_image": { "$df_state_texture": "textures/ui/df/press_flat" } },
      { "icon@df_form.button_icon": { "$df_icon_size": [ 15, 15 ], "$df_icon_color": [ 1, 1, 1 ] } }
    ]
  },

  // The window of a form that has no tabs above it (or draws its own).
  "no_tabs": { "type": "stack_panel", "orientation": "horizontal", "size": [ 0, 0 ] },

  "tab_item@df_form.vis_tab": {
    "type": "panel",
    "size": [ 26, 24 ],
    "controls": [
      { "off@df_form.vis_tree_tab_off": { "type": "panel", "size": [ "100%", "100%" ], "controls": [ { "button@df_form.tab_button": {} } ] } },
      { "on@df_form.vis_tab_on": { "type": "panel", "size": [ "100%", "100%" ], "controls": [ { "button@df_form.tab_button_on": {} } ] } }
    ]
  },
  // The selected tab does not answer the form when pressed: it is the page
  // already shown.
  "tab_button_on@df_form.tab_button": { "$pressed_button_name": "button.df_noop" },

  // A tab is a square with its icon, like the creative inventory's tabs: its
  // label shows as the tooltip while the pointer is on it (or a finger holds
  // it), so any number of tabs fits over an inventory-sized window. The
  // selected one (§0§2§r) is raised. An unselected tab runs on under the
  // window like the game's, so its bottom edge does not float above it.
  "tab_tip@common.hover_text": {
    "$hover_text_max_width": 0,
    "layer": 200,
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection",
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#form_button_text - '§0§1§r' - '§0§2§r')",
        "target_property_name": "#hover_text"
      }
    ]
  },
  "tab_face": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "$df_tab_texture|default": "textures/ui/TabTopBack",
    "controls": [
      { "bg": { "type": "image", "texture": "$df_tab_texture", "size": [ "100%", "100% + 6px" ], "anchor_from": "top_left", "anchor_to": "top_left", "layer": -6 } },
      {
        "selected@df_form.vis_tab_on": {
          "type": "image",
          "texture": "textures/ui/TabTopFront",
          "size": [ "100%", "100% + 2px" ],
          "anchor_from": "bottom_left",
          "anchor_to": "bottom_left",
          "layer": 2
        }
      },
      { "icon@df_form.button_icon": { "$df_icon_size": [ 14, 14 ] } }
    ]
  },
  "tab_face_tip@df_form.tab_face": {
    "controls": [
      { "bg": { "type": "image", "texture": "$df_tab_texture", "size": [ "100%", "100% + 6px" ], "anchor_from": "top_left", "anchor_to": "top_left", "layer": -6 } },
      {
        "selected@df_form.vis_tab_on": {
          "type": "image",
          "texture": "textures/ui/TabTopFront",
          "size": [ "100%", "100% + 2px" ],
          "anchor_from": "bottom_left",
          "anchor_to": "bottom_left",
          "layer": 2
        }
      },
      { "icon@df_form.button_icon": { "$df_icon_size": [ 14, 14 ] } },
      { "tip@df_form.tab_tip": {} }
    ]
  },
  "tab_button@common.button": {
    "$focus_enabled": false,
    "$pressed_button_name": "button.form_button_click",
    "size": [ 24, 22 ],
    "anchor_from": "bottom_left",
    "anchor_to": "bottom_left",
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      }
    ],
    "controls": [
      { "default@df_form.tab_face": {} },
      { "hover@df_form.tab_face_tip": { "$df_tab_texture": "textures/ui/TabTopBackHover" } },
      { "pressed@df_form.tab_face_tip": { "$df_tab_texture": "textures/ui/TabTopBackHover" } }
    ]
  },

  // ---- list (ActionForm, Modal) ----

  "action_form": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      { "window@df_form.window": { "$df_content": "df_form.list_scroll" } }
    ]
  },

  "list_scroll@common.scrolling_panel": {
    "anchor_to": "top_left",
    "anchor_from": "top_left",
    "$show_background": false,
    "size": [ "100%", "100%" ],
    "$scrolling_content": "df_form.list_content",
    "$scroll_size": [ 4, "100% - 4px" ],
    "$scrolling_pane_size": [ "100% - 6px", "100%" ],
    "$scrolling_pane_offset": [ 0, 0 ],
    "$scroll_bar_right_padding_size": [ 0, 0 ]
  },

  "list_content": {
    "type": "stack_panel",
    "size": [ "100% - 6px", "100%c" ],
    "orientation": "vertical",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {
        "body": {
          "type": "panel",
          "size": [ "100%", "100%c" ],
          "bindings": [
            { "binding_name": "#form_text" },
            { "binding_type": "view", "source_property_name": "(not (#form_text = ('%.12s' * #form_text)))", "target_property_name": "#visible" }
          ],
          "controls": [ { "label@df_form.body_label": {} } ]
        }
      },
      { "gap": { "type": "panel", "size": [ "100%", 6 ] } },
      { "buttons@df_form.list_buttons": {} }
    ]
  },

  "list_buttons": {
    "type": "stack_panel",
    "size": [ "100%", "100%c" ],
    "orientation": "vertical",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "factory": {
      "name": "buttons",
      "control_ids": {
        "button": "df_form.list_row",
        "label": "@server_form.dynamic_label",
        "header": "@server_form.dynamic_header",
        "divider": "@settings_common.option_group_section_divider"
      }
    },
    "collection_name": "form_buttons",
    "bindings": [
      {
        "binding_name": "#form_button_contents",
        "binding_name_override": "#collection_length",
        "binding_condition": "visible"
      }
    ]
  },

  // list_row is one button with a 2px gap below it.
  "list_row@df_form.unmarked_visible": {
    "type": "panel",
    "size": [ "100%", 32 ],
    "controls": [ { "button@df_form.list_button": {} } ]
  },

  "state_image": {
    "type": "image",
    "size": [ "100%", "100%" ],
    "texture": "$df_state_texture",
    "layer": 1
  },

  // button_icon is a button's icon. A texture path ("textures/...") shows as
  // an image; anything else is an item (ui.ItemIcon: runtime ID * 65536)
  // that the client's item renderer draws like an inventory slot, so items
  // and blocks need no icon texture (same trick as Chest-UI). The icon is a
  // string; "- 0" makes it the number the renderer takes (there is no "%").
  "button_icon": {
    "type": "panel",
    "layer": 3,
    "$df_icon_size|default": [ 20, 20 ],
    "size": "$df_icon_size",
    "controls": [
      { "image@df_form.button_icon_image": {} },
      { "item@df_form.button_icon_item": {} }
    ]
  },

  "button_icon_image": {
    "type": "image",
    "$df_icon_color|default": [ 1, 1, 1 ],
    "color": "$df_icon_color",
    "size": [ "100%", "100%" ],
    "bindings": [
      {
        "binding_name": "#form_button_texture",
        "binding_name_override": "#texture",
        "binding_type": "collection", 
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_name": "#form_button_texture_file_system",
        "binding_name_override": "#texture_file_system",
        "binding_type": "collection", 
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", 
        "source_property_name": "(('%.8s' * #texture) = 'textures')",
        "target_property_name": "#visible"
      }
    ]
  },

  "button_icon_item": {
    "type": "custom",
    "renderer": "inventory_item_renderer",
    "size": [ "100%", "100%" ],
    "layer": 1,
    "bindings": [
      {
        "binding_name": "#form_button_texture",
        "binding_type": "collection", 
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", 
        "source_property_name": "(not ((#form_button_texture = '') or (#form_button_texture = 'loading') or (('%.8s' * #form_button_texture) = 'textures')))",
        "target_property_name": "#visible"
      },
      {
        "binding_type": "view", 
        "source_property_name": "(#form_button_texture - 0)",
        "target_property_name": "#item_id_aux"
      }
    ]
  },

  "list_button@common.button": {
    "$focus_enabled": false,
    "$pressed_button_name": "button.form_button_click",
    "size": [ "100%", 30 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      }
    ],
    "controls": [
      { "default@df_form.state_image": { "$df_state_texture": "textures/ui/df/button" } },
      { "hover@df_form.state_image": { "$df_state_texture": "textures/ui/df/button_hover" } },
      { "pressed@df_form.state_image": { "$df_state_texture": "textures/ui/df/button_pressed" } },
      {
        "icon@df_form.button_icon": {
          "offset": [ 6, 0 ],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle"
        }
      },
      {
        "text": {
          "type": "label",
          "layer": 3,
          "text": "#form_button_text",
          "color": [ 0.95, 0.95, 0.97 ],
          "size": [ "100% - 36px", "default" ],
          "offset": [ 32, 0 ],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "bindings": [
            {
              "binding_name": "#form_button_text",
              "binding_type": "collection", 
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      }
    ]
  },

  // ---- custom form (input, dropdown, ...) ----
  // Vanilla fields (white text) drawn in a dark inset of the window.
  // An input form is one field and its submit button: no title bar (the
  // window's title is short and the field's label carries the question) and
  // no scrolling (a scroll box left a strip of empty space above the field).
  "custom_inset": {
    "type": "image",
    "texture": "textures/ui/df/inset",
    "size": [ "100%", "100%" ],
    "controls": [ { "fields@df_form.custom_form_content": {} } ]
  },

  // The field and its submit button, without the scrolling panel around them.
  "custom_form_content": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [ "100%", "100%c" ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      { "generated_form@server_form.generated_contents": {} },
      { "submit@df_form.custom_submit": {} },
      { "create@df_form.custom_create": {} }
    ]
  },

  // The submit button reads "확인", or "생성하기" when the title has
  // ui.CreateToken (§d§f§e§r: a new save slot is created).
  "custom_submit@common_buttons.light_text_button": {
    "$pressed_button_name": "button.submit_custom_form",
    "size": [ "100%", 30 ],
    "$button_text": "dfui.submit",
    "$button_text_binding_type": "none",
    "bindings": [
      { "binding_name": "#submit_button_visible" },
      { "binding_name": "#title_text", "binding_type": "global" },
      {
        "binding_type": "view",
        "source_property_name": "(#submit_button_visible and ((#title_text - '§d§f§e§r') = #title_text))",
        "target_property_name": "#visible"
      }
    ]
  },
  "custom_create@df_form.custom_submit": {
    "$button_text": "dfui.create",
    "bindings": [
      { "binding_name": "#submit_button_visible" },
      { "binding_name": "#title_text", "binding_type": "global" },
      {
        "binding_type": "view",
        "source_property_name": "(#submit_button_visible and (not ((#title_text - '§d§f§e§r') = #title_text)))",
        "target_property_name": "#visible"
      }
    ]
  },

  "custom_form": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "window@df_form.window": {
          "$df_window_size": [ 260, 96 ],
          "$df_title": false,
          "$df_content_offset": [ 0, 6 ],
          "$df_content_size": [ "100% - 12px", "100% - 12px" ],
          "$df_content": "df_form.custom_inset"
        }
      }
    ]
  },

  // ---- card grid (title starts with §d§f§c§r): menu and shop ----
  // Buttons as icon-and-text cards, four per row, as many rows as needed.

  // An untitled card form (ui.UntitledToken: the lobby menu, whose name is in
  // the lobby frame) has no title bar, and the window is as much shorter.
  "card_form": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "$df_card_size|default": [ 326, 166 ],
    "$df_card_title|default": true,
    "$df_card_offset|default": [ 0, 18 ],
    "$df_card_content|default": [ "100% - 12px", "100% - 24px" ],
    "controls": [
      {
        "window@df_form.window": {
          "$df_window_size": "$df_card_size",
          "$df_title": "$df_card_title",
          "$df_content_offset": "$df_card_offset",
          "$df_content_size": "$df_card_content",
          "$df_content": "df_form.card_scroll"
        }
      }
    ]
  },

  "card_scroll@common.scrolling_panel": {
    "anchor_to": "top_left",
    "anchor_from": "top_left",
    "$show_background": false,
    "size": [ "100%", "100%" ],
    "$scrolling_content": "df_form.card_content",
    "$scroll_size": [ 4, "100% - 4px" ],
    "$scrolling_pane_size": [ "100% - 6px", "100%" ],
    "$scrolling_pane_offset": [ 0, 0 ],
    "$scroll_bar_right_padding_size": [ 0, 0 ]
  },

  "card_content": {
    "type": "stack_panel",
    "size": [ "100% - 6px", "100%c" ],
    "orientation": "vertical",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {
        "body": {
          "type": "panel",
          "size": [ "100%", "100%c" ],
          "bindings": [
            { "binding_name": "#form_text" },
            { "binding_type": "view", "source_property_name": "(not (#form_text = ('%.12s' * #form_text)))", "target_property_name": "#visible" }
          ],
          "controls": [ { "label@df_form.body_label": {} } ]
        }
      },
      { "gap": { "type": "panel", "size": [ "100%", 6 ] } },
      {
        "cards_row": {
          "type": "panel",
          "size": [ "100%", "100%c" ],
          "controls": [
            {
              // Four 76px cells (304px) fit the 308px content, so two
              // rows hold eight cards; a 100% wide grid rounded down a
              // column (7th playtest).
              "cards": {
                "type": "grid",
                "size": [ 304, "100%c" ],
                "anchor_from": "top_middle",
                "anchor_to": "top_middle",
                "grid_rescaling_type": "horizontal",
                "grid_item_template": "df_form.card",
                "collection_name": "form_buttons",
                "bindings": [
                  { "binding_name": "#form_text", "binding_condition": "always_when_visible" },
                  { "binding_type": "view", "binding_condition": "always_when_visible", "source_property_name": "(((('%.12s' * #form_text) - '§r') - 0))", "target_property_name": "#maximum_grid_items" }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  // card is one cell: a button with the icon on top and two lines of text.
  // Marked buttons (tabs, back) leave an empty cell; they come last.
  "card@df_form.unmarked_visible": {
    "type": "panel",
    "size": [ 76, 50 ],
    "controls": [ { "button@df_form.card_button": {} } ]
  },

  // ---- compact card grid (title starts with §d§f§s§r): the shop ----
  // Small cards, six per row in a wider window.

  "shop_form": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "window@df_form.window": {
          "$df_window_size": [ 318, 166 ],
          "$df_content": "df_form.shop_scroll"
        }
      }
    ]
  },

  "shop_scroll@common.scrolling_panel": {
    "anchor_to": "top_left",
    "anchor_from": "top_left",
    "$show_background": false,
    "size": [ "100%", "100%" ],
    "$scrolling_content": "df_form.shop_content",
    "$scroll_size": [ 4, "100% - 4px" ],
    "$scrolling_pane_size": [ "100% - 6px", "100%" ],
    "$scrolling_pane_offset": [ 0, 0 ],
    "$scroll_bar_right_padding_size": [ 0, 0 ]
  },

  "shop_content": {
    "type": "stack_panel",
    "size": [ "100% - 6px", "100%c" ],
    "orientation": "vertical",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {
        "body": {
          "type": "panel",
          "size": [ "100%", "100%c" ],
          "bindings": [
            { "binding_name": "#form_text" },
            { "binding_type": "view", "source_property_name": "(not (#form_text = ('%.12s' * #form_text)))", "target_property_name": "#visible" }
          ],
          "controls": [ { "label@df_form.body_label": {} } ]
        }
      },
      { "gap": { "type": "panel", "size": [ "100%", 6 ] } },
      {
        "cards_row": {
          "type": "panel",
          "size": [ "100%", "100%c" ],
          "controls": [
            {
              // Six 56px cells (336px) fill the 336px content (360px
              // window - 12px - 6px scroll bar - 6px); 340px cut off the
              // left column (9th playtest).
              "cards": {
                "type": "grid",
                "size": [ 300, "100%c" ],
                "anchor_from": "top_middle",
                "anchor_to": "top_middle",
                "grid_rescaling_type": "horizontal",
                "grid_item_template": "df_form.shop_card",
                "collection_name": "form_buttons",
                "bindings": [
                  { "binding_name": "#form_text", "binding_condition": "always_when_visible" },
                  { "binding_type": "view", "binding_condition": "always_when_visible", "source_property_name": "(((('%.12s' * #form_text) - '§r') - 0))", "target_property_name": "#maximum_grid_items" }
                ]
              }
            }
          ]
        }
      }
    ]
  },


  // shop_card is a small, inventory-like cell: icon, name and price.
  "shop_card@df_form.unmarked_visible": {
    "type": "panel",
    "size": [ 50, 46 ],
    "controls": [
      {
        "button@df_form.card_button": {
          "size": [ 48, 44 ],
          "$df_card_icon": [ 16, 16 ],
          "$df_card_font": 0.6
        }
      }
    ]
  },

  "card_button@common.button": {
    "$focus_enabled": false,
    "$pressed_button_name": "button.form_button_click",
    "$df_card_icon|default": [ 22, 22 ],
    "$df_card_font|default": 0.8,
    "size": [ 72, 46 ],
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "form_buttons"
      }
    ],
    "controls": [
      { "default@df_form.state_image": { "$df_state_texture": "textures/ui/df/button" } },
      { "hover@df_form.state_image": { "$df_state_texture": "textures/ui/df/button_hover" } },
      { "pressed@df_form.state_image": { "$df_state_texture": "textures/ui/df/button_pressed" } },
      {
        "icon@df_form.button_icon": {
          "$df_icon_size": "$df_card_icon",
          "offset": [ 0, -5 ],
          "anchor_from": "center",
          "anchor_to": "center"
        }
      },
      {
        "text": {
          "type": "label",
          "layer": 3,
          "text": "#form_button_text",
          "color": [ 0.95, 0.95, 0.97 ],
          "text_alignment": "center",
          "font_scale_factor": "$df_card_font",
          "size": [ "100% - 4px", "default" ],
          "offset": [ 0, -3 ],
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "bindings": [
            {
              "binding_name": "#form_button_text",
              "binding_type": "collection", 
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      }
    ]
  },

  // ---- table (title starts with §d§f§t§r, Go ui.TableMenu) ----
  // Non-clickable cells (§0§5§r text, §0§6§r number, §0§7§r header) four
  // per row, then the total line (§0§8§r) and the action buttons (§0§4§r).

  "table_form": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "window@df_form.window": {
          "$df_window_size": [ 322, 166 ],
          "$df_content": "df_form.table_scroll"
        }
      }
    ]
  },

  "table_scroll@common.scrolling_panel": {
    "anchor_to": "top_left",
    "anchor_from": "top_left",
    "$show_background": false,
    "size": [ "100%", "100%" ],
    "$scrolling_content": "df_form.table_content",
    "$scroll_size": [ 4, "100% - 4px" ],
    "$scrolling_pane_size": [ "100% - 6px", "100%" ],
    "$scrolling_pane_offset": [ 0, 0 ],
    "$scroll_bar_right_padding_size": [ 0, 0 ]
  },

  "table_content": {
    "type": "stack_panel",
    "size": [ "100% - 6px", "100%c" ],
    "orientation": "vertical",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {
        "body": {
          "type": "panel",
          "size": [ "100%", "100%c" ],
          "controls": [ { "label@df_form.body_label": {} } ]
        }
      },
      { "gap": { "type": "panel", "size": [ "100%", 4 ] } },
      {
        "cells_row": {
          "type": "panel",
          "size": [ "100%", "100%c" ],
          "controls": [
            {
              "cells": {
                "type": "grid",
                "size": [ 304, "100%c" ],
                "anchor_from": "top_middle",
                "anchor_to": "top_middle",
                "grid_rescaling_type": "horizontal",
                "grid_item_template": "df_form.table_cell",
                "collection_name": "form_buttons",
                "bindings": [
                  { "binding_name": "#form_text", "binding_condition": "always_when_visible" },
                  { "binding_type": "view", "binding_condition": "always_when_visible", "source_property_name": "(((('%.12s' * #form_text) - '§r') - 0))", "target_property_name": "#maximum_grid_items" }
                ]
              }
            }
          ]
        }
      },
      { "gap2": { "type": "panel", "size": [ "100%", 6 ] } },
      {
        "total@df_form.marked_total": {
          "orientation": "vertical",
          "size": [ "100%", "100%c" ]
        }
      },
      { "gap3": { "type": "panel", "size": [ "100%", 4 ] } },
      {
        "actions@df_form.marked_actions": {
          "orientation": "vertical",
          "size": [ "100%", "100%c" ]
        }
      }
    ]
  },

  // table_cell is one 80×20 cell; non-cell buttons (total, actions) come
  // last and leave empty cells.
  "table_cell@df_form.vis_cell": {
    "type": "panel",
    "size": [ 76, 20 ],
    "controls": [
      { "line": { "type": "image", "texture": "textures/ui/df/slot", "size": [ "100%", 1 ], "anchor_from": "bottom_middle", "anchor_to": "bottom_middle", "alpha": 0.5 } },
      {
        // 16×16 like an inventory slot: the item renderer draws items at
        // that size and a smaller box let them spill over the left edge,
        // where the scroll view clipped them (10th playtest; still a little
        // at 4, 11th playtest).
        "icon@df_form.button_icon": {
          "$df_icon_size": [ 16, 16 ],
          "offset": [ 7, 0 ],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle"
        }
      },
      {
        // Text cells: left, after the icon if there is one.
        "text@df_form.cell_text": {
          "text_alignment": "left",
          "offset": [ 26, 0 ],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle"
        }
      },
      {
        // Number cells: right-aligned.
        "num@df_form.cell_num": {
          "text_alignment": "right",
          "offset": [ -4, 0 ],
          "anchor_from": "right_middle",
          "anchor_to": "right_middle"
        }
      }
    ]
  },

  // cell_text and cell_num are the labels of text and number cells.
  "cell_text@df_form.vis_cell_text": {
    "type": "label",
    "layer": 3,
    "text": "#form_button_text",
    "color": [ 0.2, 0.2, 0.2 ],
    "font_scale_factor": 0.85,
    "size": [ "100% - 20px", "default" ]
  },

  "cell_num@df_form.vis_cell_num": {
    "type": "label",
    "layer": 3,
    "text": "#form_button_text",
    "color": [ 0.2, 0.2, 0.2 ],
    "font_scale_factor": 0.85,
    "size": [ "100% - 20px", "default" ]
  },

  "total_item@df_form.vis_total": {
    "type": "panel",
    "size": [ "100%", 18 ],
    "controls": [
      {
        "text": {
          "type": "label",
          "text": "#form_button_text",
          "color": [ 0.2, 0.2, 0.2 ],
          "text_alignment": "right",
          "size": [ "100% - 8px", "default" ],
          "offset": [ -4, 0 ],
          "anchor_from": "right_middle",
          "anchor_to": "right_middle",
          "bindings": [
            {
              "binding_name": "#form_button_text",
              "binding_type": "collection", 
              "binding_collection_name": "form_buttons"
            }
          ]
        }
      }
    ]
  },

  // ---- slots (title starts with §d§f§i§r, Go ui.SlotMenu) ----
  // An inventory-like window (the drawer, 11th playtest): a storage slot
  // that only shows (§0§9§r: icon, count at the bottom right) with info
  // text on its right (§0§b§r), then pressable slots in two groups, storage
  // upgrades on the left (§0§a§r) and utilities on the right (§0§c§r), whose
  // text is their tooltip, then action buttons (§0§4§r).

  "vis_slot_store": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection", 
        "binding_collection_name": "form_buttons"
      },
      {
        "binding_type": "view", 
        "source_property_name": "(not ((#form_button_text - '§0§9§r') = #form_button_text))",
        "target_property_name": "#visible"
      }
    ]
  },
  "vis_slot_info": {
    "bindings": [
      {
        "binding_name": "#form_button_text",
        "binding_type": "collection", 
        "binding_collection_name": "form_buttons"
      },
      {
