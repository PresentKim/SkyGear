              }
            }
          ]
        }
      },
      { "gap": { "type": "panel", "size": [ "100%", 8 ] } },
      {
        "columns": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "size": [ "100%", "100%c" ],
          "controls": [
            {
              "left": {
                "type": "image",
                "texture": "textures/ui/df/panel",
                "size": [ "fill", "100%c + 12px" ],
                "controls": [
                  {
                    "inner": {
                      "type": "stack_panel",
                      "orientation": "vertical",
                      "size": [ "100% - 12px", "100%c" ],
                      "offset": [ 6, 6 ],
                      "anchor_from": "top_left",
                      "anchor_to": "top_left",
                      "controls": [
