	//* dragonfactory change: small marks after the name (a drawer's lock and
	//* upgrades) and a line with an item icon ("참나무 원목 [icon] x 132/1,024"),
	//* read from the subtitle tail (internal/waila tail.go; TestTail checks
	//* the places). Expressions are whole in each property: a variable
	//* from a variables block used inside another expression stays text. *//
	"df_marks": {
		"type": "stack_panel",
		"orientation": "horizontal",
		"size": [
			"100%c",
			10
		],
		"controls": [
			{
				"lock@waila_common.label": {
					"text": "$df_lock",
					"font_scale_factor": 0.6,
					"offset": [
						1,
						2
					],
					"$df_lock|default": "",
					"variables": [
						{
							"requires": "(('%.1s' * ($var_subtitle_text - ('%.555s' * $var_subtitle_text))) = 'L')",
							"$df_lock": "§e"
						}
					]
				}
			},
			{
				"multiplier@waila_common.label": {
					"text": "$df_mult",
					"font_scale_factor": 0.6,
					"offset": [
						1,
						2
					],
					"$df_mult|default": "",
					"variables": [
						{
							"requires": "(('%.1s' * ($var_subtitle_text - ('%.556s' * $var_subtitle_text))) = 'b')",
							"$df_mult": "§b×2"
						},
						{
							"requires": "(('%.1s' * ($var_subtitle_text - ('%.556s' * $var_subtitle_text))) = 'c')",
							"$df_mult": "§b×4"
						},
						{
							"requires": "(('%.1s' * ($var_subtitle_text - ('%.556s' * $var_subtitle_text))) = 'd')",
							"$df_mult": "§b×8"
						}
					]
