{

	"namespace": "waila_tile",

	//* dragonfactory change: the server (Go, no Script API) sends the looked-at
	//* item's runtime ID × 65536 in the subtitle, after an "i" so the pack
	//* still reads the subtitle as text (a bare number broke the block state
	//* check: a grey box and "expected a string"), in 11 characters left
	//* padded with 'x'. It is read from the subtitle *variable* the title
	//* factory gives ($var_subtitle_text, like all the panel's text) into the
	//* property bag, as older WAILA versions read the title; binding
	//* expressions on #hud_subtitle_text_string never gave an item (11th
	//* playtest). This replaces the script's inventory slot mirror. *//
	"df_subtitle_item_renderer": {
		"type": "custom",
		"renderer": "inventory_item_renderer",
		"layer": "($layer + 1)",
		"$df_aux": "((((('%.11s' * ($var_subtitle_text - ('%.1s' * $var_subtitle_text))) - 'xxxxxxxx') - 'xxxx') - 'xx') - 'x')",
		"property_bag": {
			"#item_id_aux": "$df_aux"
		}
	},

	//! Deprecated in favor of "item_aux_inv_renderer" !//
	"item_aux_renderer": {
		"type": "custom",
		"renderer": "inventory_item_renderer",

		"layer": "($layer + 1)",

		"property_bag": {
			"#item_id_aux": "$item_aux"
		}
	},

	//* Author: NguyenDuck (https://github.com/NguyenDuck) *//
	"item_aux_inv_renderer@common.empty_panel": {
		"$collection_index": 17,
		"$show_item_count": false,

		"controls": [
			{
				"inv": {
					"type": "custom",
					"renderer": "inventory_item_renderer",

					"anchor_from": "top_left",
					"anchor_to": "top_left",
					"size": ["100%", "100%"],
					"layer": "($layer + 1)",

					"controls": [
						{
							"stack": {
								"type": "stack_panel",
								"size": [0, 0],

								"$slot_name": "slot",
								"$collection_name": "hotbar_items",
								"collection_name": "$collection_name",

								"controls": [
									{
										"$slot_name@common.empty_panel": {
											"collection_index": "$collection_index",
											"bindings": [
												{
													"binding_type": "collection",
													"binding_name": "#item_id_aux",
													"binding_collection_name": "$collection_name",
													"binding_condition": "visibility_changed"
												},
												{
													"binding_type": "collection",
													"binding_name": "#inventory_stack_count",
													"binding_collection_name": "$collection_name",
													"binding_condition": "visibility_changed"
												}
											]
										}
									}
								],
								"bindings": [
									{
										"binding_type": "view",
										"source_control_name": "$slot_name",
										"resolve_sibling_scope": true,
										"source_property_name": "#item_id_aux",
										"target_property_name": "#item_id_aux"
									},
									{
										"binding_type": "view",
										"source_control_name": "$slot_name",
										"resolve_sibling_scope": true,
										"source_property_name": "#inventory_stack_count",
										"target_property_name": "#inventory_stack_count"
									}
								]
							}
						},

						{
							"item_amount@waila_common.label": {
								"anchor_from": "bottom_right",
								"anchor_to": "bottom_right",
								"offset": [0, 1],

								"text": "#text",
								"font_scale_factor": 0.75,
								"shadow": true,

								"ignored": "(not $show_item_count)",

								"bindings": [
									{
										"binding_type": "view",
										"source_control_name": "stack",
										"resolve_sibling_scope": true,
										"source_property_name": "#inventory_stack_count",
										"target_property_name": "#text"
									}
								]
							}
						}
					],
					"bindings": [
						{
							"binding_type": "view",
							"source_control_name": "stack",
							"resolve_sibling_scope": true,
							"source_property_name": "#item_id_aux",
							"target_property_name": "#item_id_aux"
						}
					]
				}
			}
		]
	},

