	"block_tags": {
		"type": "stack_panel",
		"orientation": "horizontal",

		"anchor_from": "top_right",
		"anchor_to": "top_right",
		"size": ["100%c", 11],

		/* tool codes with no vanilla icon show the placeholder */
		"$texture|default": "pack_icon",

		//* _waila:A:zz,t;zz,z: ...
		//* _waila:B:yyyyyyyyyyyyyyyyyyyynnnnnnnnnn:zz,t;zz,z: ...

		"$tooltip_renderer_type": "('%.2s' * ($var_title_text - ('%.7s' * $var_title_text)))",

		/* tag codes, mapped to vanilla item textures in the icons */
		"$tag_0_tile": "(('%.2s' * ($var_title_text - ('%.9s' * $var_title_text))) - ':')",
		"$tag_0_entity": "(('%.2s' * ($var_title_text - ('%.40s' * $var_title_text))) - ':')",
		"$tag_1_tile": "(('%.2s' * ($var_title_text - ('%.14s' * $var_title_text))) - ':')",
