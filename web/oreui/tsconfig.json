{
  "compilerOptions": {
    "target": "es2017",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "lib": ["dom", "es2017"],
    "skipLibCheck": true,
    "paths": {
      "@ore-ui-react/core/src/*": ["./node_modules/ore-ui-react/packages/core/src/*"],
      "@ore-ui-react/oreui/*": ["./node_modules/ore-ui-react/packages/oreui/src/*"],
      "@ore-ui-react/*": ["./node_modules/ore-ui-react/packages/*/src/index.ts"]
    }
  },
  "include": ["src", "test", "visual/*.ts"]
}
