+func (l Leaves) decay(pos cube.Pos, tx *world.Tx) {
+	if l.Persistent || !l.ShouldUpdate {
+		return
+	}
+	if findLog(pos, tx) {
+		l.ShouldUpdate = false
+		tx.SetBlock(pos, l, nil)
