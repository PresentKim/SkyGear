+		return
+	}
+	if c.seen == nil {
+		c.seen = make(map[ChunkPos]struct{})
+	}
+	clear(c.seen)
+	for _, lp := range c.pos {
+		for x := -r; x <= r; x++ {
+			for z := -r; z <= r; z++ {
+				if x*x+z*z > r*r {
+					continue
+				}
+				pos := ChunkPos{lp[0] + x, lp[1] + z}
+				col, ok := w.chunks[pos]
+				if !ok {
+					continue
+				}
+				if _, dup := c.seen[pos]; dup {
+					continue
+				}
+				c.seen[pos] = struct{}{}
+				c.chunks = append(c.chunks, tickChunk{pos, col})
